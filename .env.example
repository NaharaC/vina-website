# Copia este archivo como `.env` y rellena el token. `.env` no se sube a git.

# Token de la integración interna de Notion (empieza por "ntn_" o "secret_").
# Se crea en https://www.notion.so/my-integrations y hay que compartir la base
# "Actividades Iglesia" con ella: en la base, menú ••• → Conexiones → elegirla.
NOTION_TOKEN=

# Base de datos de actividades. Ya viene con el ID correcto; solo cámbialo si
# algún día se usa otra base.
NOTION_DB=f2e0de39-fd7d-4079-8e06-66c3d5d368c7
