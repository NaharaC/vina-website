# Copia este archivo como `.env` y rellena el token. `.env` no se sube a git.

# Token de la integración interna de Notion (empieza por "ntn_" o "secret_").
# Se crea en https://www.notion.so/my-integrations y hay que compartir la base
# "Actividades Iglesia" con ella: en la base, menú ••• → Conexiones → elegirla.
NOTION_TOKEN=

# Base de datos de actividades. Ya viene con el ID correcto; solo cámbialo si
# algún día se usa otra base.
NOTION_DB=f2e0de39-fd7d-4079-8e06-66c3d5d368c7

# Clave del calendario interno del equipo, el que lleva TODAS las actividades y
# no solo las marcadas «Web». Se saca con:
#
#     openssl rand -hex 12
#
# y queda en https://iglesiavinapm.cl/interno/<clave>.ics — quien tenga ese
# enlace ve el calendario entero, así que se reparte por dentro y no se publica
# en ninguna página. Cambiarla revoca el acceso a todo el mundo a la vez.
#
# Si se deja vacía, el archivo sencillamente no se genera.
CALENDARIO_INTERNO=
