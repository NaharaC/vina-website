---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { contactChannels, organization, site, socials } from '../data/content';

interface Props {
  title?: string;
  description?: string;
  /**
   * `true` en páginas que empiezan con una foto a sangre: solo ahí la barra
   * puede ir transparente. En páginas de fondo claro el logo blanco
   * desaparecería, así que la barra conserva su fondo oscuro.
   */
  heroFoto?: boolean;
}

const { title = site.name, description = site.description, heroFoto = false } = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Las redes sociales no resuelven rutas relativas: la imagen va con URL absoluta.
const ogImage = Astro.site ? new URL('/og-image.jpg', Astro.site).href : '/og-image.jpg';

/**
 * Datos estructurados de la iglesia. Solo se publican los campos que ya tienen
 * valor real; los que siguen pendientes en `content.ts` se omiten.
 */
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: site.name,
  description: site.description,
  url: Astro.site?.href,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    ...(organization.streetAddress ? { streetAddress: organization.streetAddress } : {}),
    addressLocality: organization.addressLocality,
    addressRegion: organization.addressRegion,
    addressCountry: organization.addressCountry,
  },
  ...(contactChannels.whatsapp ? { telephone: `+${contactChannels.whatsapp}` } : {}),
  openingHoursSpecification: organization.openingHours.map((slot) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: slot.day,
    opens: slot.opens,
  })),
  // `sameAs` son perfiles de la iglesia. El enlace de WhatsApp no lo es —el
  // teléfono ya va en `telephone`—, así que se queda fuera.
  sameAs: socials
    .filter((social) => social.href && !social.href.includes('wa.me'))
    .map((social) => social.href),
};
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Congregación adorando en Iglesia Viña Puerto Montt" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#232323" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Las tipografías son self-hosted: precargamos las dos que se ven primero */}
    <link
      rel="preload"
      href="/fonts/inter-normal-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/newsreader-italic-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  </head>

  <body id="top" data-hero-foto={String(heroFoto)}>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-full focus:bg-white focus:px-5 focus:py-2.5 focus:font-semibold focus:text-carbon focus:shadow-lg"
    >
      Saltar al contenido
    </a>

    <Header />

    {/*
      El bg-white importa: la foto del revelado final vive fija detrás de la
      página, y cualquier sección sin fondo propio la dejaría asomarse.
    */}
    <main id="contenido" class="bg-white">
      <slot />
    </main>

    <Footer />
  </body>
</html>
