---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ArrowButton from './ArrowButton.astro';
import SectionHeading from './SectionHeading.astro';
import { formasDeDar, giving } from '../data/content';
---

{/*
  La sección cabe en una pantalla: encabezado arriba y, debajo, las tres
  formas de dar como fichas de alto fijo. Ese alto es el que necesita la de
  transferencia, que es la que más contenido tiene, así que abrir una u otra
  ya no mueve nada.
*/}
<section id="dar" class="seccion" aria-labelledby="dar-titulo">
  <div class="container-page">
    <div>
      <SectionHeading
        id="dar-titulo"
        eyebrow="Dar"
        title={giving.title}
        subtitle={`${giving.verse} — ${giving.reference}`}
      />

      <div
        class="formas mt-8 flex flex-col gap-3 lg:mt-10 lg:h-[27.5rem] lg:flex-row lg:gap-4"
        data-hay-abierta="false"
      >
        {
          formasDeDar.map((forma) => (
            <article
              class="forma flex flex-col overflow-hidden rounded-[1.5rem] bg-[#e4e3de] p-5 transition-[flex-grow] duration-500 ease-out lg:h-full lg:p-7"
              data-forma={forma.id}
              data-abierta="false"
            >
              <button
                type="button"
                class="flex w-full items-start justify-between gap-3 text-left"
                data-abre={forma.id}
                aria-expanded="false"
                aria-controls={`dar-${forma.id}`}
              >
                {/* suelto y en negro, sin pastilla detrás: como la referencia */}
                <Icon
                  name={forma.icon}
                  width={30}
                  height={30}
                  class="shrink-0 text-ink"
                  aria-hidden="true"
                />

                <span class="sr-only">{forma.title}</span>

                {/* al abrirse desaparece: no hay nada que cerrar, solo se cambia de opción */}
                <Icon
                  name="lucide:plus"
                  width={20}
                  height={20}
                  class="forma-mas shrink-0 text-ink/40 transition-opacity duration-300"
                  aria-hidden="true"
                />
              </button>

              {/*
                El cuerpo vive en el hueco que la ficha ya tiene reservado y se
                apoya abajo, encima del nombre. Cerrado se desvanece, pero
                sigue ocupando su sitio: por eso nada se mueve al abrir.
              */}
              <div
                id={`dar-${forma.id}`}
                class="forma-cuerpo mt-6 flex min-h-0 flex-1 flex-col justify-end lg:mt-4"
              >
                {/*
                  Todo el contenido cuelga de un solo hijo: al colapsar por
                  filas de rejilla en móvil solo se contrae la primera fila, y
                  el resto dejaba un hueco en blanco dentro de la ficha.
                */}
                <div class="forma-cuerpo-interior">
                {forma.cuentas && (
                  <ul class="grid gap-x-6 gap-y-7 sm:grid-cols-2 sm:grid-rows-[auto_auto_1fr_auto] lg:grid-cols-3">
                    {forma.cuentas.map((cuenta) => (
                      <li class="flex flex-col items-start sm:grid sm:row-span-4 sm:grid-rows-subgrid sm:gap-0">
                        <p class="eyebrow">{cuenta.destino}</p>
                        <p class="mt-3 text-[0.9375rem] font-semibold text-ink">{cuenta.titular}</p>
                        <p class="nota mt-1.5 leading-relaxed">
                          RUT {cuenta.rut}
                          <br />
                          {cuenta.banco}
                          <br />
                          {cuenta.cuenta}
                          <br />
                          {cuenta.correo}
                        </p>

                        {/*
                          Copiar el bloque entero y no dato a dato: al pegarlo
                          en el banco se necesitan todos juntos.
                        */}
                        <button
                          type="button"
                          class="copiar mt-5 inline-flex w-fit items-center gap-1.5 justify-self-start rounded-full bg-white px-3.5 py-1.5 text-[0.8125rem] font-semibold text-ink transition-colors hover:bg-white/70"
                          data-copiar={[
                            cuenta.titular,
                            `RUT ${cuenta.rut}`,
                            cuenta.banco,
                            cuenta.cuenta,
                            cuenta.correo,
                          ].join('\n')}
                        >
                          <Icon
                            name="lucide:copy"
                            width={13}
                            height={13}
                            class="copiar-icono"
                            aria-hidden="true"
                          />
                          <Icon
                            name="lucide:check"
                            width={13}
                            height={13}
                            class="copiar-listo hidden"
                            aria-hidden="true"
                          />
                          <span class="copiar-texto">Copiar datos</span>
                        </button>
                      </li>
                    ))}
                  </ul>
                )}

                {forma.logo && (
                  <Image
                    src={forma.logo}
                    alt={forma.logoAlt ?? ''}
                    class="mb-4 h-6 w-auto self-start lg:h-7"
                    loading="lazy"
                    decoding="async"
                  />
                )}

                {forma.detalle && <p class="subtitle max-w-md">{forma.detalle}</p>}

                {forma.action?.href && (
                  <div class="mt-5">
                    <ArrowButton
                      label={forma.action.label}
                      href={forma.action.href}
                      variant="accent"
                      external={forma.action.external}
                    />
                  </div>
                )}
                </div>
              </div>

              <div class="mt-6 lg:mt-7">
                <h3 class="forma-nombre heading-sm text-ink">{forma.title}</h3>
                <p class="forma-resumen subtitle mt-3">{forma.summary}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .forma-cuerpo {
    opacity: 0;
    pointer-events: none;
    transition: opacity 350ms ease;
  }

  .forma[data-abierta='true'] .forma-cuerpo {
    opacity: 1;
    pointer-events: auto;
  }

  .forma[data-abierta='true'] .forma-mas {
    opacity: 0;
  }

  /*
    En móvil no hay hueco que reservar, así que ahí la ficha sí crece y
    encoge: se anima por filas de rejilla, para no medir el contenido.
  */
  @media (width < 64rem) {
    .forma-cuerpo {
      display: grid;
      /*
        En rejilla, el `justify-end` que alinea abajo en escritorio pasa a
        empujar el contenido a la derecha: aquí se anula.
      */
      justify-content: stretch;
      grid-template-rows: 0fr;
      margin-top: 0;
      transition:
        grid-template-rows 450ms ease,
        opacity 350ms ease,
        margin-top 450ms ease;
    }

    .forma-cuerpo > .forma-cuerpo-interior {
      overflow: hidden;
    }

    .forma[data-abierta='true'] .forma-cuerpo {
      grid-template-rows: 1fr;
      margin-top: 1.25rem;
    }
  }

  @media (width >= 64rem) {
    /*
      `flex-basis: 0` y `min-width: 0` son lo que hace que el reparto sea el
      de los números y no el del contenido: con base automática, el ancho del
      título de cada ficha se colaba en la cuenta.
    */
    .forma {
      flex: 1 1 0;
      min-width: 0;
    }

    /* la abierta se lleva casi todo: las tres cuentas necesitan sitio */
    .forma[data-abierta='true'] {
      flex-grow: 6;
    }

    /*
      Mientras no hay ninguna abierta, las tres son iguales y el texto va más
      grande: es el momento en que hay que entender qué opciones existen.
    */
    .formas[data-hay-abierta='false'] .forma-nombre {
      font-size: 1.375rem;
      letter-spacing: -0.03em;
    }

    .formas[data-hay-abierta='false'] .forma-resumen {
      font-size: 1rem;
    }

    /* con una abierta, las otras se quedan solo con su nombre */
    .formas[data-hay-abierta='true'] .forma[data-abierta='false'] .forma-resumen {
      display: none;
    }
  }

  /* aviso de copiado */
  .copiar[data-copiado='true'] .copiar-icono {
    display: none;
  }

  .copiar[data-copiado='true'] .copiar-listo {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .forma,
    .forma-cuerpo,
    .forma-mas {
      transition: none;
    }
  }
</style>

<script>
  /*
    Solo una abierta a la vez. Se abre al pasar el ratón —como en la
    referencia— y también al pulsar, que es lo único que existe en táctil.
  */
  const grupo = document.querySelector<HTMLElement>('.formas');
  const fichas = [...(grupo?.querySelectorAll<HTMLElement>('.forma') ?? [])];

  if (grupo && fichas.length) {
    /** `id` vacío = ninguna abierta, que es como arranca y como vuelve a quedar. */
    const abrir = (id: string) => {
      for (const ficha of fichas) {
        const abierta = ficha.dataset.forma === id;
        ficha.dataset.abierta = String(abierta);
        ficha.querySelector('[data-abre]')?.setAttribute('aria-expanded', String(abierta));
      }

      grupo.dataset.hayAbierta = String(Boolean(id));
    };

    for (const ficha of fichas) {
      const id = ficha.dataset.forma;
      if (!id) continue;

      // pulsar abre y vuelve a pulsar cierra: en táctil no hay otra forma
      ficha.querySelector('[data-abre]')?.addEventListener('click', () => {
        abrir(ficha.dataset.abierta === 'true' ? '' : id);
      });

      // el hover solo manda donde hay ratón: en táctil dispara al tocar y estorba
      if (window.matchMedia('(hover: hover)').matches) {
        ficha.addEventListener('mouseenter', () => abrir(id));
      }
    }

    /*
      Al salir del grupo se cierran todas: así el estado de reposo vuelve a ser
      el de las tres opciones a la vista, en igualdad.
    */
    if (window.matchMedia('(hover: hover)').matches) {
      grupo.addEventListener('mouseleave', () => abrir(''));
    }
  }

  /* --- Copiar los datos de una cuenta --------------------------------------- */

  for (const boton of document.querySelectorAll<HTMLButtonElement>('.copiar')) {
    const datos = boton.dataset.copiar;
    if (!datos) continue;

    const etiqueta = boton.querySelector('.copiar-texto');

    boton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(datos);
      } catch {
        /*
          Sin permiso de portapapeles —o sin https— queda el camino viejo:
          un campo fuera de pantalla que se selecciona y se copia.
        */
        const campo = document.createElement('textarea');
        campo.value = datos;
        campo.setAttribute('readonly', '');
        campo.style.position = 'absolute';
        campo.style.left = '-9999px';
        document.body.appendChild(campo);
        campo.select();
        document.execCommand('copy');
        campo.remove();
      }

      boton.dataset.copiado = 'true';
      if (etiqueta) etiqueta.textContent = 'Copiado';

      window.setTimeout(() => {
        delete boton.dataset.copiado;
        if (etiqueta) etiqueta.textContent = 'Copiar datos';
      }, 2000);
    });
  }
</script>
