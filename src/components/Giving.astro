---
import { Image } from 'astro:assets';
import ArrowButton from './ArrowButton.astro';
import { giving } from '../data/content';
---

{/*
  Un solo bloque de color, el único de toda la página. El sitio es blanco,
  negro y fotos, con el naranja reservado para los botones; usarlo aquí a
  campo completo convierte la sección en el punto donde el ojo se detiene, que
  es justo lo que tiene que pasar en la que pide una acción.

  Dentro, el reparto de siempre: el versículo en grande a un lado y la foto
  llenando el otro de borde a borde del panel.
*/}
<section id="dar" class="seccion" aria-labelledby="dar-titulo">
  <div class="container-page">
    <div class="overflow-hidden rounded-[2rem] bg-accent lg:rounded-[2.75rem]">
      <div class="grid lg:grid-cols-[1.05fr_1fr]">
        <div class="flex flex-col justify-center p-8 sm:p-12 lg:p-16">
          <p class="eyebrow !text-white/70">Dar</p>

          <blockquote
            id="dar-titulo"
            class="mt-6 text-[2rem] leading-[1.05] font-normal tracking-[-0.04em] text-balance text-white sm:text-[2.5rem] xl:text-[3.25rem]"
          >
            {giving.verse}
          </blockquote>

          <p class="mt-5 text-[0.9375rem] text-white/70">{giving.reference}</p>

          <p class="mt-8 max-w-sm text-[1.0625rem] leading-relaxed text-white/90">
            {giving.title}
          </p>

          {
            giving.action.href && (
              <div class="mt-10">
                <ArrowButton
                  label={giving.action.label}
                  href={giving.action.href}
                  variant="light"
                  size="lg"
                  external={giving.action.external}
                />
              </div>
            )
          }
        </div>

        {/* la foto llena su mitad: sin marco ni esquinas propias */}
        <div class="relative order-first min-h-[16rem] sm:min-h-[22rem] lg:order-none lg:min-h-[34rem]">
          <Image
            src={giving.image}
            alt={giving.alt}
            widths={[480, 768, 1080]}
            sizes="(min-width: 64rem) 40rem, 100vw"
            class="absolute inset-0 size-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>
