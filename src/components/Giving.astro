---
import ArrowButton from './ArrowButton.astro';
import { giving } from '../data/content';
---

{/*
  Sección en negro y a pantalla completa: es la llamada principal de la página.
  `svh` en vez de `vh` porque en el móvil la barra del navegador aparece y
  desaparece: con `vh` la sección cambiaría de alto y daría saltos.
*/}
<section
  id="dar"
  class="flex min-h-svh items-center bg-carbon py-16 text-paper lg:py-24"
  aria-labelledby="dar-titulo"
>
  <div class="container-page">
    <p class="label-mono text-paper/50">Dar</p>

    <h2 id="dar-titulo" class="heading-hero mt-8 max-w-[15ch] text-paper">
      {giving.title}
    </h2>

    <div class="mt-14 flex flex-col items-start gap-10 border-t border-white/15 pt-10 lg:flex-row lg:items-end lg:justify-between">
      <p class="max-w-sm font-serif text-xl italic text-paper/70">
        {giving.verse}<br />
        {giving.reference}
      </p>

      {
        giving.action.href && (
          <ArrowButton
            label={giving.action.label}
            href={giving.action.href}
            variant="light"
            size="lg"
            external={giving.action.external}
          />
        )
      }
    </div>
  </div>
</section>
