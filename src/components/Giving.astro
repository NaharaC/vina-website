---
import { Icon } from 'astro-icon/components';
import ArrowButton from './ArrowButton.astro';
import { formasDeDar, giving } from '../data/content';
---

{/*
  La sección entera va sobre gris, con el versículo en grande y debajo las
  tres formas de dar como fichas altas. La que se mira se ensancha y las otras
  se encogen; el contenido aparece dentro del hueco que la ficha ya tiene
  reservado, así que al abrirse no da saltos de alto.
*/}
<section id="dar" class="seccion" aria-labelledby="dar-titulo">
  <div class="container-page">
    <div class="rounded-[2rem] bg-mist px-6 py-12 sm:px-10 sm:py-16 lg:rounded-[2.75rem] lg:px-14 lg:py-20">
      <p class="eyebrow">Dar</p>

      <p class="subtitle-lg mt-8 max-w-sm">{giving.title}</p>

      <blockquote
        id="dar-titulo"
        class="mt-4 max-w-3xl text-[2rem] leading-[1.02] font-semibold tracking-[-0.045em] text-balance text-ink sm:text-[2.75rem] xl:text-[3.5rem]"
      >
        {giving.verse}
      </blockquote>

      <p class="subtitle mt-4">{giving.reference}</p>

      <div
        class="formas mt-12 flex flex-col gap-4 lg:mt-16 lg:flex-row lg:gap-5"
        data-abierta="online"
      >
        {
          formasDeDar.map((forma) => (
            <article
              class="forma flex flex-col rounded-[1.5rem] bg-[#e4e3de] p-6 transition-[flex-grow] duration-500 ease-out lg:min-h-[26rem] lg:basis-0 lg:p-8"
              data-forma={forma.id}
              data-abierta={forma.id === 'online' ? 'true' : 'false'}
            >
              <button
                type="button"
                class="flex w-full items-start justify-between gap-4 text-left"
                data-abre={forma.id}
                aria-expanded={forma.id === 'online' ? 'true' : 'false'}
                aria-controls={`dar-${forma.id}`}
              >
                <span class="grid size-11 shrink-0 place-items-center rounded-full bg-white text-ink">
                  <Icon name={forma.icon} width={20} height={20} aria-hidden="true" />
                </span>

                <span class="sr-only">{forma.title}</span>

                <Icon
                  name="lucide:plus"
                  width={20}
                  height={20}
                  class="forma-mas mt-2.5 shrink-0 text-ink transition-transform duration-500"
                  aria-hidden="true"
                />
              </button>

              {/*
                El cuerpo ocupa el hueco libre de la ficha y se apoya abajo,
                justo encima del título. Cerrada, se desvanece: la ficha ya
                tiene ese alto reservado, así que nada se mueve.
              */}
              <div
                id={`dar-${forma.id}`}
                class="forma-cuerpo mt-8 flex flex-1 flex-col justify-end lg:mt-0"
              >
                {forma.cuentas && (
                  <ul class="grid gap-x-8 gap-y-6 sm:grid-cols-2 xl:grid-cols-3">
                    {forma.cuentas.map((cuenta) => (
                      <li>
                        <p class="eyebrow">{cuenta.destino}</p>
                        <p class="mt-2 text-[0.9375rem] font-semibold text-ink">{cuenta.titular}</p>
                        <p class="mt-1 text-[0.9375rem] leading-relaxed text-muted">
                          RUT {cuenta.rut}
                          <br />
                          {cuenta.banco}
                          <br />
                          {cuenta.cuenta}
                          <br />
                          {cuenta.correo}
                        </p>
                      </li>
                    ))}
                  </ul>
                )}

                {forma.detalle && <p class="subtitle max-w-md">{forma.detalle}</p>}

                {forma.action?.href && (
                  <div class="mt-6">
                    <ArrowButton
                      label={forma.action.label}
                      href={forma.action.href}
                      variant="accent"
                      external={forma.action.external}
                    />
                  </div>
                )}
              </div>

              <div class="mt-8 lg:mt-10">
                <h3 class="text-[1.0625rem] font-semibold tracking-[-0.02em] text-ink">
                  {forma.title}
                </h3>
                <p class="forma-resumen mt-2 text-[0.9375rem] leading-relaxed text-muted">
                  {forma.summary}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .forma-cuerpo {
    opacity: 0;
    pointer-events: none;
    transition: opacity 350ms ease;
  }

  .forma[data-abierta='true'] .forma-cuerpo {
    opacity: 1;
    pointer-events: auto;
  }

  .forma[data-abierta='true'] .forma-mas {
    transform: rotate(45deg);
  }

  /*
    En móvil no hay sitio para dejar el hueco reservado, así que ahí la ficha
    sí crece y encoge: se anima el alto por filas de rejilla, para no tener
    que medir el contenido.
  */
  @media (width < 64rem) {
    .forma-cuerpo {
      display: grid;
      grid-template-rows: 0fr;
      margin-top: 0;
      transition:
        grid-template-rows 450ms ease,
        opacity 350ms ease,
        margin-top 450ms ease;
    }

    .forma-cuerpo > * {
      overflow: hidden;
    }

    .forma[data-abierta='true'] .forma-cuerpo {
      grid-template-rows: 1fr;
      margin-top: 1.5rem;
    }
  }

  /* en fila, la abierta se lleva el ancho y las otras se encogen */
  @media (width >= 64rem) {
    /*
      `flex-basis: 0` es lo que hace que el reparto sea el de los números y no
      el del contenido: con base automática, el ancho del título de cada ficha
      se colaba en la cuenta y la abierta se quedaba corta.
    */
    .forma {
      flex: 1 1 0;
      /*
        Sin esto una ficha no baja del ancho de su título —«Transferencia
        bancaria» pedía 215px— y la abierta se queda con lo que sobre en vez
        de con lo que le toca.
      */
      min-width: 0;
    }

    /*
      Bastante más que las otras dos: con menos, las tres cuentas de la
      transferencia se aprietan y los correos se parten a mitad de palabra.
    */
    .forma[data-abierta='true'] {
      flex-grow: 4;
    }

    /* estrecha, la bajada se parte en seis líneas: ahí sobra */
    .forma[data-abierta='false'] .forma-resumen {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .forma,
    .forma-cuerpo,
    .forma-mas {
      transition: none;
    }
  }
</style>

<script>
  /*
    Solo una abierta a la vez. Se abre al pasar el ratón —como en la
    referencia— y también al pulsar, que es lo único que existe en táctil.
  */
  const grupo = document.querySelector<HTMLElement>('.formas');
  const fichas = [...(grupo?.querySelectorAll<HTMLElement>('.forma') ?? [])];

  if (grupo && fichas.length) {
    const abrir = (id: string) => {
      for (const ficha of fichas) {
        const abierta = ficha.dataset.forma === id;
        ficha.dataset.abierta = String(abierta);
        ficha.querySelector('[data-abre]')?.setAttribute('aria-expanded', String(abierta));
      }
    };

    for (const ficha of fichas) {
      const id = ficha.dataset.forma;
      if (!id) continue;

      ficha.querySelector('[data-abre]')?.addEventListener('click', () => abrir(id));

      // el hover solo manda donde hay ratón: en táctil dispara al tocar y estorba
      if (window.matchMedia('(hover: hover)').matches) {
        ficha.addEventListener('mouseenter', () => abrir(id));
      }
    }
  }
</script>
