---
import ArrowButton from './ArrowButton.astro';
import { giving } from '../data/content';
---

{/*
  Sección a pantalla completa, con la foto de fondo. `svh` en vez de `vh`
  porque en el móvil la barra del navegador aparece y desaparece: con `vh` la
  sección cambiaría de alto y daría saltos al hacer scroll.

  La foto sale del tramo oscuro que la envuelve (`.tema-editorial`), así que
  la misma imagen reaparece más abajo por el hueco del testimonio.
*/}
<section
  id="dar"
  class="foto-fija relative flex min-h-svh items-center py-12 lg:py-16"
  aria-labelledby="dar-titulo"
>
  {/* velo parejo, no degradado: el texto blanco cruza las zonas claras */}
  <div class="absolute inset-0 bg-[#090909]/55" aria-hidden="true"></div>

  <div class="container-page relative">
    <div class="mx-auto max-w-2xl text-center">
      <p class="subtitle-lg text-ink/80">
        {giving.verse}<br />
        {giving.reference}
      </p>

      <h2 id="dar-titulo" class="heading-xl mt-6 text-ink text-balance">{giving.title}</h2>

      {
        giving.action.href && (
          <ArrowButton
            label={giving.action.label}
            href={giving.action.href}
            variant="accent"
            size="lg"
            external={giving.action.external}
            class="mt-10"
          />
        )
      }
    </div>
  </div>
</section>
