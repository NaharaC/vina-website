---
interface Props {
  title: string;
  /** id del <h2>, para enlazarlo con aria-labelledby de la sección */
  id?: string;
  subtitle?: string;
  /** rótulo en versalitas sobre el título */
  eyebrow?: string;
  align?: 'left' | 'center';
  size?: 'lg' | 'xl';
  /** `p` para copias que solo reservan espacio: no duplica el <h2> del documento */
  as?: 'h2' | 'p';
  class?: string;
}

const {
  title,
  id,
  subtitle,
  eyebrow,
  align = 'left',
  size = 'lg',
  as: Tag = 'h2',
  class: className = '',
} = Astro.props;
---

<div class:list={[align === 'center' ? 'text-center' : 'text-left', className]}>
  {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}

  <Tag id={id} class:list={[size === 'xl' ? 'heading-xl' : 'heading-lg', 'text-ink']}>{title}</Tag>

  {
    subtitle && (
      <p class:list={['subtitle-lg mt-3 max-w-2xl', align === 'center' && 'mx-auto']}>{subtitle}</p>
    )
  }
</div>
