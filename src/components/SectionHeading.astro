---
interface Props {
  title: string;
  /** id del <h2>, para enlazarlo con aria-labelledby de la sección */
  id?: string;
  /** microetiqueta en monoespaciada sobre el título */
  eyebrow?: string;
  subtitle?: string;
  align?: 'left' | 'center';
  /** los versículos conservan la serif cursiva */
  subtitleStyle?: 'sans' | 'serif';
  size?: 'lg' | 'xl';
  /** `p` para copias que solo reservan espacio: no duplica el <h2> del documento */
  as?: 'h2' | 'p';
  class?: string;
}

const {
  title,
  id,
  eyebrow,
  subtitle,
  align = 'left',
  subtitleStyle = 'sans',
  size = 'lg',
  as: Tag = 'h2',
  class: className = '',
} = Astro.props;
---

<div class:list={[align === 'center' ? 'text-center' : 'text-left', className]}>
  {eyebrow && <p class="label-mono mb-5 text-muted">{eyebrow}</p>}

  <Tag id={id} class:list={[size === 'xl' ? 'heading-xl' : 'heading-lg', 'text-ink text-balance']}>
    {title}
  </Tag>

  {
    subtitle && (
      <p
        class:list={[
          'mt-5 max-w-md',
          align === 'center' && 'mx-auto',
          subtitleStyle === 'serif'
            ? 'font-serif text-lg italic text-muted sm:text-xl'
            : 'text-[0.9375rem] leading-relaxed text-muted',
        ]}
      >
        {subtitle}
      </p>
    )
  }
</div>
