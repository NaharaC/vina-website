---
/**
 * Encabezado de sección, el mismo en toda la home.
 *
 * Rótulo en versalitas, línea fina y —si hace falta— el título grande y una
 * bajada. Las secciones cuyo contenido ya trae tipografía grande (las
 * actividades, los proyectos) usan solo el rótulo: con dos cuerpos grandes
 * seguidos no se distingue cuál es el título de la sección.
 */
interface Props {
  /** Rótulo en versalitas. Es lo único obligatorio. */
  eyebrow: string;
  title?: string;
  subtitle?: string;
  /** id del título, para enlazarlo con el `aria-labelledby` de la sección */
  id?: string;
  /** `p` cuando el <h2> real vive dentro del contenido de la sección */
  as?: 'h2' | 'p';
  class?: string;
}

const { eyebrow, title, subtitle, id, as: Tag = 'h2', class: className = '' } = Astro.props;
---

<div class:list={['border-b border-ink/15 pb-5', className]}>
  {/* sin título, el rótulo es el encabezado y carga con el id */}
  {
    title ? (
      <p class="eyebrow">{eyebrow}</p>
    ) : (
      <Tag id={id} class="eyebrow text-ink">
        {eyebrow}
      </Tag>
    )
  }

  {
    title && (
      <div class="mt-6 lg:flex lg:items-end lg:justify-between lg:gap-12">
        <Tag id={id} class="heading-lg max-w-2xl text-ink text-balance">
          {title}
        </Tag>

        {subtitle && <p class="subtitle-lg mt-3 max-w-md lg:mt-0 lg:shrink-0 lg:pb-1">{subtitle}</p>}
      </div>
    )
  }
</div>
