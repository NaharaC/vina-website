---
import { stats } from '../data/content';

// dos por fila: cada fila lleva su propio filete y su divisor central
const rows = [stats.slice(0, 2), stats.slice(2)];
---

{/*
  Cifras en dos por dos dentro de un marco de tres líneas horizontales
  (arriba, al medio y abajo). El divisor vertical va recortado por arriba y
  por abajo, así no toca ninguna de ellas.
*/}
<section class="py-10 lg:py-14" aria-label="La iglesia en cifras">
  <div class="container-page">
    <div class="border-y border-ink/15">
      {
        rows.map((row, index) => (
          <div
            class:list={[
              'cifras-fila relative grid gap-x-16 py-8 sm:grid-cols-2 lg:gap-x-24 lg:py-10',
              index < rows.length - 1 && 'border-b border-ink/15',
            ]}
          >
            {row.map((stat) => (
              <div class="max-w-md not-first:mt-10 sm:not-first:mt-0">
                <p class="eyebrow">{stat.caption}</p>

                <p class="mt-3 text-[2.5rem] leading-none font-semibold tracking-[-0.04em] text-ink lg:text-[3.25rem]">
                  {stat.value}
                </p>

                {stat.description && (
                  <p class="subtitle mt-3">{stat.description}</p>
                )}
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /*
    Divisor entre columnas: va al centro exacto de la fila —que con dos
    columnas iguales es el centro del canal— y recortado en los extremos
    para no cruzarse con los filetes horizontales.
  */
  @media (min-width: 40rem) {
    .cifras-fila::after {
      content: '';
      position: absolute;
      top: 1.75rem;
      bottom: 1.75rem;
      left: 50%;
      width: 1px;
      background-color: color-mix(in srgb, var(--color-ink) 15%, transparent);
    }
  }
</style>
