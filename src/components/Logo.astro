---
import { Image } from 'astro:assets';
import { logo } from '../data/content';

interface Props {
  class?: string;
  /** ancho en px del logo */
  width?: number;
  /**
   * Ancho en px del icono suelto. Si se pasa, el enlace lleva las dos
   * versiones —marca entera e icono— y quien lo usa decide cuál enseña
   * apuntando a `.marca` y `.icono`. Lo pide la barra, que cambia una por
   * otra al encogerse en píldora.
   */
  iconWidth?: number;
}

const { class: className = '', width = 132, iconWidth } = Astro.props;
---

<a
  href="/"
  class:list={['inline-flex shrink-0 items-center', className]}
  aria-label="Iglesia Viña Puerto Montt — ir al inicio"
>
  <Image
    src={logo.src}
    alt={logo.alt}
    width={width}
    densities={[1, 2]}
    class="marca h-auto"
    loading="eager"
    decoding="async"
  />

  {
    iconWidth && (
      /* el nombre ya lo dice el `aria-label` del enlace: aquí sobra */
      <Image
        src={logo.icon}
        alt=""
        width={iconWidth}
        densities={[1, 2]}
        class="icono h-auto"
        loading="eager"
        decoding="async"
      />
    )
  }
</a>
