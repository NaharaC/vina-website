---
import { Image } from 'astro:assets';
import ArrowButton from './ArrowButton.astro';
import type { CompassionCard } from '../data/content';

interface Props {
  card: CompassionCard;
  /** el card de "Nosotros": logotipo más grande y, en móvil, foto más alta */
  feature?: boolean;
}

const { card, feature = false } = Astro.props;
---

<article class="group">
  <div
    class:list={[
      'relative overflow-hidden rounded-[1.5rem]',
      // en cuanto hay dos columnas, la de "Nosotros" toma el mismo 16/9 que
      // las de al lado: como las columnas miden igual, las fotos quedan del
      // mismo alto y arrancan y terminan a la par. Sola en el móvil se
      // permite ser más alta
      feature ? 'aspect-[5/4] md:aspect-[16/9]' : 'aspect-[16/9]',
    ]}
  >
    <Image
      src={card.image}
      alt={card.alt}
      widths={[480, 720, 1080]}
      sizes="(min-width: 64rem) 620px, 90vw"
      class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      loading="lazy"
      decoding="async"
    />

    {
      card.overlayLogo && (
        <div class="pointer-events-none absolute inset-0 grid place-items-center p-8">
          <Image
            src={card.overlayLogo}
            alt={card.overlayLogoAlt ?? ''}
            widths={[220, 440]}
            sizes="220px"
            class:list={[
              'w-auto object-contain drop-shadow-lg',
              feature ? 'max-h-20 max-w-[65%]' : 'max-h-16 max-w-[55%]',
            ]}
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }
  </div>

  <div class="mt-5">
    <h3 class="heading-md text-ink">{card.title}</h3>

    <div class="mt-3 flex items-start justify-between gap-6">
      <p class="subtitle max-w-sm">
        {card.description}
      </p>
      {
        card.href && (
          <ArrowButton
            label={card.ctaLabel ?? 'Ver más'}
            href={card.href}
            variant="accent"
            external={card.external}
          />
        )
      }
    </div>
  </div>
</article>
