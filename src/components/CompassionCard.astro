---
/**
 * Una tarjeta de «Una familia compasiva»: la foto con el logotipo encima y,
 * debajo, el título con su etiqueta al otro extremo, la descripción y el
 * botón que lleva a su destino.
 *
 * El botón de la iglesia va en naranja y el de cada proyecto en gris, el
 * mismo de «Ver todos los proyectos»: en una columna con cuatro botones, si
 * todos son naranjas no hay ninguno principal.
 *
 * Sin `href` no hay botón: la tarjeta se queda en foto y texto, que es lo que
 * toca mientras un proyecto no tenga a dónde llevar.
 */
import { Image } from 'astro:assets';
import ArrowButton from './ArrowButton.astro';
import type { CompassionCard } from '../data/content';

interface Props {
  card: CompassionCard;
  /** la tarjeta que abre la sección: foto cuadrada y logotipo más grande */
  feature?: boolean;
}

const { card, feature = false } = Astro.props;
---

{/*
  Fijada, la tarjeta de la iglesia se adapta al alto de la ventana: la columna
  de fuera le pone el tope y aquí quien cede es la foto —`min-h-0` para que
  pueda encogerse por debajo de su cuadrado, y el pie quieto—, de modo que el
  título, la bajada y el botón siguen a la vista aunque la ventana sea baja.
  Como la foto va con `object-cover`, encogerla de alto la encuadra más
  apaisada y no la deforma. Es lo mismo que se hace con la columna de las
  redes en `soy-nuevo`.
*/}
<article class:list={[feature && 'lg:flex lg:h-full lg:min-h-0 lg:flex-col']}>
  <div
    class:list={[
      'relative overflow-hidden rounded-[1.5rem]',
      feature && 'lg:min-h-[18rem]',
      // La grande va cuadrada, no vertical: en 4/5 medía 805 de foto más el
      // pie, y en la pantalla de un portátil no cabía entera nunca —solo se
      // veía foto—. Cuadrada sigue siendo la pieza grande frente a las
      // apaisadas de al lado. Sola en el teléfono se permite ser más ancha.
      feature ? 'aspect-[5/4] lg:aspect-square' : 'aspect-[16/9]',
    ]}
  >
    <Image
      src={card.image}
      alt={card.alt}
      widths={[480, 720, 1080]}
      sizes="(min-width: 64rem) 620px, 90vw"
      class="size-full object-cover"
      style={card.imagePosition && `object-position: ${card.imagePosition}`}
      loading="lazy"
      decoding="async"
    />

    {
      card.overlayLogo && (
        <div class="pointer-events-none absolute inset-0 grid place-items-center p-8">
          <Image
            src={card.overlayLogo}
            alt={card.overlayLogoAlt ?? ''}
            widths={[220, 440]}
            sizes="220px"
            class:list={[
              'w-auto object-contain drop-shadow-lg',
              feature ? 'max-h-20 max-w-[65%]' : 'max-h-16 max-w-[55%]',
            ]}
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }
  </div>

  <div class:list={['tarjeta-pie mt-5', feature && 'lg:shrink-0']}>
    {/*
      Título y etiqueta a los dos extremos de la misma fila. La etiqueta no se
      encoge y el título sí: si no cabe, el que dobla de línea es el título.
    */}
    <div class="flex items-baseline justify-between gap-6">
      <h3 class="heading-md min-w-0 text-ink">{card.title}</h3>
      {card.tag && <p class="rotulo shrink-0 text-muted">{card.tag}</p>}
    </div>

    {card.description && <p class="subtitle mt-3 max-w-lg">{card.description}</p>}

    {
      card.href && (
        <ArrowButton
          label={card.ctaLabel ?? 'Ver más'}
          href={card.href}
          variant={feature ? 'accent' : 'mist'}
          external={card.external}
          class="mt-6"
        />
      )
    }
  </div>
</article>
