---
/**
 * Lo que viene.
 *
 * De los proyectos futuros no hay más foto que la del terreno nuevo, así que
 * aquí no hay un rectángulo por proyecto como en los de compasión social: hay
 * uno solo, con la foto quieta dentro, y los cuatro sueños suben por al lado.
 *
 * El nombre de cada sueño va un peldaño por debajo del título de la
 * sección, como en los proyectos de compasión social.
 *
 * En el teléfono va otra forma, más corta: la foto con la superficie
 * encima, los cuatro sueños en una lista numerada —el nombre y una línea, su
 * `resumen`— y la llamada a dar en una franja oscura. El marcado de
 * escritorio se esconde por debajo de 64rem.
 *
 * Cierra la sección, en las dos formas, la tarjeta plegada de quien quiere
 * servir con su profesión (`Sumate`).
 */
import { Image } from 'astro:assets';
import ArrowButton from './ArrowButton.astro';
import SectionHeading from './SectionHeading.astro';
import Sumate from './Sumate.astro';
import { about } from '../data/content';

const { title, eyebrow, items, foto, fotoAlt, fotoPie, superficie, cierre, action } = about.sueños;
---

<section id="suenos" class="pb-20 lg:pb-48" aria-labelledby="suenos-titulo">
  <div class="container-page">
    <SectionHeading id="suenos-titulo" eyebrow={eyebrow} numero="03" title={title} />

    {/* El teléfono */}
    <div class="suenos-movil lg:hidden">
      <figure class="mt-8">
        <div class="relative overflow-hidden rounded-[1.25rem]">
          <Image
            src={foto}
            alt={fotoAlt}
            widths={[640, 960]}
            sizes="92vw"
            class="aspect-[5/3] w-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <span class="heading-sm absolute bottom-3 left-3 rounded-[1rem] bg-white px-3.5 py-2 text-ink">
            {superficie}
          </span>
        </div>
        <figcaption class="nota mt-3">{fotoPie}</figcaption>
      </figure>

      <ol class="mt-8 list-none border-b border-ink/15 p-0">
        {
          items.map((sueno, i) => (
            <li class="flex gap-3.5 border-t border-ink/15 py-4">
              <span class="rotulo w-6 shrink-0 pt-1 text-muted" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="heading-sm text-ink">{sueno.title}</h3>
                <p class="nota mt-1">{sueno.resumen}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="mt-6 flex items-center justify-between gap-3 rounded-[1.25rem] bg-carbon py-4 pl-5 pr-4">
        <p class="heading-sm text-white">{cierre}</p>
        <ArrowButton
          label={action.label}
          href={action.href}
          external={action.external}
          variant="light"
          size="md"
        />
      </div>
    </div>
  </div>

  <div class="tira-suenos tira-derecha mt-16 max-lg:hidden lg:mt-24">
    {/*
      La foto va antes que el texto en el marcado: en el teléfono se lee
      primero, y en escritorio la rejilla la manda a la derecha.
    */}
    <div class="panel-terreno">
      <div class="terreno-quieto">
        <figure class="terreno-foto">
          <Image
            src={foto}
            alt={fotoAlt}
            widths={[640, 960, 1440]}
            sizes="(min-width: 64rem) 700px, 90vw"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <p class="nota mt-5 max-w-lg">{fotoPie}</p>
      </div>
    </div>

    <div class="columna-suenos">
      {
        items.map((sueno) => (
          <article>
            <h3 class="heading-md text-ink">{sueno.title}</h3>

            <p class="subtitle sueno-cuerpo mt-5 max-w-md">{sueno.body}</p>

            {sueno.lista && (
              <ul class="mt-7 list-none p-0">
                {sueno.lista.map((linea) => <li class="nota">{linea}</li>)}
              </ul>
            )}
          </article>
        ))
      }

      {/*
        El cierre de los sueños es la única llamada de la sección, y va
        después de leerlos todos: pide más voz que un sueño más —de ahí el
        cuerpo de título— y la pastilla naranja, que es la de las llamadas de
        la web. El botón discreto se quedaba enterrado al final de la columna.
      */}
      <div>
        <p class="heading-md max-w-lg text-ink text-balance">{cierre}</p>

        <ArrowButton
          label={action.label}
          href={action.href}
          external={action.external}
          variant="accent"
          size="md"
          class="mt-6"
        />
      </div>
    </div>
  </div>

  <div class="container-page mt-6 lg:mt-24">
    <Sumate />
  </div>
</section>

<style>
  .panel-terreno {
    background-color: var(--color-mist);
    border-radius: 1.5rem 0 0 1.5rem;
    padding: 1.5rem;
  }

  .terreno-foto {
    margin: 0;
    border-radius: 1.25rem;
    overflow: hidden;
    background-color: #fff;
    box-shadow: 0 1.25rem 3rem rgba(17, 17, 17, 0.14);
  }

  .columna-suenos {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-top: 3rem;
    padding-inline-end: 1.25rem;
  }

  @media (width >= 40rem) {
    .columna-suenos {
      padding-inline-end: 2rem;
    }
  }

  /* como el de los proyectos: el cuerpo de `subtitle`, en tinta */
  .sueno-cuerpo {
    color: var(--color-ink);
  }

  @media (width >= 64rem) {
    .tira-suenos {
      display: grid;
      grid-template-columns: 28.75rem minmax(0, 1fr);
      gap: 6rem;
      align-items: stretch;
    }

    /* la foto a la derecha, el texto a la izquierda */
    .panel-terreno {
      order: 2;
      border-radius: 2rem 0 0 2rem;
      padding: 3.5rem 4rem;
    }

    .columna-suenos {
      order: 1;
      gap: 7rem;
      margin-top: 0;
      padding-block: 0.5rem 3rem;
      padding-inline-end: 0;
    }

    /*
      La foto se queda quieta mientras los sueños suben. El gris de detrás
      acompaña a toda la columna, así que lo pegajoso es la foto y no el
      rectángulo.
    */
    .terreno-quieto {
      position: sticky;
      top: 7rem;
    }
  }
</style>

{/* los estilos con ámbito no alcanzan a `<Image>` */}
<style is:global>
  .tira-suenos .terreno-foto img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
