---
import { Image } from 'astro:assets';
import { partners } from '../data/content';
---

<section class="hairline py-14 lg:py-16" aria-label="Fundaciones y proyectos aliados">
  <div class="container-page">
    <div class="grid items-center gap-10 lg:grid-cols-[auto_1fr] lg:gap-16">
      <p class="label-mono text-muted">Fundaciones y proyectos aliados</p>

      <ul
        class="grid grid-cols-2 items-center justify-items-center gap-x-8 gap-y-10 sm:grid-cols-3 lg:flex lg:justify-between lg:gap-10"
      >
        {
          partners.map((partner) => (
            <li class="flex items-center justify-center">
              <Image
                src={partner.logo}
                alt={partner.name}
                height={32}
                densities={[1, 2]}
                class="h-7 w-auto max-w-[8rem] object-contain sm:h-8"
                loading="lazy"
                decoding="async"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
