---
/**
 * Los proyectos de compasión social, uno debajo de otro.
 *
 * Cada proyecto es un bloque de dos columnas: a la izquierda el relato —el
 * nombre, el párrafo y la lista de datos sueltos—, y a la derecha un
 * rectángulo gris con sus dos fotos montadas y el logotipo. El texto se queda
 * quieto mientras el rectángulo sube por al lado.
 *
 * El nombre del proyecto va en `heading-md` y no en `heading-lg`: el
 * título de la sección ya ocupa ese peldaño, y con los dos en el mismo
 * cuerpo no se distingue cuál es cuál.
 *
 * El rectángulo llega al filo derecho de la ventana: es el único bloque de la
 * web que lo hace, y por eso el redondeo va solo en las esquinas de la
 * izquierda. En el teléfono no hay dos columnas: el texto va arriba y el
 * rectángulo debajo, y las fotos se apilan en vez de montarse.
 *
 * Eso era en el teléfono la parte más larga de `nosotros`, así que allí los
 * proyectos van en otra forma: tarjetas que pasan de lado, cada una con una
 * foto, el `resumen` y sus tres `destacados`. El marcado de escritorio se
 * esconde y el del teléfono solo existe por debajo de 64rem. Al final va el
 * enlace al formulario de quien quiere servir con su profesión.
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BotonPalabra from './BotonPalabra.astro';
import SectionHeading from './SectionHeading.astro';
import { about } from '../data/content';

const { title, eyebrow, items } = about.proyectos;
const { enlace } = about.sumate;
---

<section id="proyectos" class="pb-20 lg:pb-48" aria-labelledby="proyectos-titulo">
  {/* El encabezado sí se queda en la caja de la página; el que sale al filo es
      el rectángulo de las fotos, más abajo. */}
  <div class="container-page">
    <SectionHeading id="proyectos-titulo" eyebrow={eyebrow} numero="02" title={title} />

    <p class="nota mt-4 flex items-center gap-1.5 lg:hidden" aria-hidden="true">
      Desliza para verlos
      <Icon name="lucide:arrow-right" width={14} height={14} />
    </p>
  </div>

  {/* El teléfono: una tarjeta por proyecto, que pasan de lado. */}
  <div class="lg:hidden">
    <ul data-carril class="carril-proyectos sin-barra mt-6 flex list-none gap-3 overflow-x-auto p-0">
      {
        items.map((proyecto) => (
          <li class="tarjeta-proyecto relative flex flex-col overflow-hidden rounded-[1.5rem] bg-mist">
            <Image
              src={proyecto.photo}
              alt={proyecto.photoAlt}
              widths={[480, 720]}
              sizes="19rem"
              class="aspect-[8/5] w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <div class="flex grow flex-col gap-3 p-5">
              <h3 class="heading-md text-ink">{proyecto.title}</h3>
              <p class="subtitle text-ink">{proyecto.resumen}</p>
              <ul class="flex list-none flex-col gap-1 p-0">
                {proyecto.destacados.map((linea) => <li class="nota">{linea}</li>)}
              </ul>
              <a
                href={proyecto.action.href}
                target={proyecto.action.external ? '_blank' : undefined}
                rel={proyecto.action.external ? 'noopener noreferrer' : undefined}
                class="mt-auto inline-flex min-h-11 items-center gap-2 self-start text-[1rem] font-semibold text-ink"
              >
                {proyecto.action.label}
                {proyecto.action.external && <span class="sr-only">(se abre en una ventana nueva)</span>}
                <Icon name="lucide:arrow-right" width={16} height={16} class="text-accent-strong" aria-hidden="true" />
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    {/* Qué tarjeta se está viendo. Lo mueve el script de abajo. */}
    <div class="mt-4 flex justify-center gap-1.5" aria-hidden="true">
      {items.map((_, i) => <span data-punto class="punto" data-activo={i === 0 ? '' : undefined} />)}
    </div>

    <div class="container-page mt-6">
      <a
        href="#sumate"
        data-abre-sumate
        class="flex min-h-11 items-center justify-between gap-3 border-t border-ink/15 py-3 text-[1rem] font-medium text-ink"
      >
        {enlace}
        <Icon name="lucide:chevron-down" width={18} height={18} class="shrink-0 text-accent-strong" aria-hidden="true" />
      </a>
    </div>
  </div>

  <div class="tira-proyectos tira-derecha mt-16 max-lg:hidden lg:mt-24">
    {
      items.map((proyecto) => (
        <article class="bloque-proyecto">
          <div class="bloque-texto">
            <h3 class="heading-md text-ink">{proyecto.title}</h3>

            <p class="subtitle bloque-cuerpo mt-5 max-w-md">{proyecto.body}</p>

            <ul class="mt-7 list-none p-0">
              {proyecto.lista.map((linea) => <li class="nota">{linea}</li>)}
            </ul>

            <BotonPalabra
              label={proyecto.action.label}
              href={proyecto.action.href}
              external={proyecto.action.external}
              class="mt-9"
            />
          </div>

          {/*
            Las dos fotos y el logotipo. En escritorio se montan una sobre otra
            dentro del rectángulo; en el teléfono se apilan.
          */}
          <div class="panel-fotos">
            <div class="collage">
              <figure class="pieza pieza-grande">
                <Image
                  src={proyecto.photo}
                  alt={proyecto.photoAlt}
                  widths={[480, 720, 1080]}
                  sizes="(min-width: 64rem) 600px, 90vw"
                  loading="lazy"
                  decoding="async"
                />
              </figure>

              <figure class="pieza pieza-chica">
                <Image
                  src={proyecto.photoSecundaria}
                  alt={proyecto.photoSecundariaAlt}
                  widths={[360, 540, 800]}
                  sizes="(min-width: 64rem) 400px, 90vw"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  /*
    Las tarjetas del teléfono. La fila llega de filo a filo; el margen de la
    página lo pone el relleno, para que la primera tarjeta arranque alineada
    con el título.
  */
  .carril-proyectos {
    --margen: 1.25rem;
    scroll-snap-type: x mandatory;
    padding-inline: var(--margen);
    scroll-padding-inline: var(--margen);
  }

  @media (width >= 40rem) {
    .carril-proyectos {
      --margen: 2rem;
    }
  }

  .tarjeta-proyecto {
    flex: 0 0 19rem;
    scroll-snap-align: start;
  }

  .punto {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-ink) 20%, transparent);
    transition: width 0.25s, background-color 0.25s;
  }

  .punto[data-activo] {
    width: 1.125rem;
    background-color: var(--color-ink);
  }

  /* apilado, el rectángulo necesita aire por arriba: si no, el botón queda
     pegado al gris */
  .bloque-proyecto {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .bloque-proyecto + .bloque-proyecto {
    margin-top: 5rem;
  }

  /* el texto sí respeta el margen de la derecha; el que sale al filo es el
     rectángulo gris */
  .bloque-texto {
    padding-inline-end: 1.25rem;
  }

  @media (width >= 40rem) {
    .bloque-texto {
      padding-inline-end: 2rem;
    }
  }

  /* el cuerpo sale de `subtitle`; aquí solo cambia el color, porque es el
     texto principal del bloque y no una bajada */
  .bloque-cuerpo {
    color: var(--color-ink);
  }

  .panel-fotos {
    background-color: var(--color-mist);
    border-radius: 1.5rem 0 0 1.5rem;
    padding: 1.5rem;
  }

  .collage {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pieza {
    margin: 0;
    border-radius: 1.25rem;
    overflow: hidden;
    background-color: #fff;
    box-shadow: 0 1.25rem 3rem rgba(17, 17, 17, 0.14);
  }

  /* En cuanto hay sitio: dos columnas, el texto quieto y las fotos montadas */
  @media (width >= 64rem) {
    .bloque-proyecto {
      display: grid;
      grid-template-columns: 28.75rem minmax(0, 1fr);
      gap: 6rem;
      align-items: start;
    }

    .bloque-proyecto + .bloque-proyecto {
      margin-top: 8rem;
    }

    /*
      El relato se queda quieto mientras el rectángulo sube. El recorrido es
      la diferencia entre los dos: el rectángulo mide 48rem y el texto más
      largo —el de Educa Montealto— ronda las 34rem, así que se queda quieto
      unos 200px. Si a un proyecto se le alarga mucho la lista, el efecto se
      come a sí mismo; y pasadas las ~43rem de texto el final no llegaría a
      verse en un portátil, que es la trampa de «Nuestra historia».
    */
    .bloque-texto {
      position: sticky;
      top: 7rem;
      padding-inline-end: 0;
    }

    .panel-fotos {
      border-radius: 2rem 0 0 2rem;
      padding: 3.5rem 4rem;
      min-height: 48rem;
    }

    .collage {
      display: block;
      position: relative;
      height: 100%;
      min-height: 41rem;
    }

    .pieza {
      position: absolute;
      transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .pieza-grande {
      top: 0;
      left: 0;
      width: 70%;
      aspect-ratio: 4 / 3;
    }

    .pieza-chica {
      right: 0;
      bottom: 4%;
      width: 52%;
      aspect-ratio: 1 / 1;
    }

    /* al pasar el ratón las fotos se separan un poco */
    .panel-fotos:hover .pieza-grande {
      transform: translateY(-0.625rem);
    }

    .panel-fotos:hover .pieza-chica {
      transform: translateY(0.625rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pieza {
      transition: none;
    }
  }
</style>

{/*
  Los estilos con ámbito no alcanzan a `<Image>`: lo pinta el componente y no
  recibe el atributo de ámbito. De ahí este bloque global, acotado por la
  clase del contenedor.
*/}
<style is:global>
  /* Apiladas manda la foto, que trae su propia proporción; montadas manda el
     marco, y la foto lo rellena. */
  .tira-proyectos .pieza img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  @media (width >= 64rem) {
    .tira-proyectos .pieza img {
      height: 100%;
    }
  }
</style>

<script>
  /*
    Los puntos de debajo de las tarjetas: se marca la que está más cerca del
    borde izquierdo de la fila, que es donde se detiene cada una al soltar.
  */
  document.querySelectorAll<HTMLElement>('[data-carril]').forEach((carril) => {
    const tarjetas = Array.from(carril.children) as HTMLElement[];
    const puntos = Array.from(
      carril.parentElement?.querySelectorAll<HTMLElement>('[data-punto]') ?? []
    );

    if (!puntos.length) return;

    let pedido = 0;

    const marcar = () => {
      pedido = 0;
      const inicio = carril.scrollLeft;
      let activa = 0;
      let cerca = Infinity;

      tarjetas.forEach((tarjeta, i) => {
        const distancia = Math.abs(tarjeta.offsetLeft - carril.offsetLeft - inicio);
        if (distancia < cerca) {
          cerca = distancia;
          activa = i;
        }
      });

      // la última no llega nunca al borde: al tope de la fila, es ella
      if (inicio + carril.clientWidth >= carril.scrollWidth - 2) activa = tarjetas.length - 1;

      puntos.forEach((punto, i) => punto.toggleAttribute('data-activo', i === activa));
    };

    carril.addEventListener(
      'scroll',
      () => {
        if (!pedido) pedido = requestAnimationFrame(marcar);
      },
      { passive: true }
    );
  });
</script>
