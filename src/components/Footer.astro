---
import { Icon } from 'astro-icon/components';
import ArrowButton from './ArrowButton.astro';
import Logo from './Logo.astro';
import { credit, footerColumns, organization, site, socials } from '../data/content';
---

<footer class="bg-carbon text-paper">
  <div class="container-page py-16 lg:py-20">
    <div class="flex flex-wrap items-end justify-between gap-8 border-b border-white/15 pb-12">
      <div>
        <Logo width={132} />
        <p class="label-mono mt-6 max-w-xs text-paper/50">
          {[organization.streetAddress, organization.addressLocality, 'Chile']
            .filter(Boolean)
            .join(' · ')}
        </p>
      </div>
      <ArrowButton label="Dar" href="#dar" variant="light" />
    </div>

    <div class="mt-14 grid gap-12 sm:grid-cols-2 lg:grid-cols-[repeat(3,minmax(0,1fr))_auto]">
      {
        footerColumns.map((column) => (
          <nav aria-label={column.title}>
            <h2 class="label-mono text-paper/50">{column.title}</h2>
            <ul class="mt-6 flex flex-col gap-3.5 text-[0.9375rem]">
              {column.links.map((link) => (
                <li>
                  {/* sin destino todavía: se muestra el texto, no un enlace muerto */}
                  {link.href ? (
                    <a href={link.href} class="text-paper/80 transition-colors hover:text-paper">
                      {link.label}
                    </a>
                  ) : (
                    <span class="text-paper/45">{link.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <ul class="flex items-start gap-5 lg:justify-end">
        {
          socials.map(
            (social) =>
              social.href && (
                <li>
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="grid size-6 place-items-center text-paper transition-opacity hover:opacity-60"
                    aria-label={`${social.label} (se abre en una ventana nueva)`}
                  >
                    <Icon name={social.icon} width={22} height={22} aria-hidden="true" />
                  </a>
                </li>
              )
          )
        }
      </ul>
    </div>

    <div
      class="mt-16 flex flex-wrap items-end justify-between gap-6 border-t border-white/15 pt-8 lg:mt-20"
    >
      <p class="label-mono text-paper/40">
        © {new Date().getFullYear()} {site.name} · <a
          href={credit.href}
          target="_blank"
          class="transition-colors hover:text-paper"
          rel="noopener noreferrer">{credit.label}</a
        >
      </p>

      <a
        href="#top"
        class="grid size-12 place-items-center rounded-full bg-white/10 text-paper transition-colors hover:bg-white/20"
        aria-label="Volver arriba"
      >
        <Icon name="lucide:arrow-up" width={18} height={18} aria-hidden="true" />
      </a>
    </div>
  </div>
</footer>
