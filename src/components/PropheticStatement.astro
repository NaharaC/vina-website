---
import BotonPalabra from './BotonPalabra.astro';
import { propheticWord } from '../data/content';
---

{/*
  Declaración a media página, como la referencia: mucho aire a la izquierda y
  la palabra profética en grande a la derecha, con su botón al pie.
*/}
<section id="palabra" class="seccion" aria-labelledby="palabra-titulo">
  <div class="container-page">
    <div class="md:grid md:grid-cols-[1fr_1.1fr] md:gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="md:col-start-2">
        <p class="eyebrow">
          {propheticWord.source}
        </p>

        <blockquote
          id="palabra-titulo"
          class="heading-xl mt-6 text-ink text-balance"
        >
          {propheticWord.quote}
        </blockquote>

        <BotonPalabra label="Conócenos" href="/nosotros" class="mt-10" />
      </div>
    </div>
  </div>
</section>
