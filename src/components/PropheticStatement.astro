---
import { Icon } from 'astro-icon/components';
import { propheticWord } from '../data/content';
---

{/*
  Declaración a media página, como la referencia: mucho aire a la izquierda y
  la palabra profética en grande a la derecha, con su botón al pie.
*/}
<section id="palabra" class="seccion" aria-labelledby="palabra-titulo">
  <div class="container-page">
    <div class="md:grid md:grid-cols-[1fr_1.1fr] md:gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="md:col-start-2">
        <p class="eyebrow">
          {propheticWord.source}
        </p>

        <blockquote
          id="palabra-titulo"
          class="mt-6 text-[2rem] leading-[1.1] font-semibold tracking-[-0.04em] text-ink text-balance sm:text-[2.5rem] xl:text-[3.125rem]"
        >
          {propheticWord.quote}
        </blockquote>

        <a
          href="/nosotros"
          class="group mt-10 inline-flex items-center gap-3 rounded-full bg-mist px-7 py-3.5 text-[0.9375rem] font-semibold text-carbon transition-colors hover:bg-[#e4e3de]"
        >
          Conócenos
          <Icon
            name="lucide:arrow-right"
            width={18}
            height={18}
            class="transition-transform duration-200 group-hover:translate-x-0.5"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </div>
</section>
