---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ArrowButton from './ArrowButton.astro';
import SectionHeading from './SectionHeading.astro';
import { familyLife } from '../data/content';
---

{/*
  Como la referencia: a la izquierda la lista fija de actividades — la activa
  en tinta plena con su pastilla de horarios, el resto atenuado — y a la
  derecha una columna angosta donde van pasando las fotos de cada actividad
  (varias por actividad). La actividad activa es la dueña de las fotos que
  cruzan el centro del viewport. En móvil no hay lista fija: cada grupo de
  fotos lleva su encabezado.
*/}
<section id="vida-en-familia" class="seccion" aria-labelledby="familia-titulo">
  <div class="container-page">
    {/*
      El nombre de la sección va en rótulo pequeño y con una línea debajo, no
      en titular: los titulares grandes son los de las actividades, y con dos
      tamaños grandes seguidos no se distinguía cuál era cuál.

      En escritorio se fija la columna de la izquierda entera —rótulo, bajada
      y lista de actividades, como un solo bloque— mientras las fotos suben
      por su lado, igual que en Compasión social. Al ir todo junto, ni la
      línea ni ninguna franja cruzan por delante de las fotos, y nada se
      encima con nada al soltarse el tramo.
    */}
    <div class="lg:grid lg:grid-cols-[1fr_minmax(0,26rem)] lg:gap-24">
      <div class="lg:sticky lg:top-20 lg:self-start">
        <SectionHeading eyebrow={familyLife.title} id="familia-titulo" />

        <p class="subtitle-lg mt-8 max-w-md">
          {familyLife.description}
        </p>

        <ul class="mt-12 hidden lg:mt-14 lg:flex lg:flex-col lg:gap-4">
        {
          familyLife.activities.map((activity) => (
            <li class="vida-tab">
              <p class="vida-tab-title heading-lg text-ink transition-colors duration-300">
                {activity.title}
              </p>
              {/*
                La pastilla de horarios se abre y se cierra: la rejilla de una
                sola fila pasa de `0fr` a `1fr` y el hueco de dentro se corta.
                Es la única forma de animar el alto sin saber cuánto mide.
              */}
              <div class="vida-tab-pill grid">
                <p class="min-h-0 overflow-hidden">
                  <span class="mt-3 inline-flex flex-wrap items-center gap-x-2.5 gap-y-1 rounded-full bg-mist px-3.5 py-1.5 text-[0.9375rem] text-ink">
                    <span>{activity.when}</span>
                    <Icon
                      name="lucide:clock"
                      width={15}
                      height={15}
                      class="shrink-0 text-ink"
                      aria-hidden="true"
                    />
                    {activity.times.map((time, index) => (
                      <>
                        {index > 0 && <span class="text-ink/50">·</span>}
                        <span>{time}</span>
                      </>
                    ))}
                  </span>
                </p>
              </div>
            </li>
          ))
        }
        </ul>

        {/*
          Pegado a la lista: bajo la última actividad ya cuelgan los 48px que
          cada fila reserva para su pastilla de horarios —invisible salvo en
          la activa, para que la lista no dé saltos al pasar—, así que el
          margen del botón se suma a ese hueco. Con `mt-12` el botón se iba
          casi cien píxeles más abajo del último título.
        */}
        <div class="mt-4 hidden lg:block">
          <ArrowButton label={familyLife.cta.label} href={familyLife.cta.href} variant="accent" size="md" />
        </div>
      </div>

      <div class="mt-20 flex flex-col gap-14 lg:mt-0 lg:gap-6">
        {
          familyLife.activities.map((activity) => (
            <div class="vida-group flex flex-col gap-5 lg:gap-6">
              <div class="lg:hidden">
                <h3 class="heading-md text-ink">{activity.title}</h3>
                <p class="nota mt-2">{activity.when}</p>
                <p class="mt-3 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[0.9375rem] text-ink">
                  <Icon
                    name="lucide:clock"
                    width={16}
                    height={16}
                    class="shrink-0 text-ink"
                    aria-hidden="true"
                  />
                  {activity.times.map((time, index) => (
                    <>
                      {index > 0 && <span class="text-ink/50">·</span>}
                      <span>{time}</span>
                    </>
                  ))}
                </p>
              </div>

              {activity.images.map((image, index) => (
                <Image
                  src={image}
                  alt={index === 0 ? activity.alt : ''}
                  widths={[420, 640, 900]}
                  sizes="(min-width: 64rem) 416px, 90vw"
                  class="w-full rounded-[1.25rem] object-cover"
                  loading="lazy"
                  decoding="async"
                />
              ))}
            </div>
          ))
        }
      </div>
    </div>

    {/* en móvil el botón va al final, después de todos los grupos */}
    <div class="mt-12 lg:hidden">
      <ArrowButton label={familyLife.cta.label} href={familyLife.cta.href} variant="accent" size="md" />
    </div>
  </div>
</section>

<style>
  /* sólo en escritorio: la lista atenúa todo menos la actividad activa */
  @media (min-width: 64rem) {
    .vida-tab-title {
      color: color-mix(in srgb, var(--color-ink) 25%, transparent);
    }

    .vida-tab.is-active .vida-tab-title {
      color: var(--color-ink);
    }

    /*
      Cerrada, la pastilla no ocupa alto: los títulos quedan uno junto a otro
      y solo la actividad activa se abre para enseñar sus horarios. Antes el
      hueco estaba siempre reservado —invisible, pero ahí— y separaba la lista
      casi el doble.
    */
    .vida-tab-pill {
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows 400ms ease,
        opacity 250ms ease;
    }

    .vida-tab.is-active .vida-tab-pill {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    /* las fotos de las actividades no activas se atenúan, como la lista */
    .vida-group :global(img) {
      opacity: 0.4;
      transition: opacity 500ms ease;
    }

    .vida-group.is-active :global(img) {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vida-tab-title,
    .vida-tab-pill {
      transition: none;
    }
  }
</style>

<script>
  const section = document.getElementById('vida-en-familia');

  if (section) {
    const tabs = [...section.querySelectorAll('.vida-tab')];
    const groups = [...section.querySelectorAll('.vida-group')];

    const setActive = (active: number) => {
      tabs.forEach((tab, index) => tab.classList.toggle('is-active', index === active));
      groups.forEach((group, index) => group.classList.toggle('is-active', index === active));
    };

    // manda el grupo de fotos que cruza la franja central del viewport
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(groups.indexOf(entry.target));
        }
      },
      { rootMargin: '-45% 0px -45% 0px' }
    );

    groups.forEach((group) => observer.observe(group));
    setActive(0);
  }
</script>
