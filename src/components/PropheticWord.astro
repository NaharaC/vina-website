---
import { propheticWord, stats } from '../data/content';
---

<section class="hairline py-16 lg:py-24" aria-labelledby="palabra-titulo">
  <div class="container-page">
    <div class="grid gap-14 lg:grid-cols-[5fr_7fr] lg:gap-20">
      <figure>
        <p class="label-mono text-muted">Palabra profética</p>
        <blockquote id="palabra-titulo" class="heading-lg mt-6 text-ink text-balance">
          {propheticWord.quote}
        </blockquote>
        <figcaption class="mt-6 font-serif text-lg italic text-muted">
          {propheticWord.source}
        </figcaption>
      </figure>

      {/* Las cifras como dato grande: número enorme y descripción debajo */}
      <dl class="grid gap-x-10 sm:grid-cols-2">
        {
          stats.map((stat, index) => (
            <div
              class:list={[
                'border-hairline py-8 first:pt-0 sm:py-10',
                index > 0 && 'border-t',
                index === 1 && 'sm:border-t-0 sm:pt-0',
                index >= 2 && 'sm:border-t',
              ]}
            >
              <dt class="display-num text-ink">{stat.value}</dt>
              <dd class="mt-4 max-w-[26ch] text-[0.9375rem] leading-relaxed text-muted">
                {stat.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
