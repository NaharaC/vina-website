---
import { getImage } from 'astro:assets';
import ArrowButton from './ArrowButton.astro';
import { predicaciones } from '../data/content';

/*
  La foto va como fondo y no como <img> porque se queda quieta mientras la
  página se desliza por encima, igual que en la sección de Dar. De paso, al
  anclarse a la ventana el encuadre deja de recortarse por arriba: antes la
  sección era más apaisada que la foto y le cortaba la cabeza al pastor.
*/
const fondo = await getImage({ src: predicaciones.image, width: 2200, format: 'webp' });
---

{/*
  La foto ocupa la sección entera y encima flota la tarjeta blanca con el
  texto, pegada al margen de la izquierda. `svh` y no `vh`: en el móvil la
  barra del navegador entra y sale, y con `vh` la sección daría saltos.
*/}
<section
  id="predicaciones"
  class="foto-fija foto-baja relative isolate flex min-h-[85svh] items-center overflow-clip py-16 lg:py-24"
  style={`--foto: url('${fondo.src}')`}
  aria-labelledby="predicaciones-titulo"
>
  <div class="container-page">
    <div class="max-w-xl rounded-[1.5rem] bg-white px-8 py-10 sm:px-12 sm:py-14 lg:px-14">
      <p class="eyebrow">Predicaciones</p>

      {/* el hueco de la referencia: el rótulo arriba y el bloque abajo */}
      <div class="mt-16 lg:mt-24">
        <h2 id="predicaciones-titulo" class="heading-lg text-ink">{predicaciones.title}</h2>
        <p class="subtitle-lg mt-4 max-w-md">{predicaciones.description}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          {
            predicaciones.actions.map(
              (action) =>
                action.href && (
                  <ArrowButton
                    label={action.label}
                    href={action.href}
                    variant="accent"
                    size="md"
                    external={action.external}
                  />
                )
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
