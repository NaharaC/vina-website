---
import { Icon } from 'astro-icon/components';
import { testimonials, testimonialsIntro } from '../data/content';

const hasCarousel = testimonials.length > 1;
---

{/*
  La sección entra completa en pantalla: el bloque de título y el video se
  reparten el alto disponible. El video corre solo y en silencio; el botón de
  sonido es la única forma de que empiece a oírse (los navegadores no dejan
  arrancar con audio sin que alguien lo pida).
*/}
{/*
  `tramo-claro` saca esta sección del negro del tramo: fondo blanco y los
  colores de siempre. El hueco de la foto sigue igual, porque va aparte.
*/}
<section
  class="tramo-claro flex min-h-svh flex-col justify-center py-12 lg:py-16"
  aria-labelledby="testimonios-titulo"
>
  <div class="container-page">
    <div class="text-center">
      <h2 id="testimonios-titulo" class="heading-lg text-ink">{testimonialsIntro.title}</h2>
      <p class="subtitle-lg mx-auto mt-3 max-w-2xl">
        {testimonialsIntro.verse}<br />
        {testimonialsIntro.reference}
      </p>
    </div>

    <div
      id="testimonios-track"
      aria-roledescription={hasCarousel ? 'carrusel' : undefined}
      aria-label={hasCarousel ? 'Testimonios' : undefined}
      tabindex={hasCarousel ? 0 : undefined}
      class:list={[
        'no-scrollbar mt-8 flex gap-6 overflow-x-auto scroll-smooth lg:mt-10',
        hasCarousel && 'snap-x snap-mandatory',
      ]}
    >
      {
        testimonials.map((testimonial, index) => (
          <figure class="mx-auto aspect-video max-h-[58svh] w-full max-w-4xl shrink-0 snap-center overflow-hidden rounded-[1.75rem] bg-carbon lg:rounded-[2rem]">
            <div class="relative size-full">
              <video
                class="testimonio-video size-full object-cover"
                src={testimonial.video}
                poster={testimonial.poster}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={testimonial.alt}
              />

              {/* el degradado solo cubre la franja donde va el nombre */}
              <div
                class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/70 to-transparent"
                aria-hidden="true"
              />

              <figcaption class="absolute bottom-5 left-5 text-sm font-semibold text-white sm:bottom-7 sm:left-7 sm:text-base">
                {testimonial.name}
              </figcaption>

              <button
                type="button"
                class="testimonio-sonido absolute right-5 bottom-5 inline-flex items-center gap-2.5 rounded-full bg-white/10 px-5 py-3 text-sm font-semibold text-white backdrop-blur-lg backdrop-saturate-150 transition-colors hover:bg-white/20 sm:right-7 sm:bottom-7"
                data-indice={index}
                aria-pressed="false"
              >
                <Icon
                  name="lucide:volume-x"
                  width={18}
                  height={18}
                  class="icono-silencio"
                  aria-hidden="true"
                />
                <Icon
                  name="lucide:volume-2"
                  width={18}
                  height={18}
                  class="icono-sonido hidden"
                  aria-hidden="true"
                />
                <span class="etiqueta-sonido">Activar sonido</span>
              </button>
            </div>
          </figure>
        ))
      }
    </div>

    {
      hasCarousel && (
        <div class="mt-8 flex items-center justify-center gap-3">
          <button
            type="button"
            data-carousel-prev
            class="grid size-11 place-items-center rounded-xl bg-white text-carbon shadow-sm transition-colors hover:bg-white/70 disabled:cursor-default disabled:opacity-40 disabled:hover:bg-white"
          >
            <span class="sr-only">Testimonio anterior</span>
            <Icon name="lucide:arrow-left" width={18} height={18} aria-hidden="true" />
          </button>
          <button
            type="button"
            data-carousel-next
            class="grid size-11 place-items-center rounded-xl bg-white text-carbon shadow-sm transition-colors hover:bg-white/70 disabled:cursor-default disabled:opacity-40 disabled:hover:bg-white"
          >
            <span class="sr-only">Testimonio siguiente</span>
            <Icon name="lucide:arrow-right" width={18} height={18} aria-hidden="true" />
          </button>
        </div>
      )
    }
  </div>
</section>

<script>
  /* --- Sonido de cada testimonio ------------------------------------------- */

  for (const boton of document.querySelectorAll<HTMLButtonElement>('.testimonio-sonido')) {
    const figura = boton.closest('figure');
    const video = figura?.querySelector('video');
    if (!video) continue;

    boton.addEventListener('click', () => {
      const conSonido = video.muted;
      video.muted = !conSonido;

      // al activar el sonido conviene partir desde el principio
      if (conSonido) {
        video.currentTime = 0;
        video.play();
      }

      boton.setAttribute('aria-pressed', String(conSonido));
      boton.querySelector('.icono-silencio')?.classList.toggle('hidden', conSonido);
      boton.querySelector('.icono-sonido')?.classList.toggle('hidden', !conSonido);
      const etiqueta = boton.querySelector('.etiqueta-sonido');
      if (etiqueta) etiqueta.textContent = conSonido ? 'Silenciar' : 'Activar sonido';
    });
  }

  /* --- Carrusel (solo con más de un testimonio) ---------------------------- */

  const track = document.getElementById('testimonios-track');
  const prev = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-carousel-next]');

  if (track && prev && next) {
    const step = () => track.clientWidth + 24; // ancho visible + gap

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));

    // Apagar la flecha cuando ya no queda nada hacia ese lado.
    const syncArrows = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };

    track.addEventListener('scroll', syncArrows, { passive: true });
    window.addEventListener('resize', syncArrows);
    syncArrows();
  }
</script>
