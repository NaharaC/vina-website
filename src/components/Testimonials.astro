---
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';
import { testimonials, testimonialsIntro } from '../data/content';
---

{/*
  El versículo, con el mismo reparto que la palabra profética: mucho aire a la
  izquierda y el texto en grande a la derecha. Es una sección como cualquier
  otra y pasa con el scroll; antes se quedaba pegada al centro de la ventana
  durante un tramo de más de una pantalla, y esa parada de más ataba el
  versículo a los testimonios como si fueran una sola pieza.
*/}
<section class="seccion seccion-holgada" aria-labelledby="versiculo-titulo">
  <div class="container-page">
    <div class="md:grid md:grid-cols-[1fr_1.1fr] md:gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="md:col-start-2">
        <p class="eyebrow">{testimonialsIntro.reference}</p>

        <blockquote
          id="versiculo-titulo"
          class="heading-xl mt-6 text-ink text-balance"
        >
          {testimonialsIntro.verse}
        </blockquote>
      </div>
    </div>
  </div>
</section>

{/*
  Los testimonios cierran el bloque: van sin aire arriba, pegados al
  versículo. Carrusel: el testimonio que está al centro se ve a color y los de
  al lado asoman por los bordes, apagados, para que se note que hay más. El
  video corre solo y en silencio; el botón de sonido es la única forma de que
  empiece a oírse (los navegadores no dejan arrancar con audio sin que alguien
  lo pida).
*/}
<section class="seccion seccion-fin" aria-labelledby="testimonios-titulo">
  <div class="container-page">
    <SectionHeading eyebrow={testimonialsIntro.title} id="testimonios-titulo">
      <a
        href={testimonialsIntro.action.href}
        target={testimonialsIntro.action.external ? '_blank' : undefined}
        rel={testimonialsIntro.action.external ? 'noopener noreferrer' : undefined}
        class="group inline-flex items-center gap-2.5 rounded-full bg-white px-5 py-2.5 text-[1rem] font-semibold text-carbon transition-colors hover:bg-white/70"
      >
        {testimonialsIntro.action.label}
        {testimonialsIntro.action.external && (
          <span class="sr-only">(se abre en una ventana nueva)</span>
        )}
        <Icon
          name="lucide:arrow-right"
          width={16}
          height={16}
          class="transition-transform duration-200 group-hover:translate-x-0.5"
          aria-hidden="true"
        />
      </a>
    </SectionHeading>
  </div>

  {/* a sangre: los testimonios de al lado asoman por los bordes */}
  <div class="carrusel relative mt-10 lg:mt-12">
    <div
      id="testimonios-track"
      class="pista no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-[6vw] sm:gap-6 lg:px-[19vw]"
      aria-roledescription="carrusel"
      aria-label="Testimonios"
      tabindex="0"
    >
      {
        testimonials.map((testimonial, index) => (
          <figure
            class="diapositiva w-[88vw] shrink-0 snap-center sm:w-[70vw] lg:w-[62vw]"
            data-activo="false"
            data-inicial={testimonial.inicial ? 'true' : undefined}
          >
            <div class="relative aspect-video overflow-hidden rounded-[1.5rem] bg-carbon lg:rounded-[1.75rem]">
              <video
                class="testimonio-video size-full object-cover"
                src={testimonial.video}
                poster={testimonial.poster}
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={testimonial.alt}
              />

              {/* el degradado solo cubre la franja donde va el nombre */}
              <div
                class="pointer-events-none absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-black/75 to-transparent"
                aria-hidden="true"
              />

              <figcaption class="absolute bottom-5 left-5 text-white sm:bottom-7 sm:left-7">
                <p class="heading-sm">{testimonial.name}</p>
                {testimonial.summary && (
                  <p class="nota mt-1 !text-white/80">{testimonial.summary}</p>
                )}
              </figcaption>

              <button
                type="button"
                class="testimonio-sonido absolute right-5 bottom-5 inline-flex items-center gap-2.5 rounded-full bg-white/10 px-5 py-3 text-[0.9375rem] font-semibold text-white backdrop-blur-lg backdrop-saturate-150 transition-colors hover:bg-white/20 sm:right-7 sm:bottom-7"
                data-indice={index}
                aria-pressed="false"
              >
                <Icon
                  name="lucide:volume-x"
                  width={18}
                  height={18}
                  class="icono-silencio"
                  aria-hidden="true"
                />
                <Icon
                  name="lucide:volume-2"
                  width={18}
                  height={18}
                  class="icono-sonido hidden"
                  aria-hidden="true"
                />
                <span class="etiqueta-sonido">Activar sonido</span>
              </button>
            </div>
          </figure>
        ))
      }
    </div>

    {
      testimonials.length > 1 && (
        <>
          <button
            type="button"
            data-carousel-prev
            class="flecha absolute top-1/2 left-3 grid size-11 -translate-y-1/2 place-items-center rounded-full bg-ink/85 text-white backdrop-blur-sm transition-opacity hover:bg-ink sm:left-6 lg:size-12"
          >
            <span class="sr-only">Testimonio anterior</span>
            <Icon name="lucide:chevron-left" width={22} height={22} aria-hidden="true" />
          </button>

          <button
            type="button"
            data-carousel-next
            class="flecha absolute top-1/2 right-3 grid size-11 -translate-y-1/2 place-items-center rounded-full bg-ink/85 text-white backdrop-blur-sm transition-opacity hover:bg-ink sm:right-6 lg:size-12"
          >
            <span class="sr-only">Testimonio siguiente</span>
            <Icon name="lucide:chevron-right" width={22} height={22} aria-hidden="true" />
          </button>
        </>
      )
    }
  </div>
</section>

<style>
  /* los de al lado quedan apagados: se ven, pero no compiten con el del centro */
  .diapositiva {
    opacity: 0.35;
    filter: grayscale(1);
    transition:
      opacity 400ms ease,
      filter 400ms ease;
  }

  .diapositiva[data-activo='true'] {
    opacity: 1;
    filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .pista {
      scroll-behavior: auto;
    }

    .diapositiva {
      transition: none;
    }
  }
</style>

<script>
  /* --- Sonido de cada testimonio ------------------------------------------- */

  for (const boton of document.querySelectorAll<HTMLButtonElement>('.testimonio-sonido')) {
    const figura = boton.closest('figure');
    const video = figura?.querySelector('video');
    if (!video) continue;

    boton.addEventListener('click', () => {
      const conSonido = video.muted;

      // solo puede sonar uno: al encender este, se callan los demás
      if (conSonido) {
        for (const otro of document.querySelectorAll<HTMLVideoElement>('.testimonio-video')) {
          if (otro !== video) otro.muted = true;
        }
        for (const otroBoton of document.querySelectorAll<HTMLButtonElement>('.testimonio-sonido')) {
          if (otroBoton === boton) continue;
          otroBoton.setAttribute('aria-pressed', 'false');
          otroBoton.querySelector('.icono-silencio')?.classList.remove('hidden');
          otroBoton.querySelector('.icono-sonido')?.classList.add('hidden');
          const etiquetaOtro = otroBoton.querySelector('.etiqueta-sonido');
          if (etiquetaOtro) etiquetaOtro.textContent = 'Activar sonido';
        }
      }

      video.muted = !conSonido;

      // al activar el sonido conviene partir desde el principio
      if (conSonido) {
        video.currentTime = 0;
        video.play();
      }

      boton.setAttribute('aria-pressed', String(conSonido));
      boton.querySelector('.icono-silencio')?.classList.toggle('hidden', conSonido);
      boton.querySelector('.icono-sonido')?.classList.toggle('hidden', !conSonido);
      const etiqueta = boton.querySelector('.etiqueta-sonido');
      if (etiqueta) etiqueta.textContent = conSonido ? 'Silenciar' : 'Activar sonido';
    });
  }

  /* --- Carrusel ------------------------------------------------------------ */

  const pista = document.getElementById('testimonios-track');
  const reales = [...(pista?.querySelectorAll<HTMLElement>('.diapositiva') ?? [])];
  const anterior = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const siguiente = document.querySelector<HTMLButtonElement>('[data-carousel-next]');

  if (pista && reales.length > 1 && anterior && siguiente) {
    /*
      Para que la cinta no tenga principio ni fin se clona la última al
      principio y la primera al final. Al llegar a un clon se salta sin
      animación a su original, que está a un juego de distancia: el salto no
      se ve porque las dos muestran lo mismo.

      Los clones van con el póster y no con el video: son de paso, y cargar
      dos videos más para verlos un instante no compensa.
    */
    const clonar = (diapositiva: HTMLElement) => {
      const clon = diapositiva.cloneNode(true) as HTMLElement;
      clon.dataset.clon = 'true';
      clon.removeAttribute('data-inicial');
      clon.setAttribute('aria-hidden', 'true');
      clon.querySelector('.testimonio-sonido')?.remove();

      const video = clon.querySelector('video');
      if (video) {
        const poster = document.createElement('img');
        poster.src = video.getAttribute('poster') ?? '';
        poster.alt = '';
        poster.className = video.className;
        video.replaceWith(poster);
      }

      return clon;
    };

    pista.prepend(clonar(reales[reales.length - 1]));
    pista.append(clonar(reales[0]));

    const todas = [...pista.querySelectorAll<HTMLElement>('.diapositiva')];

    /*
      El del centro se elige por geometría y no por el índice del scroll: con
      las diapositivas asomando por los bordes, «cuánto se ha desplazado» no
      dice cuál se está mirando.
    */
    const cualEstaAlCentro = () => {
      const centro = pista.getBoundingClientRect().left + pista.clientWidth / 2;
      let elegida = 0;
      let menor = Infinity;

      todas.forEach((diapositiva, i) => {
        const caja = diapositiva.getBoundingClientRect();
        const distancia = Math.abs(caja.left + caja.width / 2 - centro);
        if (distancia < menor) {
          menor = distancia;
          elegida = i;
        }
      });

      return elegida;
    };

    const marcar = () => {
      const centro = cualEstaAlCentro();

      todas.forEach((diapositiva, i) => {
        const activa = i === centro;
        diapositiva.dataset.activo = String(activa);

        /*
          Solo corre el del centro: tres videos a la vez gastan batería y
          ancho de banda para nada, y los de al lado se ven apagados igual.
        */
        const video = diapositiva.querySelector('video');
        if (!video) return;
        if (activa) {
          video.play().catch(() => {});
        } else {
          video.pause();
          video.muted = true;
        }
      });

      return centro;
    };

    const centrar = (diapositiva: HTMLElement, suave = true) => {
      const destino =
        diapositiva.offsetLeft - (pista.clientWidth - diapositiva.offsetWidth) / 2;
      // 'instant' y no 'auto': 'auto' quiere decir «lo que diga el CSS», y la
      // pista lleva scroll-behavior: smooth, así que el salto del clon al
      // original se animaba y se veía rebobinar hasta el principio
      pista.scrollTo({ left: destino, behavior: suave ? 'smooth' : 'instant' });
    };

    /** Del clon al original: mismo sitio en la cinta, sin que se note. */
    const saltarSiEsClon = () => {
      const centro = cualEstaAlCentro();
      if (!todas[centro]?.dataset.clon) return;

      // el clon del final es el primero de todos; el del principio, el último
      const original = centro === 0 ? todas[todas.length - 2] : todas[1];
      centrar(original, false);
      marcar();
    };

    const irA = (paso: number) => {
      const centro = cualEstaAlCentro();
      const destino = todas[centro + paso];
      if (destino) centrar(destino);
    };

    anterior.addEventListener('click', () => irA(-1));
    siguiente.addEventListener('click', () => irA(1));

    let pedido = 0;
    let quieto = 0;
    pista.addEventListener(
      'scroll',
      () => {
        if (!pedido) {
          pedido = requestAnimationFrame(() => {
            pedido = 0;
            marcar();
          });
        }

        // el salto espera a que el desplazamiento pare, si no se pelea con él
        clearTimeout(quieto);
        quieto = window.setTimeout(saltarSiEsClon, 140);
      },
      { passive: true }
    );

    window.addEventListener('resize', marcar);

    // arranca centrada en la que lo pida, o en la primera
    const inicial = todas.find((d) => d.dataset.inicial === 'true') ?? todas[1];
    centrar(inicial, false);
    marcar();
  }
</script>
