---
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';
import { testimonials, testimonialsIntro } from '../data/content';
---

{/*
  Carrusel: el testimonio que está al centro se ve a color y los de al lado
  asoman por los bordes, apagados, para que se note que hay más. El video
  corre solo y en silencio; el botón de sonido es la única forma de que
  empiece a oírse (los navegadores no dejan arrancar con audio sin que
  alguien lo pida).
*/}
<section class="seccion" aria-labelledby="testimonios-titulo">
  <div class="container-page">
    <SectionHeading eyebrow={testimonialsIntro.title} id="testimonios-titulo" />

    <div class="mt-12 md:flex md:items-end md:justify-between md:gap-12 lg:mt-16">
      <blockquote class="heading-lg max-w-lg text-ink text-balance">
        {testimonialsIntro.verse}
        <footer class="subtitle mt-4">{testimonialsIntro.reference}</footer>
      </blockquote>

      <a
        href={testimonialsIntro.action.href}
        target={testimonialsIntro.action.external ? '_blank' : undefined}
        rel={testimonialsIntro.action.external ? 'noopener noreferrer' : undefined}
        class="group mt-8 inline-flex shrink-0 items-center gap-3 rounded-full bg-mist px-7 py-3.5 text-[0.9375rem] font-semibold text-carbon transition-colors hover:bg-[#e4e3de] md:mt-0"
      >
        {testimonialsIntro.action.label}
        {testimonialsIntro.action.external && (
          <span class="sr-only">(se abre en una ventana nueva)</span>
        )}
        <Icon
          name="lucide:arrow-right"
          width={18}
          height={18}
          class="transition-transform duration-200 group-hover:translate-x-0.5"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>

  {/* a sangre: los testimonios de al lado asoman por los bordes */}
  <div class="carrusel relative mt-12 lg:mt-16">
    <div
      id="testimonios-track"
      class="pista no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-[6vw] sm:gap-6 lg:px-[19vw]"
      aria-roledescription="carrusel"
      aria-label="Testimonios"
      tabindex="0"
    >
      {
        testimonials.map((testimonial, index) => (
          <figure
            class="diapositiva w-[88vw] shrink-0 snap-center sm:w-[70vw] lg:w-[62vw]"
            data-activo={index === 0 ? 'true' : 'false'}
          >
            <div class="relative aspect-video overflow-hidden rounded-[1.5rem] bg-carbon lg:rounded-[1.75rem]">
              <video
                class="testimonio-video size-full object-cover"
                src={testimonial.video}
                poster={testimonial.poster}
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={testimonial.alt}
              />

              {/* el degradado solo cubre la franja donde va el nombre */}
              <div
                class="pointer-events-none absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-black/75 to-transparent"
                aria-hidden="true"
              />

              <figcaption class="absolute bottom-5 left-5 text-white sm:bottom-7 sm:left-7">
                <p class="text-lg font-semibold tracking-[-0.02em] sm:text-xl">{testimonial.name}</p>
                {testimonial.summary && (
                  <p class="mt-0.5 text-sm text-white/80 sm:text-[0.9375rem]">
                    {testimonial.summary}
                  </p>
                )}
              </figcaption>

              <button
                type="button"
                class="testimonio-sonido absolute right-5 bottom-5 inline-flex items-center gap-2.5 rounded-full bg-white/10 px-5 py-3 text-sm font-semibold text-white backdrop-blur-lg backdrop-saturate-150 transition-colors hover:bg-white/20 sm:right-7 sm:bottom-7"
                data-indice={index}
                aria-pressed="false"
              >
                <Icon
                  name="lucide:volume-x"
                  width={18}
                  height={18}
                  class="icono-silencio"
                  aria-hidden="true"
                />
                <Icon
                  name="lucide:volume-2"
                  width={18}
                  height={18}
                  class="icono-sonido hidden"
                  aria-hidden="true"
                />
                <span class="etiqueta-sonido">Activar sonido</span>
              </button>
            </div>
          </figure>
        ))
      }
    </div>

    {
      testimonials.length > 1 && (
        <>
          <button
            type="button"
            data-carousel-prev
            class="flecha absolute top-1/2 left-3 grid size-11 -translate-y-1/2 place-items-center rounded-full bg-ink/85 text-white backdrop-blur-sm transition-opacity hover:bg-ink disabled:pointer-events-none disabled:opacity-0 sm:left-6 lg:size-12"
          >
            <span class="sr-only">Testimonio anterior</span>
            <Icon name="lucide:chevron-left" width={22} height={22} aria-hidden="true" />
          </button>

          <button
            type="button"
            data-carousel-next
            class="flecha absolute top-1/2 right-3 grid size-11 -translate-y-1/2 place-items-center rounded-full bg-ink/85 text-white backdrop-blur-sm transition-opacity hover:bg-ink disabled:pointer-events-none disabled:opacity-0 sm:right-6 lg:size-12"
          >
            <span class="sr-only">Testimonio siguiente</span>
            <Icon name="lucide:chevron-right" width={22} height={22} aria-hidden="true" />
          </button>
        </>
      )
    }
  </div>
</section>

<style>
  /* los de al lado quedan apagados: se ven, pero no compiten con el del centro */
  .diapositiva {
    opacity: 0.35;
    filter: grayscale(1);
    transition:
      opacity 400ms ease,
      filter 400ms ease;
  }

  .diapositiva[data-activo='true'] {
    opacity: 1;
    filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .pista {
      scroll-behavior: auto;
    }

    .diapositiva {
      transition: none;
    }
  }
</style>

<script>
  /* --- Sonido de cada testimonio ------------------------------------------- */

  for (const boton of document.querySelectorAll<HTMLButtonElement>('.testimonio-sonido')) {
    const figura = boton.closest('figure');
    const video = figura?.querySelector('video');
    if (!video) continue;

    boton.addEventListener('click', () => {
      const conSonido = video.muted;

      // solo puede sonar uno: al encender este, se callan los demás
      if (conSonido) {
        for (const otro of document.querySelectorAll<HTMLVideoElement>('.testimonio-video')) {
          if (otro !== video) otro.muted = true;
        }
        for (const otroBoton of document.querySelectorAll<HTMLButtonElement>('.testimonio-sonido')) {
          if (otroBoton === boton) continue;
          otroBoton.setAttribute('aria-pressed', 'false');
          otroBoton.querySelector('.icono-silencio')?.classList.remove('hidden');
          otroBoton.querySelector('.icono-sonido')?.classList.add('hidden');
          const etiquetaOtro = otroBoton.querySelector('.etiqueta-sonido');
          if (etiquetaOtro) etiquetaOtro.textContent = 'Activar sonido';
        }
      }

      video.muted = !conSonido;

      // al activar el sonido conviene partir desde el principio
      if (conSonido) {
        video.currentTime = 0;
        video.play();
      }

      boton.setAttribute('aria-pressed', String(conSonido));
      boton.querySelector('.icono-silencio')?.classList.toggle('hidden', conSonido);
      boton.querySelector('.icono-sonido')?.classList.toggle('hidden', !conSonido);
      const etiqueta = boton.querySelector('.etiqueta-sonido');
      if (etiqueta) etiqueta.textContent = conSonido ? 'Silenciar' : 'Activar sonido';
    });
  }

  /* --- Carrusel ------------------------------------------------------------ */

  const pista = document.getElementById('testimonios-track');
  const diapositivas = [...(pista?.querySelectorAll<HTMLElement>('.diapositiva') ?? [])];
  const anterior = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const siguiente = document.querySelector<HTMLButtonElement>('[data-carousel-next]');

  if (pista && diapositivas.length > 1 && anterior && siguiente) {
    /*
      El del centro se elige por geometría y no por el índice del scroll: con
      las diapositivas asomando por los bordes, «cuánto se ha desplazado» no
      dice cuál se está mirando.
    */
    const alCentro = () => {
      const centro = pista.getBoundingClientRect().left + pista.clientWidth / 2;
      let elegida = 0;
      let menor = Infinity;

      diapositivas.forEach((diapositiva, i) => {
        const caja = diapositiva.getBoundingClientRect();
        const distancia = Math.abs(caja.left + caja.width / 2 - centro);
        if (distancia < menor) {
          menor = distancia;
          elegida = i;
        }
      });

      diapositivas.forEach((diapositiva, i) => {
        const activa = i === elegida;
        diapositiva.dataset.activo = String(activa);

        /*
          Solo corre el del centro: tres videos a la vez gastan batería y
          ancho de banda para nada, y los de al lado se ven apagados igual.
        */
        const video = diapositiva.querySelector('video');
        if (!video) return;
        if (activa) {
          video.play().catch(() => {});
        } else {
          video.pause();
          video.muted = true;
        }
      });

      // sin nada hacia ese lado, la flecha se apaga
      const max = pista.scrollWidth - pista.clientWidth;
      anterior.disabled = pista.scrollLeft <= 1;
      siguiente.disabled = pista.scrollLeft >= max - 1;
    };

    const irA = (paso: number) => {
      const actual = diapositivas.findIndex((d) => d.dataset.activo === 'true');
      const destino = diapositivas[Math.min(diapositivas.length - 1, Math.max(0, actual + paso))];
      destino?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    };

    anterior.addEventListener('click', () => irA(-1));
    siguiente.addEventListener('click', () => irA(1));

    let pedido = 0;
    pista.addEventListener(
      'scroll',
      () => {
        if (pedido) return;
        pedido = requestAnimationFrame(() => {
          pedido = 0;
          alCentro();
        });
      },
      { passive: true }
    );

    window.addEventListener('resize', alCentro);
    alCentro();
  }
</script>
