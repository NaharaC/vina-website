---
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';
import { testimonials, testimonialsIntro } from '../data/content';

const hasCarousel = testimonials.length > 1;
---

{/*
  Texto a la izquierda y video a la derecha, como el resto de las secciones a
  dos columnas. El video corre solo y en silencio; el botón de sonido es la
  única forma de que empiece a oírse (los navegadores no dejan arrancar con
  audio sin que alguien lo pida).

  `tramo-claro` saca la sección del negro del tramo que la envuelve: fondo
  blanco y los colores de siempre.
*/}
<section class="tramo-claro seccion" aria-labelledby="testimonios-titulo">
  <div class="container-page">
    <SectionHeading eyebrow={testimonialsIntro.title} id="testimonios-titulo" />

    <div class="mt-12 grid items-center gap-10 md:grid-cols-2 md:gap-12 lg:mt-16 lg:gap-16">
      <div>
        {/* el versículo es lo que se lee grande: el rótulo ya dice la sección */}
        <blockquote class="heading-lg max-w-md text-ink text-balance">
          {testimonialsIntro.verse}
        </blockquote>

        <p class="subtitle mt-4">{testimonialsIntro.reference}</p>

        <a
          href={testimonialsIntro.action.href}
          target={testimonialsIntro.action.external ? '_blank' : undefined}
          rel={testimonialsIntro.action.external ? 'noopener noreferrer' : undefined}
          class="group mt-8 inline-flex items-center gap-3 rounded-full bg-mist px-7 py-3.5 text-[0.9375rem] font-semibold text-carbon transition-colors hover:bg-[#e4e3de]"
        >
          {testimonialsIntro.action.label}
          {testimonialsIntro.action.external && (
            <span class="sr-only">(se abre en una ventana nueva)</span>
          )}
          <Icon
            name="lucide:arrow-right"
            width={18}
            height={18}
            class="transition-transform duration-200 group-hover:translate-x-0.5"
            aria-hidden="true"
          />
        </a>
      </div>

      <div>
        <div
          id="testimonios-track"
          aria-roledescription={hasCarousel ? 'carrusel' : undefined}
          aria-label={hasCarousel ? 'Testimonios' : undefined}
          tabindex={hasCarousel ? 0 : undefined}
          class:list={[
            'no-scrollbar flex gap-6 overflow-x-auto scroll-smooth',
            hasCarousel && 'snap-x snap-mandatory',
          ]}
        >
          {
            testimonials.map((testimonial, index) => (
              <figure class="aspect-video w-full shrink-0 snap-center overflow-hidden rounded-[1.5rem] bg-carbon lg:rounded-[1.75rem]">
                <div class="relative size-full">
                  <video
                    class="testimonio-video size-full object-cover"
                    src={testimonial.video}
                    poster={testimonial.poster}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    aria-label={testimonial.alt}
                  />

                  {/* el degradado solo cubre la franja donde va el nombre */}
                  <div
                    class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/70 to-transparent"
                    aria-hidden="true"
                  />

                  <figcaption class="absolute bottom-5 left-5 text-sm font-semibold text-white sm:bottom-7 sm:left-7 sm:text-base">
                    {testimonial.name}
                  </figcaption>

                  <button
                    type="button"
                    class="testimonio-sonido absolute right-5 bottom-5 inline-flex items-center gap-2.5 rounded-full bg-white/10 px-5 py-3 text-sm font-semibold text-white backdrop-blur-lg backdrop-saturate-150 transition-colors hover:bg-white/20 sm:right-7 sm:bottom-7"
                    data-indice={index}
                    aria-pressed="false"
                  >
                    <Icon
                      name="lucide:volume-x"
                      width={18}
                      height={18}
                      class="icono-silencio"
                      aria-hidden="true"
                    />
                    <Icon
                      name="lucide:volume-2"
                      width={18}
                      height={18}
                      class="icono-sonido hidden"
                      aria-hidden="true"
                    />
                    <span class="etiqueta-sonido">Activar sonido</span>
                  </button>
                </div>
              </figure>
            ))
          }
        </div>

        {
          hasCarousel && (
            <div class="mt-6 flex items-center gap-3">
              <button
                type="button"
                data-carousel-prev
                class="grid size-11 place-items-center rounded-xl bg-mist text-carbon transition-colors hover:bg-[#e4e3de] disabled:cursor-default disabled:opacity-40 disabled:hover:bg-mist"
              >
                <span class="sr-only">Testimonio anterior</span>
                <Icon name="lucide:arrow-left" width={18} height={18} aria-hidden="true" />
              </button>
              <button
                type="button"
                data-carousel-next
                class="grid size-11 place-items-center rounded-xl bg-mist text-carbon transition-colors hover:bg-[#e4e3de] disabled:cursor-default disabled:opacity-40 disabled:hover:bg-mist"
              >
                <span class="sr-only">Testimonio siguiente</span>
                <Icon name="lucide:arrow-right" width={18} height={18} aria-hidden="true" />
              </button>
            </div>
          )
        }

      </div>
    </div>
  </div>
</section>

<script>
  /* --- Sonido de cada testimonio ------------------------------------------- */

  for (const boton of document.querySelectorAll<HTMLButtonElement>('.testimonio-sonido')) {
    const figura = boton.closest('figure');
    const video = figura?.querySelector('video');
    if (!video) continue;

    boton.addEventListener('click', () => {
      const conSonido = video.muted;
      video.muted = !conSonido;

      // al activar el sonido conviene partir desde el principio
      if (conSonido) {
        video.currentTime = 0;
        video.play();
      }

      boton.setAttribute('aria-pressed', String(conSonido));
      boton.querySelector('.icono-silencio')?.classList.toggle('hidden', conSonido);
      boton.querySelector('.icono-sonido')?.classList.toggle('hidden', !conSonido);
      const etiqueta = boton.querySelector('.etiqueta-sonido');
      if (etiqueta) etiqueta.textContent = conSonido ? 'Silenciar' : 'Activar sonido';
    });
  }

  /* --- Carrusel (solo con más de un testimonio) ---------------------------- */

  const track = document.getElementById('testimonios-track');
  const prev = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-carousel-next]');

  if (track && prev && next) {
    const step = () => track.clientWidth + 24; // ancho visible + gap

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));

    // Apagar la flecha cuando ya no queda nada hacia ese lado.
    const syncArrows = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };

    track.addEventListener('scroll', syncArrows, { passive: true });
    window.addEventListener('resize', syncArrows);
    syncArrows();
  }
</script>
