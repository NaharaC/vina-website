---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { testimonials, testimonialsIntro } from '../data/content';

const hasCarousel = testimonials.length > 1;
---

<section class="bg-mist py-12 lg:py-16" aria-labelledby="testimonios-titulo">
  <div class="container-page">
    <div class="text-center">
      <h2 id="testimonios-titulo" class="heading-lg text-ink">{testimonialsIntro.title}</h2>
      <p class="mx-auto mt-2 max-w-2xl font-serif text-lg italic text-muted sm:text-xl">
        {testimonialsIntro.verse}<br />
        {testimonialsIntro.reference}
      </p>
    </div>

    <div
      id="testimonios-track"
      aria-roledescription={hasCarousel ? 'carrusel' : undefined}
      aria-label={hasCarousel ? 'Testimonios' : undefined}
      tabindex={hasCarousel ? 0 : undefined}
      class:list={[
        'no-scrollbar mt-9 flex gap-6 overflow-x-auto scroll-smooth lg:mt-11',
        hasCarousel && 'snap-x snap-mandatory',
      ]}
    >
      {
        testimonials.map((testimonial) => (
          <figure
            class="relative w-full shrink-0 snap-center overflow-hidden rounded-[1.75rem] bg-carbon lg:rounded-[2rem]"
          >
            <Image
              src={testimonial.poster}
              alt={testimonial.posterAlt}
              widths={[640, 960, 1280]}
              sizes="(min-width: 64rem) 1248px, 100vw"
              class="aspect-[16/9] w-full object-cover lg:aspect-[2/1]"
              loading="lazy"
              decoding="async"
            />
            <div
              class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/40 to-transparent"
              aria-hidden="true"
            />

            <div class="absolute inset-0 flex flex-col justify-center gap-4 p-6 sm:p-10 lg:max-w-[62%] lg:p-12">
              <div class="flex items-center gap-4">
                <Image
                  src={testimonial.thumb}
                  alt={testimonial.thumbAlt}
                  width={112}
                  height={80}
                  densities={[1, 2]}
                  class="hidden h-20 w-28 rounded-xl object-cover sm:block"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="text-sm leading-tight font-semibold text-white sm:text-[0.9375rem]">
                  {testimonial.name}
                </figcaption>
              </div>

              <blockquote
                class="font-serif text-lg leading-snug italic text-white text-balance sm:text-2xl lg:text-[1.75rem]"
              >
                {testimonial.quote}
              </blockquote>
            </div>
          </figure>
        ))
      }
    </div>

    {
      hasCarousel && (
        <div class="mt-8 flex items-center justify-center gap-3">
          <button
            type="button"
            data-carousel-prev
            class="grid size-11 place-items-center rounded-xl bg-white text-carbon shadow-sm transition-colors hover:bg-white/70 disabled:cursor-default disabled:opacity-40 disabled:hover:bg-white"
          >
            <span class="sr-only">Testimonio anterior</span>
            <Icon name="lucide:arrow-left" width={18} height={18} aria-hidden="true" />
          </button>
          <button
            type="button"
            data-carousel-next
            class="grid size-11 place-items-center rounded-xl bg-white text-carbon shadow-sm transition-colors hover:bg-white/70 disabled:cursor-default disabled:opacity-40 disabled:hover:bg-white"
          >
            <span class="sr-only">Testimonio siguiente</span>
            <Icon name="lucide:arrow-right" width={18} height={18} aria-hidden="true" />
          </button>
        </div>
      )
    }
  </div>
</section>

<script>
  const track = document.getElementById('testimonios-track');
  const prev = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-carousel-next]');

  if (track && prev && next) {
    const step = () => track.clientWidth + 24; // ancho visible + gap

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));

    // Apagar la flecha cuando ya no queda nada hacia ese lado.
    const syncArrows = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };

    track.addEventListener('scroll', syncArrows, { passive: true });
    window.addEventListener('resize', syncArrows);
    syncArrows();
  }
</script>
