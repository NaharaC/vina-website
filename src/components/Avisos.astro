---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ArrowButton from './ArrowButton.astro';
import SectionHeading from './SectionHeading.astro';
import { avisos, avisosIntro } from '../data/content';
---

{/*
  Los avisos van pasando de uno en uno: el del centro se ve a color y los de
  al lado asoman por los bordes, apagados, para que se note que hay más. Es
  el mismo carrusel de los testimonios; aquí en vez de video hay una foto con
  el texto encima.
*/}
<section id="avisos" class="seccion" aria-labelledby="avisos-titulo">
  <div class="container-page">
    <SectionHeading eyebrow={avisosIntro.title} id="avisos-titulo" />
  </div>

  {/* a sangre: los avisos de al lado asoman por los bordes */}
  <div class="carrusel-avisos relative mt-10 lg:mt-12">
    <div
      class="pista no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-[6vw] sm:gap-6 lg:px-[19vw]"
      aria-roledescription="carrusel"
      aria-label="Avisos"
      tabindex="0"
    >
      {
        avisos.map((aviso, indice) => (
          <article class="diapositiva w-[88vw] shrink-0 snap-center sm:w-[70vw] lg:w-[62vw]">
            {/*
              La foto y el velo salen del flujo, así que el resto queda en
              una columna: el texto abajo, y encima la imagen entera.

              La proporción va como suelo (`min-h` en vw) y no como
              `aspect-ratio`: con la proporción fija el alto sale de la cuenta
              y el texto que no cabía lo recortaba el `overflow-hidden`, que
              es lo que pasaba entre los 640 y los 1100px, donde la tarjeta es
              ancha pero baja. Las medidas son las mismas de antes —70vw a
              16/10, 62vw a 16/9—, solo que ahora la tarjeta puede crecer.

              El `h-full` es lo que las iguala: el carrusel estira todas las
              diapositivas a la más alta, y sin él cada tarjeta se quedaba en
              su propio alto y el carrusel salía desparejo.
            */}
            <div class="relative isolate flex h-full min-h-[41rem] flex-col justify-end overflow-hidden rounded-[1.5rem] bg-carbon p-6 sm:min-h-[43.75vw] sm:p-10 lg:min-h-[34.875vw] lg:rounded-[1.75rem] lg:p-14">
              {/*
                La tarjeta del móvil es más alta que ancha: una imagen
                apaisada se recorta por los lados y de un afiche se pierde
                justo lo que hay que leer. Por eso el aviso puede traer una
                versión vertical, y cada una se esconde donde no le toca.

                La vertical del afiche está compuesta a la medida de esta
                tarjeta (88vw x 39rem): la tabla de horarios ocupa el tercio
                de arriba y el resto es el mismo afiche desenfocado y apagado,
                que es donde cae el texto. Por eso trae su propio velo y aquí
                no se le pone ninguno encima.
              */}
              <Image
                src={aviso.image}
                alt={aviso.alt}
                widths={[640, 1024, 1600]}
                sizes="(min-width: 64rem) 62vw, (min-width: 40rem) 70vw, 88vw"
                class:list={[
                  'absolute inset-0 -z-10 size-full object-cover',
                  aviso.imageMovil && 'hidden sm:block',
                ]}
                loading={indice === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />

              {aviso.imageMovil && (
                <Image
                  src={aviso.imageMovil}
                  alt={aviso.alt}
                  widths={[480, 720, 1080]}
                  sizes="88vw"
                  quality={68}
                  class="absolute inset-0 -z-10 size-full object-cover object-top sm:hidden"
                  loading={indice === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              )}

              {/*
                El velo cae desde abajo mientras el aviso es una columna, y
                desde la izquierda cuando el texto se pone a un lado. Sobre un
                afiche se retira antes: lo que hay que leer está al otro lado y
                ahí la imagen tiene que verse tal cual.
              */}
              <div
                class:list={[
                  'absolute inset-0 -z-10 sm:bg-gradient-to-r',
                  // el afiche vertical ya viene apagado de fábrica: en el
                  // móvil no lleva velo, y del `sm` para arriba manda el
                  // lateral, porque ahí la imagen es la apaisada
                  !aviso.imageMovil && 'bg-gradient-to-t from-black/85 via-black/50 to-black/15',
                  aviso.afiche
                    ? 'sm:from-black/90 sm:from-0% sm:via-black/45 sm:via-30% sm:to-transparent sm:to-52%'
                    : 'sm:from-black/85 sm:via-black/45 sm:to-black/10',
                ]}
                aria-hidden="true"
              />

              {/*
                Sobre un afiche el texto se queda en su mitad y no cruza al
                otro lado: ahí está la tabla de horarios, y el velo lateral
                también corta a media tarjeta. En una foto puede ocupar más,
                porque detrás no hay nada que leer.
              */}
              <div class:list={['max-w-md', aviso.afiche && 'sm:max-w-[62%] lg:max-w-md']}>
                <p class="eyebrow text-white/70">{aviso.eyebrow}</p>
                <h3 class="heading-lg mt-4 text-white text-balance">{aviso.title}</h3>
                <p class="subtitle-lg mt-4 !text-white/75">{aviso.description}</p>

                <div class="mt-7 flex flex-wrap items-center gap-3">
                  <ArrowButton
                    label={aviso.action.label}
                    href={aviso.action.href}
                    variant="light"
                    size="md"
                    external={aviso.action.external}
                  />

                  {aviso.accionSecundaria && (
                    <ArrowButton
                      label={aviso.accionSecundaria.label}
                      href={aviso.accionSecundaria.href}
                      variant="accent"
                      size="md"
                      external={aviso.accionSecundaria.external}
                    />
                  )}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    {/*
      Las flechas solo del `sm` para arriba. En el móvil la tarjeta es alta y
      angosta, así que su centro —donde van las flechas— cae justo sobre el
      rótulo y el titular, y los tapaba. Ahí se pasa de aviso deslizando, y
      los puntos de abajo son botones de verdad para quien no deslice.
    */}
    {
      avisos.length > 1 && (
        <>
          <button
            type="button"
            data-avisos-prev
            class="absolute top-1/2 left-3 hidden size-11 -translate-y-1/2 place-items-center rounded-full bg-ink/85 text-white backdrop-blur-sm transition-colors hover:bg-ink sm:left-6 sm:grid lg:size-12"
          >
            <span class="sr-only">Aviso anterior</span>
            <Icon name="lucide:chevron-left" width={22} height={22} aria-hidden="true" />
          </button>

          <button
            type="button"
            data-avisos-next
            class="absolute top-1/2 right-3 hidden size-11 -translate-y-1/2 place-items-center rounded-full bg-ink/85 text-white backdrop-blur-sm transition-colors hover:bg-ink sm:right-6 sm:grid lg:size-12"
          >
            <span class="sr-only">Aviso siguiente</span>
            <Icon name="lucide:chevron-right" width={22} height={22} aria-hidden="true" />
          </button>
        </>
      )
    }
  </div>

  {/*
    Los puntos son la cinta en pequeño: uno por aviso, el del centro alargado.
    Como la cinta no tiene fin, después del último se enciende otra vez el
    primero sin desandar el camino.
  */}
  {
    avisos.length > 1 && (
      <div class="container-page mt-7 lg:mt-8">
        <div class="flex justify-center gap-2">
          {avisos.map((aviso, indice) => (
            <button type="button" class="punto" data-punto={indice}>
              <span class="sr-only">Ir a «{aviso.title}»</span>
            </button>
          ))}
        </div>
      </div>
    )
  }
</section>

<style>
  /* los de al lado quedan apagados: se ven, pero no compiten con el del centro */
  .diapositiva {
    opacity: 0.35;
    filter: grayscale(1);
    transition:
      opacity 400ms ease,
      filter 400ms ease;
  }

  .diapositiva[data-activo='true'] {
    opacity: 1;
    filter: none;
  }

  /* mientras se salta del clon al original no hay animación: si no, se ve
     apagarse uno y encenderse el otro, y eso es el parpadeo */
  .pista[data-saltando] .diapositiva {
    transition: none;
  }

  /* el punto del aviso que se está mirando se estira: al pasar de uno a otro
     el bulto se desplaza, y se lee como una cinta que avanza */
  .punto {
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 9999px;
    background: color-mix(in oklab, var(--color-ink) 20%, transparent);
    transition:
      width 400ms ease,
      background-color 400ms ease;
  }

  .punto:hover {
    background: color-mix(in oklab, var(--color-ink) 45%, transparent);
  }

  .punto[data-activo='true'] {
    width: 1.75rem;
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .pista {
      scroll-behavior: auto;
    }

    .diapositiva,
    .punto {
      transition: none;
    }
  }
</style>

<script>
  const carrusel = document.querySelector<HTMLElement>('.carrusel-avisos');
  const pista = carrusel?.querySelector<HTMLElement>('.pista');
  const reales = [...(pista?.querySelectorAll<HTMLElement>('.diapositiva') ?? [])];
  const anterior = carrusel?.querySelector<HTMLButtonElement>('[data-avisos-prev]');
  const siguiente = carrusel?.querySelector<HTMLButtonElement>('[data-avisos-next]');
  const puntos = [...document.querySelectorAll<HTMLButtonElement>('#avisos [data-punto]')];

  if (carrusel && pista && reales.length > 1 && anterior && siguiente) {
    /*
      Para que la cinta no tenga principio ni fin se pone un juego entero de
      avisos antes y otro después. Al llegar a uno de los juegos de al lado se
      salta sin animación al aviso equivalente del juego del medio, que está a
      un juego de distancia.

      Van los tres juegos y no un clon suelto a cada lado porque lo que tiene
      que coincidir no es solo el aviso del centro: también los dos que asoman
      por los bordes. Con un clon suelto, al final de la cinta no había nada a
      la derecha del clon, y al saltar al original aparecía de golpe el aviso
      siguiente asomando por el borde. Con un juego entero, lo que se ve antes
      y después del salto es la misma estampa.

      Los clones van con `inert`: se ven, pero no se tabulan ni se leen, así
      que el botón de cada aviso sigue estando una sola vez.
    */
    const clonar = (diapositiva: HTMLElement) => {
      const clon = diapositiva.cloneNode(true) as HTMLElement;
      clon.dataset.clon = 'true';
      clon.setAttribute('aria-hidden', 'true');
      clon.setAttribute('inert', '');
      return clon;
    };

    const cuantos = reales.length;
    reales.forEach((diapositiva) => pista.append(clonar(diapositiva)));
    [...reales].reverse().forEach((diapositiva) => pista.prepend(clonar(diapositiva)));

    const todas = [...pista.querySelectorAll<HTMLElement>('.diapositiva')];

    /*
      El del centro se elige por geometría y no por el índice del scroll: con
      los avisos asomando por los bordes, «cuánto se ha desplazado» no dice
      cuál se está mirando.
    */
    const cualEstaAlCentro = () => {
      const centro = pista.getBoundingClientRect().left + pista.clientWidth / 2;
      let elegido = 0;
      let menor = Infinity;

      todas.forEach((diapositiva, i) => {
        const caja = diapositiva.getBoundingClientRect();
        const distancia = Math.abs(caja.left + caja.width / 2 - centro);
        if (distancia < menor) {
          menor = distancia;
          elegido = i;
        }
      });

      return elegido;
    };

    /*
      Los clones cuentan como su original: cualquier posición de la cinta cae
      en un aviso u otro según en qué lugar del juego esté. Por eso el punto
      se saca con el resto, y al pasar del último al primero se enciende el
      primero sin más.
    */
    const cualAvisoEs = (indice: number) => ((indice - cuantos) % cuantos + cuantos) % cuantos;

    const marcar = () => {
      const centro = cualEstaAlCentro();
      todas.forEach((diapositiva, i) => (diapositiva.dataset.activo = String(i === centro)));

      const aviso = cualAvisoEs(centro);
      puntos.forEach((punto, i) => {
        punto.dataset.activo = String(i === aviso);
        if (i === aviso) punto.setAttribute('aria-current', 'true');
        else punto.removeAttribute('aria-current');
      });
    };

    const centrar = (diapositiva: HTMLElement, suave = true) => {
      const destino = diapositiva.offsetLeft - (pista.clientWidth - diapositiva.offsetWidth) / 2;
      // 'instant' y no 'auto': 'auto' quiere decir «lo que diga el CSS», y la
      // pista lleva scroll-behavior: smooth, así que el salto del clon al
      // original se animaba y se veía rebobinar hasta el principio
      pista.scrollTo({ left: destino, behavior: suave ? 'smooth' : 'instant' });
    };

    /** Del clon al original: mismo sitio en la cinta, sin que se note. */
    const saltarSiEsClon = () => {
      const centro = cualEstaAlCentro();
      if (!todas[centro]?.dataset.clon) return;

      const original = todas[cuantos + cualAvisoEs(centro)];

      /*
        El clon y su original enseñan lo mismo, pero son dos elementos: al
        cambiar cuál está encendido, uno se apaga y el otro se enciende, y esos
        400ms de animación son el parpadeo. Durante el salto no hay transición,
        así que el relevo ocurre entero en el mismo fotograma.
      */
      pista.dataset.saltando = 'true';
      centrar(original, false);
      marcar();
      void pista.offsetWidth; // repintado forzado: el antes y el después no se juntan
      requestAnimationFrame(() => delete pista.dataset.saltando);
    };

    const irA = (paso: number) => {
      const centro = cualEstaAlCentro();
      const destino = todas[centro + paso];
      if (destino) centrar(destino);
    };

    /*
      Los avisos van pasando solos. Cualquier gesto —flecha, rueda, dedo—
      reinicia la cuenta: si no, el cambio automático llegaría encima de lo
      que se acaba de mirar.
    */
    const ESPERA = 7000;
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)');
    let reloj = 0;
    let aLaVista = false;

    const parar = () => {
      clearInterval(reloj);
      reloj = 0;
    };

    const arrancar = () => {
      if (reloj || !aLaVista || quieto.matches) return;
      reloj = window.setInterval(() => irA(1), ESPERA);
    };

    const reiniciar = () => {
      parar();
      arrancar();
    };

    anterior.addEventListener('click', () => {
      irA(-1);
      reiniciar();
    });

    siguiente.addEventListener('click', () => {
      irA(1);
      reiniciar();
    });

    puntos.forEach((punto, i) =>
      punto.addEventListener('click', () => {
        centrar(todas[cuantos + i]);
        reiniciar();
      })
    );

    // ni corre mientras la sección no está a la vista, ni mientras se mira un aviso
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entrada]) => {
          aLaVista = entrada.isIntersecting;
          if (aLaVista) arrancar();
          else parar();
        },
        { threshold: 0.3 }
      ).observe(carrusel);
    } else {
      aLaVista = true;
      arrancar();
    }

    carrusel.addEventListener('mouseenter', parar);
    carrusel.addEventListener('mouseleave', arrancar);
    pista.addEventListener('focusin', parar);
    pista.addEventListener('focusout', arrancar);

    let pedido = 0;
    let parado = 0;
    pista.addEventListener(
      'scroll',
      () => {
        if (!pedido) {
          pedido = requestAnimationFrame(() => {
            pedido = 0;
            marcar();
          });
        }

        // el salto espera a que el desplazamiento pare, si no se pelea con él
        clearTimeout(parado);
        parado = window.setTimeout(saltarSiEsClon, 140);
      },
      { passive: true }
    );

    // a dedo o con la rueda también cuenta como gesto: la cuenta vuelve a cero
    pista.addEventListener('pointerdown', reiniciar);
    pista.addEventListener('wheel', reiniciar, { passive: true });

    window.addEventListener('resize', marcar);

    centrar(todas[cuantos], false);
    marcar();
  }
</script>
