---
import { Image } from 'astro:assets';
import ArrowButton from './ArrowButton.astro';
import { radio } from '../data/content';
---

{/* Sección en negro, a pantalla completa. `svh` y no `vh`: en el móvil la barra
    del navegador entra y sale, y con `vh` la sección daría saltos. */}
<section
  id="radio"
  class="flex min-h-svh items-center bg-carbon py-16 text-paper lg:py-24"
  aria-labelledby="radio-titulo"
>
  <div class="container-page">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <Image
        src={radio.image}
        alt={radio.alt}
        widths={[480, 720, 1080]}
        sizes="(min-width: 64rem) 620px, 90vw"
        class="aspect-[4/3] w-full rounded-media object-cover"
        loading="lazy"
        decoding="async"
      />

      <div>
        <p class="label-mono text-paper/50">Radio y predicaciones</p>
        <h2 id="radio-titulo" class="heading-xl mt-6 max-w-[11ch] text-paper">{radio.title}</h2>
        <p class="mt-7 max-w-md text-lg leading-relaxed text-paper/70">
          {radio.description}
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          {
            radio.actions.map(
              (action) =>
                action.href && (
                  <ArrowButton
                    label={action.label}
                    href={action.href}
                    variant="light"
                    external={action.external}
                  />
                )
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
