---
import { Image } from 'astro:assets';
import ArrowButton from './ArrowButton.astro';
import { radio } from '../data/content';
---

<section id="radio" class="py-20 lg:py-28" aria-labelledby="radio-titulo">
  <div class="container-page">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      {/*
        Los afiches van uno encima de otro y se turnan: se ve uno a la vez y
        el cambio es un fundido. Sin JavaScript se queda el primero, que es
        una foto correcta y no un hueco.
      */}
      <div class="afiches relative mx-auto aspect-[4/5] w-full max-w-[22rem] lg:mx-0">
        {
          radio.programas.map((programa, indice) => (
            <Image
              src={programa.poster}
              alt={`${programa.name}, ${programa.when}`}
              widths={[320, 480, 720]}
              sizes="(min-width: 64rem) 22rem, 80vw"
              class="afiche absolute inset-0 size-full rounded-[1.25rem] object-cover"
              data-activo={indice === 0 ? 'true' : 'false'}
              loading={indice === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ))
        }
      </div>

      <div>
        <h2 id="radio-titulo" class="heading-lg text-ink">{radio.title}</h2>
        <p class="subtitle-lg mt-3 max-w-md">{radio.description}</p>

        <div class="mt-7">
          <ArrowButton
            label={radio.action.label}
            href={radio.action.href}
            variant="accent"
            size="md"
            external={radio.action.external}
          />
        </div>
      </div>
    </div>
  </div>
</section>

{/*
  Global y acotado a `.afiches` a propósito: los estilos con ámbito de Astro
  no alcanzan a las imágenes, que las pinta el componente `<Image>`. Sin esto
  los seis afiches salían a la vez, apilados.
*/}
<style is:global>
  /*
    Sin JavaScript solo se ve el primero: los demás quedan detrás, no
    ocultos, para que sigan contando como contenido de la página.
  */
  .afiches .afiche {
    opacity: 0;
    transition: opacity 700ms ease;
  }

  .afiches .afiche[data-activo='true'] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .afiches .afiche {
      transition: none;
    }
  }
</style>

<script>
  /*
    Turno de cada afiche. Solo corre cuando la sección está a la vista: si no,
    se pasarían todos mientras nadie mira y al llegar se vería uno cualquiera.
  */
  const marco = document.querySelector<HTMLElement>('.afiches');
  const afiches = [...(marco?.querySelectorAll<HTMLElement>('.afiche') ?? [])];

  if (marco && afiches.length > 1) {
    const ESPERA = 3500;
    let actual = 0;
    let reloj = 0;

    const mostrar = (indice: number) => {
      afiches.forEach((afiche, i) => {
        afiche.dataset.activo = String(i === indice);
      });
    };

    const arrancar = () => {
      if (reloj) return;
      reloj = window.setInterval(() => {
        actual = (actual + 1) % afiches.length;
        mostrar(actual);
      }, ESPERA);
    };

    const parar = () => {
      clearInterval(reloj);
      reloj = 0;
    };

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entrada]) => (entrada.isIntersecting ? arrancar() : parar()),
        { threshold: 0.3 }
      ).observe(marco);
    } else {
      arrancar();
    }

    // al pasar el ratón se detiene, para mirar un afiche con calma
    marco.addEventListener('mouseenter', parar);
    marco.addEventListener('mouseleave', arrancar);
  }
</script>
