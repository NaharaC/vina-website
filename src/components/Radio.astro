---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ArrowButton from './ArrowButton.astro';
import { radio } from '../data/content';
import logoRadio from '../assets/img/radio-logo-blanco.png';
---

{/*
  Un panel gris claro con los afiches pasando a un lado y el texto al otro, al
  modo de la referencia. Los círculos de detrás son el guiño de la emisora:
  van recortados por el panel, como una señal saliendo del aire.
*/}
<section id="radio" class="seccion" aria-labelledby="radio-titulo">
  <div class="container-page">
    <div class="relative isolate overflow-hidden rounded-[2rem] bg-mist lg:rounded-[2.75rem]">
      {/* decoración: no aporta información, así que no se anuncia */}
      {/*
        El círculo y el logo van los dos en blanco a media tinta, como manchas
        de fondo: sobre el gris del panel se insinúan sin llamar la atención.
      */}
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div
          class="absolute -right-24 -bottom-32 size-[22rem] rounded-full bg-white/60 lg:size-[30rem]"
        >
        </div>

        <Image
          src={logoRadio}
          alt=""
          widths={[320, 640, 900]}
          sizes="(min-width: 64rem) 26rem, 15rem"
          class="absolute right-6 bottom-6 w-40 opacity-80 sm:w-56 lg:right-12 lg:bottom-10 lg:w-[26rem]"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="grid items-center gap-10 p-6 sm:p-10 lg:grid-cols-[1.1fr_1fr] lg:gap-14 lg:p-14">
        {/* los afiches: uno a la vez, con flechas y puntos para moverlos */}
        <div class="carrusel-radio">
          <div class="afiches relative aspect-video w-full overflow-hidden rounded-[1.25rem]">
            {
              radio.programas.map((programa, indice) => (
                <Image
                  src={programa.poster}
                  alt={`${programa.name}, ${programa.when}`}
                  widths={[480, 720, 1080]}
                  sizes="(min-width: 64rem) 40rem, 92vw"
                  class="afiche absolute inset-0 size-full object-cover"
                  data-activo={indice === 0 ? 'true' : 'false'}
                  loading={indice === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              ))
            }

          </div>

          <div class="mt-5 flex items-center justify-center gap-2.5">
            {
              radio.programas.map((programa, indice) => (
                <button
                  type="button"
                  class="punto h-2 rounded-full bg-ink/25 transition-all duration-300 hover:bg-ink/40"
                  data-punto={indice}
                  data-activo={indice === 0 ? 'true' : 'false'}
                >
                  <span class="sr-only">Ver {programa.name}</span>
                </button>
              ))
            }
          </div>
        </div>

        <div class="lg:pr-4">
          <p class="eyebrow">Nuestra radio</p>
          <h2 id="radio-titulo" class="heading-lg mt-4 text-ink">{radio.title}</h2>
          <p class="subtitle-lg mt-3 max-w-sm">{radio.description}</p>

          <div class="mt-8">
            <ArrowButton
              label={radio.action.label}
              href={radio.action.href}
              variant="accent"
              size="md"
              external={radio.action.external}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{/*
  Global y acotado al carrusel: los estilos con ámbito de Astro no alcanzan a
  las imágenes, que las pinta `<Image>`. Sin esto salen los seis a la vez.
*/}
<style is:global>
  .afiches .afiche {
    opacity: 0;
    transition: opacity 700ms ease;
  }

  .afiches .afiche[data-activo='true'] {
    opacity: 1;
  }

  /* el punto del que se está viendo se alarga, en vez de solo oscurecerse */
  .carrusel-radio .punto {
    width: 0.5rem;
  }

  .carrusel-radio .punto[data-activo='true'] {
    width: 1.75rem;
    background-color: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .afiches .afiche,
    .carrusel-radio .punto {
      transition: none;
    }
  }
</style>

<script>
  /*
    Los afiches se turnan solos, y con las flechas o los puntos se manda a
    mano. Cualquier toque reinicia la cuenta: si no, el cambio automático
    llegaría encima de lo que se acaba de elegir.
  */
  const carrusel = document.querySelector<HTMLElement>('.carrusel-radio');
  const marco = carrusel?.querySelector<HTMLElement>('.afiches');
  const afiches = [...(marco?.querySelectorAll<HTMLElement>('.afiche') ?? [])];
  const puntos = [...(carrusel?.querySelectorAll<HTMLElement>('.punto') ?? [])];

  if (carrusel && marco && afiches.length > 1) {
    const ESPERA = 4000;
    let actual = 0;
    let reloj = 0;

    const mostrar = (indice: number) => {
      actual = (indice + afiches.length) % afiches.length;
      afiches.forEach((afiche, i) => (afiche.dataset.activo = String(i === actual)));
      puntos.forEach((punto, i) => (punto.dataset.activo = String(i === actual)));
    };

    const arrancar = () => {
      if (reloj) return;
      reloj = window.setInterval(() => mostrar(actual + 1), ESPERA);
    };

    const parar = () => {
      clearInterval(reloj);
      reloj = 0;
    };

    /** A mano: se muestra y se reinicia la cuenta desde cero. */
    const irA = (indice: number) => {
      mostrar(indice);
      parar();
      arrancar();
    };

    puntos.forEach((punto, i) => punto.addEventListener('click', () => irA(i)));

    // no corre mientras la sección no está a la vista
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => (e.isIntersecting ? arrancar() : parar()), {
        threshold: 0.3,
      }).observe(marco);
    } else {
      arrancar();
    }

    marco.addEventListener('mouseenter', parar);
    marco.addEventListener('mouseleave', arrancar);
  }
</script>
