---
import { Image } from 'astro:assets';
import ArrowButton from './ArrowButton.astro';
import { radio } from '../data/content';
---

{/* A pantalla completa, con el contenido centrado. `svh` y no `vh`: en el móvil
    la barra del navegador entra y sale, y con `vh` la sección daría saltos. */}
<section
  id="radio"
  class="flex min-h-svh items-center py-12 lg:py-16"
  aria-labelledby="radio-titulo"
>
  <div class="container-page">
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
      <Image
        src={radio.image}
        alt={radio.alt}
        widths={[480, 720, 1080]}
        sizes="(min-width: 64rem) 580px, 90vw"
        class="aspect-[16/10] w-full rounded-[1.5rem] object-cover"
        loading="lazy"
        decoding="async"
      />

      <div>
        <h2 id="radio-titulo" class="heading-lg text-ink">{radio.title}</h2>
        <p class="subtitle-lg mt-3 max-w-md">
          {radio.description}
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          {
            radio.actions.map(
              (action) =>
                action.href && (
                  <ArrowButton
                    label={action.label}
                    href={action.href}
                    variant="accent"
                    external={action.external}
                  />
                )
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
