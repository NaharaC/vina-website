---
import { Icon } from 'astro-icon/components';

interface Props {
  label: string;
  href: string;
  /**
   * pill  = píldora gris sobre fondo claro (la de por defecto)
   * light = píldora blanca, para fondos oscuros o sobre foto
   * dark  = píldora negra sobre fondo claro
   */
  variant?: 'pill' | 'light' | 'dark';
  size?: 'sm' | 'md' | 'lg';
  /** abre en una pestaña nueva; para WhatsApp, donación, radio, etc. */
  external?: boolean;
  class?: string;
}

const {
  label,
  href,
  variant = 'pill',
  size = 'md',
  external = false,
  class: className = '',
} = Astro.props;

const shell = {
  pill: 'bg-pill text-ink hover:bg-pill-strong',
  light: 'bg-paper text-ink hover:bg-pill',
  dark: 'bg-ink text-paper hover:bg-carbon-soft',
}[variant];

const sizing = {
  sm: 'gap-2.5 px-4 py-2 text-[0.8125rem]',
  md: 'gap-3 px-5 py-3 text-[0.9375rem]',
  lg: 'gap-4 px-7 py-4 text-lg sm:px-8 sm:text-xl',
}[size];

const iconSize = { sm: 14, md: 16, lg: 20 }[size];
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    'group inline-flex shrink-0 items-center rounded-full font-medium transition-colors',
    shell,
    sizing,
    className,
  ]}
>
  <span class="whitespace-nowrap">{label}</span>
  {external && <span class="sr-only">(se abre en una ventana nueva)</span>}
  <Icon
    name={external ? 'lucide:arrow-up-right' : 'lucide:arrow-right'}
    width={iconSize}
    height={iconSize}
    class="shrink-0 transition-transform duration-200 group-hover:translate-x-0.5"
    aria-hidden="true"
  />
</a>
