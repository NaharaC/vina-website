---
import ArrowButton from './ArrowButton.astro';
import SectionHeading from './SectionHeading.astro';
import { mapsEmbedHref, mapsHref, ubicacion } from '../data/content';
---

{/*
  El mapa se comporta como una imagen enlazada: no se puede arrastrar ni hacer
  zoom —`pointer-events: none`— y encima va una capa que lleva a Google Maps.
  Así no atrapa el scroll en el móvil, que es lo que suele pasar con un mapa
  incrustado en medio de una página.
*/}
<section id="ubicacion" class="seccion seccion-fin" aria-labelledby="ubicacion-titulo">
  <div class="container-page">
    <SectionHeading eyebrow={ubicacion.eyebrow} id="ubicacion-titulo" />

    {/*
      El fondo `mist` es casi el gris del terreno de Google: mientras llegan
      las teselas se ve un mapa por pintar, no un hueco blanco.
    */}
    <div class="relative mt-10 overflow-hidden rounded-[1.5rem] bg-mist lg:mt-14">
      {/*
        Sin `src`: lo pone el script de abajo. El mapa es Google Maps entero
        —su JavaScript, sus fuentes, unas cuarenta y cinco peticiones— y tarda
        unos tres segundos en pintar. Con `loading="lazy"` no arrancaba hasta
        que la persona se acercaba, así que lo encontraba vacío.
      */}
      <iframe
        data-mapa={mapsEmbedHref}
        title={`Mapa con la ubicación de la iglesia: ${ubicacion.address}`}
        class="pointer-events-none block h-[24rem] w-full border-0 sm:h-[28rem] lg:h-[32rem]"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
      <noscript>
        <iframe
          src={mapsEmbedHref}
          title={`Mapa con la ubicación de la iglesia: ${ubicacion.address}`}
          class="pointer-events-none absolute inset-0 block h-full w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </noscript>

      {/*
        Capa que hace clicable el mapa entero. Va fuera del orden de
        tabulación: quien navegue con teclado o lector de pantalla usa el
        botón «Cómo llegar», que dice a dónde va.
      */}
      <a
        href={mapsHref}
        target="_blank"
        rel="noopener noreferrer"
        class="absolute inset-0"
        tabindex="-1"
        aria-hidden="true"></a>

      {/* la tarjeta, como en prédicas: flota sobre la imagen */}
      <div class="pointer-events-none absolute inset-x-4 bottom-4 sm:inset-x-8 sm:bottom-8">
        <div class="pointer-events-auto max-w-md rounded-[1.25rem] bg-white px-6 py-6 sm:px-8 sm:py-7">
          <p class="heading-md text-ink">{ubicacion.title}</p>
          <p class="subtitle mt-3">{ubicacion.address}</p>

          <div class="mt-5">
            <ArrowButton label={ubicacion.cta} href={mapsHref} variant="accent" size="sm" external />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  /*
    El mapa se pide cuando la página ya terminó de cargar y el navegador está
    libre, para no quitarle ancho de banda a la portada; así, cuando alguien
    baja hasta aquí, ya está pintado. Si llega antes —un salto con el ancla
    #ubicacion, un scroll muy rápido—, se pide en cuanto se acerca.
  */
  const mapa = document.querySelector<HTMLIFrameElement>('iframe[data-mapa]');
  if (mapa) {
    let pedido = false;
    const pedir = () => {
      if (pedido) return;
      pedido = true;
      observador.disconnect();
      mapa.src = mapa.dataset.mapa!;
    };

    const observador = new IntersectionObserver(
      (entradas) => entradas.some((e) => e.isIntersecting) && pedir(),
      { rootMargin: '100% 0px' },
    );
    observador.observe(mapa);

    const cuandoLibre = () =>
      'requestIdleCallback' in window
        ? requestIdleCallback(pedir, { timeout: 2000 })
        : setTimeout(pedir, 200);
    if (document.readyState === 'complete') cuandoLibre();
    else addEventListener('load', cuandoLibre, { once: true });
  }
</script>
