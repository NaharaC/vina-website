---
import { Image } from 'astro:assets';
import ArrowButton from './ArrowButton.astro';
import { contact, organization } from '../data/content';
---

{/* Ídem: a pantalla completa y con `svh` para que no salte en el móvil. */}
<section
  id="contacto"
  class="relative isolate flex min-h-svh items-end overflow-hidden"
  aria-labelledby="contacto-titulo"
>
  <Image
    src={contact.image}
    alt={contact.alt}
    widths={[768, 1280, 1920]}
    sizes="100vw"
    class="absolute inset-0 -z-10 size-full object-cover"
    loading="lazy"
    decoding="async"
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-black/40 via-black/25 to-black/80"
    aria-hidden="true"
  >
  </div>

  <div class="container-page py-16 lg:py-24">
    <p class="label-mono text-white/60">
      {[organization.streetAddress, organization.addressLocality].filter(Boolean).join(' · ')}
    </p>

    <h2 id="contacto-titulo" class="heading-hero mt-8 max-w-[9ch] text-white">
      {contact.title}
    </h2>

    <div class="mt-12 flex flex-col items-start gap-8 border-t border-white/20 pt-10 lg:flex-row lg:items-end lg:justify-between">
      <p class="max-w-sm text-lg leading-relaxed text-white/80">
        {contact.description}
      </p>

      {
        contact.action.href && (
          <ArrowButton
            label={contact.action.label}
            href={contact.action.href}
            variant="light"
            size="lg"
            external={contact.action.external}
          />
        )
      }
    </div>
  </div>
</section>
