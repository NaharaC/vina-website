---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { hero, heroActions } from '../data/content';
---

<section class="relative">
  {/* Foto a sangre y a pantalla completa, con el titular abajo a la izquierda */}
  <div class="relative min-h-svh">
    {/* Es el LCP de la página: carga inmediata y con prioridad alta. */}
    <Image
      src={hero.image}
      alt={hero.alt}
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      class="absolute inset-0 size-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/45 via-black/15 to-black/70"
      aria-hidden="true"
    >
    </div>

    <div class="relative flex min-h-svh flex-col justify-end pb-14 lg:pb-20">
      <div class="container-page">
        <p class="label-mono mb-6 text-white/70">Iglesia Viña Puerto Montt</p>
        <h1 class="heading-hero max-w-[14ch] text-white">
          Siendo una <span class="italic">familia compasiva</span> imitando a <span
            class="italic">Jesús</span
          >
        </h1>
      </div>
    </div>
  </div>

  {/*
    Los cuatro accesos, como una tira editorial separada por filetes en vez de
    un panel flotante. Cada uno ocupa una columna en escritorio y se apilan en
    móvil.
  */}
  <div class="container-page">
    <ul class="grid border-t border-hairline sm:grid-cols-2 lg:grid-cols-4">
      {
        heroActions.map((action) => (
          <li class="border-b border-hairline sm:border-b-0 sm:[&:nth-child(n+3)]:border-t lg:[&:nth-child(n+3)]:border-t-0 sm:[&:nth-child(even)]:border-l lg:border-l lg:first:border-l-0">
            <a
              href={action.href}
              class="group flex h-full flex-col gap-10 px-1 py-8 transition-colors sm:px-6 lg:px-7 lg:py-10 hover:bg-pill/50"
            >
              <Icon name={action.icon} width={26} height={26} class="text-ink" aria-hidden="true" />

              <span class="mt-auto block">
                <span class="heading-md block text-ink">{action.title}</span>
                <span class="mt-2 flex items-end justify-between gap-4">
                  <span class="block max-w-[22ch] text-sm leading-snug text-muted">
                    {action.description}
                  </span>
                  <Icon
                    name="lucide:arrow-right"
                    width={20}
                    height={20}
                    class="shrink-0 text-accent transition-transform duration-200 group-hover:translate-x-1"
                    aria-hidden="true"
                  />
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
