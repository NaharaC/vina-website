---
import { Icon } from 'astro-icon/components';
import { hero, heroActions } from '../data/content';
---

<section class="relative">
  {/* Video enmarcado: un margen blanco fino lo separa del borde del viewport */}
  <div class="relative mx-2 mt-2 overflow-hidden rounded-[2rem] lg:mx-3 lg:mt-3 lg:rounded-[2.75rem]">
    {/*
      El video corre solo, en silencio y en bucle. El póster es su primer
      fotograma: se ve de inmediato mientras el video carga, y es lo único que
      queda si el navegador no lo reproduce o si se pide menos movimiento.
    */}
    <video
      id="hero-video"
      class="h-[36rem] w-full object-cover object-center sm:h-[42rem] lg:h-[46rem]"
      src={hero.video}
      poster={hero.poster}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-label={hero.alt}></video>
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/25 to-black/45"
      aria-hidden="true"
    >
    </div>

    {/*
      El título va centrado con un leve sesgo hacia arriba, como en el mockup.
      Ojo: un padding en % se resuelve contra el ANCHO del contenedor, no el
      alto — por eso aquí va en unidades fijas.
    */}
    <div class="absolute inset-0 flex items-center justify-center px-6 pb-10">
      {/* mismo peso y tracking que los títulos del resto de la web */}
      <h1
        class="max-w-[52rem] text-center leading-[1.04] font-semibold tracking-[-0.04em] text-balance text-white"
        style="font-size: clamp(2rem, 1rem + 3.6vw, 3.75rem)"
      >
        Siendo una familia compasiva<br />
        imitando a Jesús
      </h1>
    </div>
  </div>

  {/* Panel de acciones: arranca sobre la foto y cuelga hacia el fondo blanco */}
  <div class="container-page">
    <div
      class="relative z-10 mx-auto -mt-52 mb-12 w-full max-w-[27rem] rounded-panel bg-carbon p-4 shadow-2xl shadow-black/25 sm:-mt-56 lg:-mt-60 lg:mb-16"
    >
      <div class="px-2 pt-2 pb-1">
        <p class="text-[1.375rem] font-semibold tracking-[-0.03em] text-white">¡Te estábamos esperando!</p>
        <p class="mt-0.5 text-sm text-white/70">Ven y sé parte</p>
      </div>

      <ul class="mt-3 flex flex-col gap-3">
        {
          heroActions.map((action) => (
            <li>
              <a
                href={action.href}
                class="group flex items-center gap-3.5 rounded-row bg-carbon-soft p-3 ring-1 ring-white/5 transition-colors hover:bg-white/15"
              >
                <span
                  class:list={[
                    'grid size-11 shrink-0 place-items-center rounded-full text-white',
                    action.iconClass,
                  ]}
                >
                  <Icon name={action.icon} width={22} height={22} aria-hidden="true" />
                </span>

                <span class="min-w-0 flex-1">
                  <span class="block truncate text-[1.0625rem] font-semibold tracking-[-0.03em] text-white">
                    {action.title}
                  </span>
                  <span class="block truncate text-[0.8125rem] text-white/80">
                    {action.description}
                  </span>
                </span>

                <span
                  class="grid size-10 shrink-0 place-items-center rounded-xl bg-mist text-carbon transition-transform duration-200 group-hover:translate-x-0.5"
                >
                  <Icon name="lucide:arrow-right" width={17} height={17} aria-hidden="true" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  /*
    Con «reducir movimiento» activado el video se queda en su póster: para eso
    se para y se le quita el arranque automático, en vez de esconderlo.
  */
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;

  if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.pause();
    video.removeAttribute('autoplay');
    video.currentTime = 0;
  }
</script>
