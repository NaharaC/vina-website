---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { hero, heroActions } from '../data/content';
---

<section class="relative">
  {/* Foto enmarcada: un margen blanco fino la separa del borde del viewport */}
  <div
    class="relative mx-2 mt-2 flex min-h-[78svh] items-end overflow-hidden rounded-[2rem] lg:mx-3 lg:mt-3 lg:min-h-[86svh] lg:rounded-[2.75rem]"
  >
    {/* Es el LCP de la página: carga inmediata y con prioridad alta. */}
    <Image
      src={hero.image}
      alt={hero.alt}
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      class="absolute inset-0 size-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    {/* velo parejo: el titular cruza zonas claras de la foto */}
    <div class="absolute inset-0 bg-[#090909]/45" aria-hidden="true"></div>

    {/*
      El titular va abajo a la izquierda y en peso normal, como en Actividades
      y Nosotros: el peso lo pone el tamaño. Centrado y en seminegrita pesaba
      demasiado para abrir la página.
    */}
    <div class="relative w-full pb-12 lg:pb-16">
      <div class="container-page">
        <p class="eyebrow !text-white/75">{hero.panelSubtitle}</p>

        <h1
          class="mt-5 max-w-[20ch] leading-[0.92] font-normal tracking-[-0.04em] text-balance text-white"
          style="font-size: clamp(2.5rem, 1rem + 5.2vw, 5rem)"
        >
          Siendo una familia compasiva imitando a Jesús
        </h1>
      </div>
    </div>
  </div>

  {/*
    Las cuatro puertas de entrada, en fila y sobre blanco. Antes colgaban de la
    foto en un panel oscuro y estrecho: se leían en columna, apretadas, y
    tapaban medio hero.
  */}
  <div class="container-page">
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4 lg:gap-5">
      {
        heroActions.map((action) => (
          <li>
            <a
              href={action.href}
              class="group flex h-full flex-col justify-between gap-8 rounded-[1.25rem] bg-mist p-5 transition-colors hover:bg-[#e8e7e2] lg:p-6"
            >
              <span
                class:list={[
                  'grid size-11 shrink-0 place-items-center rounded-full text-white',
                  action.iconClass,
                ]}
              >
                <Icon name={action.icon} width={22} height={22} aria-hidden="true" />
              </span>

              <span class="block">
                <span class="flex items-center justify-between gap-3">
                  <span class="text-[1.0625rem] font-semibold tracking-[-0.03em] text-ink">
                    {action.title}
                  </span>

                  <Icon
                    name="lucide:arrow-right"
                    width={18}
                    height={18}
                    class="shrink-0 text-ink transition-transform duration-200 group-hover:translate-x-0.5"
                    aria-hidden="true"
                  />
                </span>

                <span class="mt-1 block text-[0.9375rem] text-muted">{action.description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
