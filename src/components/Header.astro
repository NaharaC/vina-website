---
import { Icon } from 'astro-icon/components';
import ArrowButton from './ArrowButton.astro';
import Logo from './Logo.astro';
import { nav, whatsappHref } from '../data/content';

// Mientras no haya número de WhatsApp, "Contactar" baja a la sección de contacto.
const contactHref = whatsappHref() || '#contacto';
const contactIsExternal = contactHref.startsWith('http');
---

{/*
  Un único navbar que muta según el scroll (escritorio):

  - Arriba del todo: transparente y a todo el ancho, fundido con el hero.
  - Al bajar dentro del hero: se contrae en una píldora oscura centrada.
  - Pasado el hero, bajando: se esconde; subiendo: reaparece.
  - De vuelta arriba: se expande al formato original.

  En móvil no hay morfosis de ancho: la barra pierde el fondo arriba del todo
  y se esconde/asoma con la dirección del scroll, como siempre.
*/}
<header
  id="site-header"
  class="fixed inset-x-0 top-4 z-50 lg:top-6"
  data-hidden="false"
  data-open="false"
  data-at-top="true"
>
  <div class="container-page">
    <nav
      id="site-nav"
      aria-label="Navegación principal"
      class="rounded-[1.75rem] bg-carbon/70 shadow-lg shadow-black/10 backdrop-blur-md lg:rounded-full"
    >
      <div id="nav-row" class="flex items-center gap-4 px-5 py-3">
        {/* dos tamaños de logo: el `hidden` va en un contenedor por lo mismo que abajo */}
        <Logo class="text-white lg:hidden" width={116} />
        <span id="nav-logo" class="hidden lg:block">
          <Logo class="text-white" width={104} />
        </span>

        <ul
          id="nav-links"
          class="ml-auto hidden items-center gap-6 text-[0.9375rem] text-white/95 lg:flex"
        >
          {
            nav.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-block py-1 transition-opacity hover:opacity-70"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        {/*
          El ocultar va en un contenedor: `hidden` no puede ganarle al
          `inline-flex` propio de ArrowButton, porque Tailwind emite
          `.inline-flex` después de `.hidden` y ambas tienen la misma
          especificidad.
        */}
        <div id="nav-cta" class="hidden lg:block">
          <ArrowButton
            label="Contactar"
            href={contactHref}
            external={contactIsExternal}
            variant="light"
            size="sm"
          />
        </div>

        <button
          type="button"
          id="nav-toggle"
          class="ml-auto grid size-10 shrink-0 place-items-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 lg:hidden"
          aria-expanded="false"
          aria-controls="nav-panel"
        >
          <span class="sr-only">Abrir menú</span>
          <Icon name="lucide:menu" width={20} height={20} class="nav-icon-open" aria-hidden="true" />
          <Icon
            name="lucide:x"
            width={20}
            height={20}
            class="nav-icon-close hidden"
            aria-hidden="true"
          />
        </button>
      </div>

      <div id="nav-panel" class="hidden px-5 pb-5 lg:hidden">
        <ul class="flex flex-col gap-1 border-t border-white/15 pt-4 text-white">
          {
            nav.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block rounded-xl px-3 py-2.5 text-lg font-medium transition-colors hover:bg-white/10"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <ArrowButton
          label="Contactar"
          href={contactHref}
          external={contactIsExternal}
          variant="light"
          size="md"
          class="mt-4 w-full justify-between"
        />
      </div>
    </nav>
  </div>
</header>

<style>
  #site-header {
    transition: transform 300ms ease;
  }

  /* Sube lo suficiente para esconder también la sombra y el margen superior. */
  #site-header[data-hidden='true'] {
    transform: translateY(calc(-100% - 2rem));
  }

  /*
    Arriba del todo la barra pierde el fondo y se funde con la foto del hero.
    Solo en páginas que abren con foto (data-hero-foto): sobre fondo claro el
    logo blanco desaparecería. Con el menú móvil abierto el fondo se queda:
    si no, no se leería nada.
  */
  #site-header[data-at-top='true'][data-open='false'] #site-nav {
    background-color: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /*
    Sin píldora detrás, el aire interior de la barra sobra: quitándolo el logo
    arranca justo en el margen de la página, en la misma vertical que el
    titular de la portada y que el texto de todas las secciones. Con el menú
    abierto el fondo vuelve, y el aire con él.
  */
  #site-header[data-at-top='true'][data-open='false'] #nav-row {
    padding-inline: 0;
  }

  /*
    Sin la píldora detrás, el contenido necesita el color del fondo de la
    página: blanco sobre la foto del hero, tinta sobre fondo claro. Al bajar,
    cuando vuelve la píldora oscura, todo regresa a blanco solo.
  */
  body[data-hero-foto='false'] #site-header[data-at-top='true'][data-open='false'] #site-nav :global(img) {
    filter: brightness(0);
  }

  body[data-hero-foto='false'] #site-header[data-at-top='true'][data-open='false'] #nav-links {
    color: var(--color-ink);
  }

  body[data-hero-foto='false'] #site-header[data-at-top='true'][data-open='false'] #nav-toggle {
    background-color: color-mix(in srgb, var(--color-ink) 10%, transparent);
    color: var(--color-ink);
  }

  /* el botón claro desaparecería sobre blanco: arriba va en el naranja de marca */
  body[data-hero-foto='false'] #site-header[data-at-top='true'][data-open='false'] #nav-cta :global(a) {
    background-color: var(--color-accent);
    color: white;
  }

  body[data-hero-foto='false']
    #site-header[data-at-top='true'][data-open='false']
    #nav-cta
    :global(a:hover) {
    background-color: var(--color-accent-strong);
  }

  /* con el botón naranja, el círculo de la flecha va blanco con flecha naranja */
  body[data-hero-foto='false']
    #site-header[data-at-top='true'][data-open='false']
    #nav-cta
    :global(a span:last-of-type) {
    background-color: white;
    color: var(--color-accent);
  }

  #site-nav :global(img) {
    transition: filter 300ms ease;
  }

  #nav-links,
  #nav-toggle,
  #nav-cta :global(a) {
    transition:
      color 300ms ease,
      background-color 300ms ease;
  }

  /*
    Escritorio: la morfosis navbar ⇄ píldora anima el ancho entre `100%` y
    `fit-content`. Animar hacia una palabra clave necesita `interpolate-size`
    (Chrome 129+); donde no exista, el ancho salta pero el layout es el mismo.

    El efecto es el mismo en toda la web; lo que cambia según la página es
    solo el fondo: transparente sobre una foto, oscuro sobre fondo claro.
  */
  @media (min-width: 64rem) {
    #site-nav {
      interpolate-size: allow-keywords;
      width: fit-content;
      margin-inline: auto;
      transition:
        width 450ms ease,
        background-color 300ms ease,
        box-shadow 300ms ease;
    }

    #site-header[data-at-top='true'] #site-nav {
      width: 100%;
    }

    /* estado píldora (el de base): más delgada, letra y logo un punto menores */
    #nav-row {
      padding: 0.375rem 0.875rem;
      transition: padding 450ms ease;
    }

    #nav-links {
      gap: 1.25rem;
      font-size: 0.875rem;
      transition:
        gap 450ms ease,
        font-size 450ms ease;
    }

    /* el img vive dentro del componente Logo: sin :global el scope no lo alcanza */
    #nav-logo :global(img) {
      width: 86px;
      transition: width 450ms ease;
    }

    /* el botón marca la altura de la píldora: en compacto va más fino */
    #nav-cta :global(a) {
      padding-block: 0.25rem;
      transition: padding 450ms ease;
    }

    #nav-cta :global(a span:last-of-type) {
      width: 1.5rem;
      height: 1.5rem;
      transition:
        width 450ms ease,
        height 450ms ease;
    }

    /* con el nav ancho todo respira más y los enlaces se pegan a la derecha */
    #site-header[data-at-top='true'] #nav-row {
      padding: 0.5rem 0.5rem;
    }

    #site-header[data-at-top='true'] #nav-links {
      gap: 2rem;
      font-size: 0.9375rem;
    }

    #site-header[data-at-top='true'] #nav-logo :global(img) {
      width: 104px;
    }

    #site-header[data-at-top='true'] #nav-cta :global(a) {
      padding-block: 0.375rem;
    }

    #site-header[data-at-top='true'] #nav-cta :global(a span:last-of-type) {
      width: 1.75rem;
      height: 1.75rem;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');
  const nav = document.getElementById('site-nav');

  const menuIsOpen = () => panel?.classList.contains('hidden') === false;

  if (toggle && panel && nav) {
    const open = toggle.querySelector('.nav-icon-open');
    const close = toggle.querySelector('.nav-icon-close');

    const setOpen = (isOpen: boolean) => {
      panel.classList.toggle('hidden', !isOpen);
      open?.classList.toggle('hidden', isOpen);
      close?.classList.toggle('hidden', !isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.querySelector('.sr-only')!.textContent = isOpen ? 'Cerrar menú' : 'Abrir menú';
      // con el panel abierto el fondo translúcido deja ver la foto detrás
      nav.classList.toggle('bg-carbon/70', !isOpen);
      nav.classList.toggle('bg-carbon', isOpen);
      if (header) {
        // el CSS usa data-open para no quitarle el fondo al menú abierto
        header.dataset.open = String(isOpen);
        // abrir el menú nunca deja la barra escondida
        if (isOpen) header.dataset.hidden = 'false';
      }
    };

    toggle.addEventListener('click', () => {
      setOpen(panel.classList.contains('hidden'));
    });

    // cerrar al navegar a una sección
    panel.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.classList.contains('hidden')) setOpen(false);
    });

    // volver al estado de escritorio si se agranda la ventana
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  /* --- Estados según posición y dirección del scroll ----------------------- */

  if (header) {
    /** Hasta aquí el navbar está expandido y transparente sobre el hero. */
    const AT_TOP = 32;
    /** Movimiento mínimo para reaccionar: evita parpadeos y el rebote del móvil. */
    const THRESHOLD = 8;

    const desktop = window.matchMedia('(min-width: 64rem)');
    /**
     * Bajando, la barra se esconde recién al salir del hero; subiendo siempre
     * reaparece. Los 700px son para no perderla dentro del video del home: en
     * páginas sin foto de portada no hay nada que esperar.
     */
    const conHero = document.body.dataset.heroFoto === 'true';
    const hideAfter = () => (desktop.matches && conHero ? 700 : 120);

    let lastY = window.scrollY;
    let pending = false;

    const update = () => {
      pending = false;
      const y = Math.max(0, window.scrollY);

      header.dataset.atTop = String(y < AT_TOP);

      const movement = y - lastY;
      if (Math.abs(movement) < THRESHOLD) return;

      const goingDown = movement > 0;
      header.dataset.hidden = String(goingDown && y > hideAfter() && !menuIsOpen());
      lastY = y;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (pending) return;
        pending = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );

    // estado inicial correcto si la página carga ya con scroll (anclas)
    update();
  }
</script>
