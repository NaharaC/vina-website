---
import { Icon } from 'astro-icon/components';
import ArrowButton from './ArrowButton.astro';
import Logo from './Logo.astro';
import { nav, whatsappHref } from '../data/content';

// Mientras no haya número de WhatsApp, "Contactar" baja a la sección de contacto.
const contactHref = whatsappHref() || '#contacto';
const contactIsExternal = contactHref.startsWith('http');
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50" data-hidden="false" data-solid="false">
  <div class="container-page">
    <nav id="site-nav" aria-label="Navegación principal">
      <div class="flex items-center gap-4 py-5 lg:py-6">
        <Logo width={124} />

        <ul class="ml-auto hidden items-center gap-9 text-[0.9375rem] lg:flex xl:gap-11">
          {
            nav.map((link) => (
              <li>
                <a href={link.href} class="inline-block py-1 transition-opacity hover:opacity-60">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        {/*
          El ocultar va en un contenedor: `hidden` no puede ganarle al
          `inline-flex` propio de ArrowButton, porque Tailwind emite
          `.inline-flex` después de `.hidden` y ambas tienen la misma
          especificidad.
        */}
        <div class="hidden lg:ml-6 lg:block">
          <ArrowButton
            label="Contactar"
            href={contactHref}
            external={contactIsExternal}
            variant="light"
            size="sm"
            class="nav-cta"
          />
        </div>

        <button
          type="button"
          id="nav-toggle"
          class="ml-auto grid size-10 shrink-0 place-items-center rounded-full transition-colors lg:hidden"
          aria-expanded="false"
          aria-controls="nav-panel"
        >
          <span class="sr-only">Abrir menú</span>
          <Icon name="lucide:menu" width={22} height={22} class="nav-icon-open" aria-hidden="true" />
          <Icon
            name="lucide:x"
            width={22}
            height={22}
            class="nav-icon-close hidden"
            aria-hidden="true"
          />
        </button>
      </div>

      <div id="nav-panel" class="hidden pb-6 lg:hidden">
        <ul class="flex flex-col gap-1 border-t border-current/15 pt-5">
          {
            nav.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block py-2.5 text-2xl font-bold tracking-tight transition-opacity hover:opacity-60"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <ArrowButton
          label="Contactar"
          href={contactHref}
          external={contactIsExternal}
          variant="dark"
          size="md"
          class="mt-6 w-full justify-between"
        />
      </div>
    </nav>
  </div>
</header>

<style>
  #site-header {
    transition:
      transform 300ms ease,
      background-color 250ms ease,
      color 250ms ease;
    color: var(--color-paper);
  }

  /* Sube lo suficiente para esconder también la sombra y el margen superior. */
  #site-header[data-hidden='true'] {
    transform: translateY(-100%);
  }

  /*
    Sobre el hero la barra va transparente con texto blanco. Al pasar de largo
    el hero se vuelve sólida, porque el resto de la página es blanca y el texto
    blanco no se leería.
  */
  #site-header[data-solid='true'],
  #site-header[data-open='true'] {
    background-color: var(--color-paper);
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-hairline);
  }

  /* El logotipo es blanco sobre transparente: al invertirlo queda negro. */
  #site-header[data-solid='true'] :global(img),
  #site-header[data-open='true'] :global(img) {
    filter: invert(1);
  }

  /* Sobre la foto el botón va blanco; sobre la barra blanca se invierte, o
     desaparecería sobre su propio fondo. */
  #site-header[data-solid='true'] :global(.nav-cta) {
    background-color: var(--color-ink);
    color: var(--color-paper);
  }

  #site-header[data-solid='true'] :global(.nav-cta:hover) {
    background-color: var(--color-carbon-soft);
  }

  #nav-toggle:hover {
    background-color: color-mix(in srgb, currentColor 12%, transparent);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');

  const menuIsOpen = () => panel?.classList.contains('hidden') === false;

  if (header && toggle && panel) {
    const open = toggle.querySelector('.nav-icon-open');
    const close = toggle.querySelector('.nav-icon-close');

    const setOpen = (isOpen: boolean) => {
      panel.classList.toggle('hidden', !isOpen);
      open?.classList.toggle('hidden', isOpen);
      close?.classList.toggle('hidden', !isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.querySelector('.sr-only')!.textContent = isOpen ? 'Cerrar menú' : 'Abrir menú';
      // con el panel desplegado la barra necesita fondo, esté donde esté
      header.dataset.open = String(isOpen);
      // abrir el menú nunca deja la barra escondida
      if (isOpen) header.dataset.hidden = 'false';
    };

    toggle.addEventListener('click', () => setOpen(panel.classList.contains('hidden')));

    // cerrar al navegar a una sección
    panel.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuIsOpen()) setOpen(false);
    });

    // volver al estado de escritorio si se agranda la ventana
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  /* --- Ocultar al bajar, mostrar al subir · fondo sólido fuera del hero ---- */

  if (header) {
    /** Por debajo de esta altura la barra siempre se ve. */
    const TOP_ZONE = 120;
    /** Movimiento mínimo para reaccionar: evita parpadeos y el rebote del móvil. */
    const THRESHOLD = 8;

    const hero = document.querySelector('main > section');
    const heroEnd = () => (hero ? hero.getBoundingClientRect().height - header.offsetHeight : 0);

    let lastY = window.scrollY;
    let pending = false;

    const update = () => {
      pending = false;
      const y = Math.max(0, window.scrollY);

      header.dataset.solid = String(y > heroEnd());

      const movement = y - lastY;
      if (Math.abs(movement) < THRESHOLD) return;

      const goingDown = movement > 0;
      header.dataset.hidden = String(goingDown && y > TOP_ZONE && !menuIsOpen());
      lastY = y;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (pending) return;
        pending = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );

    window.addEventListener('resize', update);
    update();
  }
</script>
