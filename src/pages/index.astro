---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avisos from '../components/Avisos.astro';
import CompassionateFamily from '../components/CompassionateFamily.astro';
import Contact from '../components/Contact.astro';
import FamilyCollage from '../components/FamilyCollage.astro';
import FamilyLife from '../components/FamilyLife.astro';
import Giving from '../components/Giving.astro';
import Hero from '../components/Hero.astro';
import MainMeetings from '../components/MainMeetings.astro';
import Partners from '../components/Partners.astro';
import PropheticStatement from '../components/PropheticStatement.astro';
import Stats from '../components/Stats.astro';
import Ubicacion from '../components/Ubicacion.astro';
import Testimonials from '../components/Testimonials.astro';
import { site } from '../data/content';
---

<BaseLayout title={`${site.name} — ${site.tagline}`} heroFoto>
  <Hero />
  <PropheticStatement />
  <MainMeetings />
  <Ubicacion />
  <FamilyCollage />
  <Stats />
  <Partners />
  <CompassionateFamily />
  <Avisos />
  <FamilyLife />

  {/*
    El testimonio y Dar comparten la banda gris: empieza en el versículo de
    Apocalipsis y termina al pie de Dar, con las esquinas de abajo
    redondeadas para que cierre como un bloque.
  */}
  <div class="relative z-10 rounded-b-[2rem] bg-mist lg:rounded-b-[2.75rem]">
    <Testimonials />
    <Giving />
  </div>

  <Contact />
</BaseLayout>
