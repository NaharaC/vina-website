---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CompassionateFamily from '../components/CompassionateFamily.astro';
import Contact from '../components/Contact.astro';
import FamilyCollage from '../components/FamilyCollage.astro';
import FamilyLife from '../components/FamilyLife.astro';
import Giving from '../components/Giving.astro';
import Hero from '../components/Hero.astro';
import MainMeetings from '../components/MainMeetings.astro';
import Partners from '../components/Partners.astro';
import PropheticStatement from '../components/PropheticStatement.astro';
import Escucha from '../components/Escucha.astro';
import Stats from '../components/Stats.astro';
import Ubicacion from '../components/Ubicacion.astro';
import Testimonials from '../components/Testimonials.astro';
import { site } from '../data/content';
import fondoEditorial from '../assets/img/dar-manos.jpg';

/*
  La foto que se ve por detrás de Dar y del testimonio. Va como fondo en CSS
  (y no como <img>) porque tiene que asomar por dos huecos a la vez, como si
  estuviera clavada detrás del papel: la sección de Dar entera y el rectángulo
  que enmarca el video del testimonio.
*/
const fondo = await getImage({ src: fondoEditorial, width: 2200, format: 'webp' });
---

<BaseLayout title={`${site.name} — ${site.tagline}`} heroFoto>
  {/*
    El home se lee en cuatro actos: la bienvenida, cuándo y dónde venir,
    quiénes somos y cómo se vive la iglesia. Antes lo práctico —las reuniones y
    el mapa— quedaba después de la declaración, y las dos secciones de escuchar
    caían separadas por media página.
  */}
  <Hero />

  <MainMeetings />
  <Ubicacion />

  <PropheticStatement />
  <FamilyCollage />
  <Stats />
  <Partners />
  <CompassionateFamily />

  <FamilyLife />

  {/*
    El testimonio y Dar van juntos en el tramo oscuro. La foto de fondo es de
    Dar; `--foto` es lo único que hay que cambiar para cambiarla.
  */}
  <div class="tema-editorial" style={`--foto: url('${fondo.src}')`}>
    <Testimonials />
    <Giving />
  </div>

  <Escucha />
  <Contact />
</BaseLayout>
