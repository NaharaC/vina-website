---
import { Image } from 'astro:assets';
import ArrowButton from '../components/ArrowButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FotoPendiente from '../components/FotoPendiente.astro';
import { about, site, stats, whatsappHref } from '../data/content';

const contactHref = whatsappHref('Hola, me gustaría saber más de la iglesia') || '/#contacto';
---

{/*
  Sin `heroFoto`: la página abre sobre blanco, así que la barra de navegación
  tiene que ir en tinta y no en blanco.
*/}
<BaseLayout
  title={`Nosotros — ${site.name}`}
  description="La historia de Iglesia Viña Puerto Montt: cómo empezó, qué creemos y quiénes la pastorean."
>
  {/* Portada: solo tipografía, mucho aire y el titular en peso normal */}
  <section class="pt-36 pb-16 lg:pt-44 lg:pb-24" aria-labelledby="nosotros-titulo">
    <div class="container-page">
      <p class="eyebrow">{about.eyebrow}</p>
      <h1
        id="nosotros-titulo"
        class="mt-6 max-w-5xl leading-[0.95] font-normal tracking-[-0.04em] text-ink text-balance"
        style="font-size: clamp(2.5rem, 1rem + 5vw, 5rem)"
      >
        {about.title}
      </h1>
    </div>
  </section>

  {/* Historia: la foto a un lado y el relato al otro, con la cita al pie */}
  <section class="pb-20 lg:pb-28" aria-label="Nuestra historia">
    <div class="container-page">
      <div class="lg:grid lg:grid-cols-2 lg:items-start lg:gap-16">
        <figure>
          {
            about.historia.foto ? (
              <Image
                src={about.historia.foto}
                alt={about.historia.fotoCaption}
                widths={[480, 768, 1080]}
                sizes="(min-width: 64rem) 40rem, 92vw"
                class="aspect-[4/3] w-full rounded-[1rem] object-cover"
                loading="eager"
              />
            ) : (
              <FotoPendiente
                label="Foto antigua de la iglesia · horizontal 4:3"
                class="aspect-[4/3] w-full rounded-[1rem]"
              />
            )
          }

          <figcaption class="mt-4 flex gap-3 text-sm text-muted">
            <span aria-hidden="true">—</span>
            {about.historia.fotoCaption}
          </figcaption>
        </figure>

        <div class="mt-12 lg:mt-0">
          <h2 class="heading-lg text-ink">{about.historia.title}</h2>

          <div class="mt-5 flex flex-col gap-4">
            {about.historia.body.map((parrafo) => <p class="subtitle-lg max-w-xl">{parrafo}</p>)}
          </div>

          {/* La cita, con quien la dice al pie: como la referencia */}
          <figure class="mt-10 border-t border-ink/15 pt-8">
            <blockquote class="max-w-xl text-lg leading-relaxed text-ink">
              {about.cita.quote}
            </blockquote>

            <figcaption class="mt-6 flex items-center gap-4">
              {
                about.cita.photo ? (
                  <Image
                    src={about.cita.photo}
                    alt={about.cita.name}
                    widths={[64, 128]}
                    sizes="56px"
                    class="size-14 shrink-0 rounded-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <FotoPendiente label="Retrato" class="size-14 shrink-0 rounded-full !p-1" />
                )
              }

              <div>
                <p class="text-sm font-semibold text-ink">{about.cita.name}</p>
                <p class="text-sm text-muted">{about.cita.role}</p>
              </div>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  {/* Qué creemos: filas separadas por líneas, título a un lado y texto al otro */}
  <section class="pb-20 lg:pb-28" aria-label="Qué creemos">
    <div class="container-page">
      {
        about.valores.map((valor) => (
          <div class="border-t border-ink/15 py-10 lg:grid lg:grid-cols-2 lg:gap-16 lg:py-14">
            <h2 class="heading-lg max-w-md text-ink">{valor.title}</h2>
            <p class="subtitle-lg mt-4 max-w-xl lg:mt-0">{valor.body}</p>
          </div>
        ))
      }
      <div class="border-t border-ink/15"></div>
    </div>
  </section>

  {/* Fotos antiguas */}
  <section class="pb-20 lg:pb-28" aria-labelledby="galeria-titulo">
    <div class="container-page">
      <h2 id="galeria-titulo" class="heading-lg text-ink">{about.galeria.title}</h2>
      <p class="subtitle-lg mt-3 max-w-md">{about.galeria.description}</p>

      <ul class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3">
        {
          about.galeria.fotos.map((foto) => (
            <li>
              <figure>
                {foto.image ? (
                  <Image
                    src={foto.image}
                    alt={foto.caption}
                    widths={[320, 480, 720]}
                    sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 45vw, 92vw"
                    class="aspect-[4/3] w-full rounded-[1rem] object-cover"
                    loading="lazy"
                  />
                ) : (
                  <FotoPendiente
                    label="Foto antigua · horizontal 4:3"
                    class="aspect-[4/3] w-full rounded-[1rem]"
                  />
                )}

                <figcaption class="mt-3 text-sm text-muted">{foto.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Equipo pastoral */}
  <section class="pb-20 lg:pb-28" aria-labelledby="equipo-titulo">
    <div class="container-page">
      <h2 id="equipo-titulo" class="heading-lg text-ink">{about.equipo.title}</h2>
      <p class="subtitle-lg mt-3 max-w-md">{about.equipo.description}</p>

      <ul class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3">
        {
          about.equipo.miembros.map((miembro) => (
            <li>
              {miembro.photo ? (
                /*
                  Las dos fotos van una encima de la otra y al pasar el ratón
                  se cambia la de arriba por la de abajo. Quien no tiene
                  segunda foto se queda con la suya, sin efecto.
                */
                <div class="group relative aspect-square w-full overflow-hidden rounded-[1rem]">
                  <Image
                    src={miembro.photo}
                    alt={miembro.name}
                    widths={[320, 480, 720]}
                    sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 45vw, 92vw"
                    class:list={[
                      'absolute inset-0 size-full object-cover transition-opacity duration-500',
                      miembro.photoHover && 'group-hover:opacity-0',
                    ]}
                    loading="lazy"
                  />

                  {miembro.photoHover && (
                    <Image
                      src={miembro.photoHover}
                      alt=""
                      widths={[320, 480, 720]}
                      sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 45vw, 92vw"
                      class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                      loading="lazy"
                    />
                  )}
                </div>
              ) : (
                <FotoPendiente label="Retrato · cuadrado 1:1" class="aspect-square w-full rounded-[1rem]" />
              )}

              <p class="mt-4 text-[0.9375rem] font-semibold text-ink">{miembro.name}</p>
              <p class="text-sm text-muted">{miembro.role}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Las mismas cifras de la home, para no repetir el dato en dos lugares */}
  <section class="pb-20 lg:pb-28" aria-label="La iglesia en cifras">
    <div class="container-page">
      <div class="grid gap-x-16 gap-y-12 border-t border-ink/15 pt-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          stats.map((stat) => (
            <div>
              <p class="eyebrow">{stat.caption}</p>
              <p class="mt-3 text-[2.5rem] leading-none font-normal tracking-[-0.04em] text-ink">
                {stat.value}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Cierre */}
  <section class="pb-20 lg:pb-32" aria-label="Visítanos">
    <div class="container-page">
      <div class="rounded-[2rem] bg-mist px-8 py-14 text-center lg:rounded-[2.75rem] lg:px-16 lg:py-20">
        <h2 class="heading-lg mx-auto max-w-2xl text-ink">Te esperamos en casa</h2>
        <p class="subtitle-lg mx-auto mt-4 max-w-md">
          Ven a conocernos un domingo o escríbenos si quieres saber más.
        </p>

        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <ArrowButton
            label="Contactar"
            href={contactHref}
            external={contactHref.startsWith('http')}
            variant="accent"
            size="md"
          />
          <ArrowButton label="Ver reuniones" href="/#reuniones" variant="light" size="md" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
