---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ArrowButton from '../components/ArrowButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FotoPendiente from '../components/FotoPendiente.astro';
import ProyectosCompasion from '../components/ProyectosCompasion.astro';
import SuenosTerreno from '../components/SuenosTerreno.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TarjetaEquipo from '../components/TarjetaEquipo.astro';
import { about, site, whatsappHref } from '../data/content';
import type { Encuadre, GrupoEquipo } from '../data/content';

const contactHref = whatsappHref('Hola, me gustaría saber más de la iglesia') || '/#contacto';

/*
  Los dos tramos del equipo —fundadores y asociados— con lo que necesita cada
  uno para pintarse: el tramo entero está en el marcado desde el principio
  —así lo lee el buscador y así funciona sin JavaScript—, pero los que pasan
  de `visibles` salen marcados para que el CSS los pliegue y el botón los
  despliegue. El id enlaza el botón con su lista: hay uno por tramo.
*/
/* El tipo declarado y no el que infiere el literal: dentro del literal, el
   miembro de los fundadores solo tiene los campos que trae escritos, y el
   marcado usa el resto (`encuadre`, `luz`) para todos por igual. */
const grupos = (about.equipo.grupos as GrupoEquipo[]).map((grupo, i) => ({
  ...grupo,
  id: `equipo-lista-${i}`,
  hayResto: grupo.visibles !== undefined && grupo.miembros.length > grupo.visibles,
}));

/* El tratamiento de las fotos —blanco y negro y encuadre— es el mismo en los
   dos formatos, así que las variables viajan igual (ver `Encuadre` en
   `content.ts`). */
const encuadrar = (e?: Encuadre, luz?: number) =>
  `--zoom:${e?.zoom ?? 1};--x:${e?.x ?? '50%'};--y:${e?.y ?? '50%'};--luz:${luz ?? 1}`;
---

{/*
  Sin `heroFoto`: la página abre sobre blanco, así que la barra de navegación
  tiene que ir en tinta y no en blanco.

  `voz-fina` envuelve la página entera: los titulares van en peso normal, que
  es la voz de las páginas de dentro. Va aquí y no clase por clase, para que
  no haya que acordarse en cada título nuevo.
*/}
<BaseLayout
  title={`Nosotros — ${site.name}`}
  description="La historia de Iglesia Viña Puerto Montt: cómo empezó, qué creemos y quiénes la pastorean."
>
  <div class="voz-fina">
  {/* Portada: solo tipografía, mucho aire y el titular en peso normal */}
  <section class="pt-36 pb-16 lg:pt-44 lg:pb-24" aria-labelledby="nosotros-titulo">
    <div class="container-page">
      <p class="eyebrow">{about.eyebrow}</p>
      <h1 id="nosotros-titulo" class="portada mt-6 max-w-5xl text-ink text-balance">
        {about.title}
      </h1>
    </div>
  </section>

  {/* Historia: la pila de fotos a un lado y el relato al otro */}
  <section id="historia" class="pb-28 lg:pb-48" aria-label="Nuestra historia">
    <div class="container-page">
      <div class="lg:grid lg:grid-cols-2 lg:items-start lg:gap-16">
        {/*
          La pila de fotos: crecen hacia abajo, cada una con su pie y con su
          propia proporción. El texto de al lado se queda quieto mientras
          pasan, como en la referencia.
        */}
        <div class="flex flex-col gap-12">
          {about.historia.fotos.map((foto, i) =>
            foto.image ? (
              <figure>
                <Image
                  src={foto.image}
                  alt={foto.caption}
                  widths={[480, 768, 1080]}
                  sizes="(min-width: 64rem) 40rem, 92vw"
                  class="h-auto w-full rounded-[1rem]"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />

                <figcaption class="nota mt-4 flex gap-3">
                  <span aria-hidden="true">—</span>
                  {foto.caption}
                </figcaption>
              </figure>
            ) : (
              <FotoPendiente label={foto.caption} class="aspect-[4/3] w-full rounded-[1rem]" />
            )
          )}
        </div>

        <div class="relato-historia mt-12 lg:mt-0">
          <h2 class="heading-lg text-ink">{about.historia.title}</h2>

          {/*
            El relato va en `subtitle`, no en `subtitle-lg`: son cinco párrafos
            de texto corrido, no la bajada de un título, y en cuerpo grande no
            cabía entero en una ventana de portátil.
          */}
          <div class="mt-5 flex flex-col gap-4">
            {about.historia.body.map((parrafo) => <p class="subtitle max-w-xl">{parrafo}</p>)}
          </div>
        </div>
      </div>

    </div>
  </section>

  <ProyectosCompasion />

  {/* Lo que viene: una sola foto quieta y los sueños subiendo por al lado */}
  <SuenosTerreno />

  {/*
    Nuestros valores: el encabezado se queda quieto a media pantalla y la lista
    pasa por al lado. Cada valor es una fila plegada —el nombre y un «+»— que
    se abre para leer el párrafo entero; así la sección se lee primero como
    índice, que es lo que se quiere de una lista de valores, y solo después se
    entra en el que interese.

    Los nombres van en gris y solo uno va en tinta: el que queda a la altura
    del encabezado. Se marca al desplazar la página, así que la lista se lee
    sola —el negro va bajando de valor en valor conforme se avanza— sin tener
    que abrir nada. Abrir uno lo marca a él mientras esté abierto.
  */}
  <section id="creemos" class="pb-28 lg:pb-48" aria-labelledby="valores-titulo">
    <div class="container-page">
      <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-16 xl:gap-24">
        {/*
          El encabezado se ancla al centro de la ventana, no arriba: es la
          línea contra la que se marca el valor de turno, y el script mide
          contra esa misma altura, así que lo que se ve en tinta es siempre lo
          que queda enfrente. El anclaje lo calcula el script y lo deja en
          `--anclaje`; el CSS de abajo lo usa.
        */}
        <div class="encabezado-valores">
          <SectionHeading
            id="valores-titulo"
            eyebrow={about.valores.eyebrow}
            title={about.valores.title}
            subtitle={about.valores.subtitle}
            estrecho
          />
          <p class="nota mt-5">{about.valores.cita}</p>
        </div>

        <ul class="lista-valores">
          {
            about.valores.items.map((valor, i) => (
              /*
                `data-activo` es el que va en tinta. Lo mueve el script con el
                desplazamiento; aquí sale puesto en el primero para que la
                lista no aparezca entera en gris —ni parpadee— mientras el
                script no ha corrido, y para que se vea marcada aunque no
                llegue a correr nunca.
              */
              <li class="valor border-t border-ink/15 last:border-b" data-activo={i === 0 ? '' : undefined}>
                {/*
                  El <h3> carga con el nivel del índice y el botón con el
                  mando. El párrafo está en el marcado desde el principio
                  —plegado por CSS, como el resto del equipo—, así que el
                  buscador lo lee aunque en pantalla empiece cerrado.
                */}
                <h3>
                  <button
                    type="button"
                    data-valor
                    aria-expanded="false"
                    aria-controls={`valor-${i}`}
                    class="group flex w-full items-start justify-between gap-6 py-9 text-left lg:py-12"
                  >
                    <span class="titulo-valor heading-md text-balance transition-colors duration-500 group-hover:text-ink">
                      {valor.title}
                    </span>
                    <span
                      class="mas-valor mt-1 grid size-6 shrink-0 place-items-center transition-[transform,color] duration-300 group-hover:text-ink group-aria-expanded:rotate-45"
                      aria-hidden="true"
                    >
                      <Icon name="lucide:plus" width={22} height={22} />
                    </span>
                  </button>
                </h3>

                {/*
                  El pliegue va con una rejilla de 0fr a 1fr: es la única forma
                  de animar hasta el alto que pida el texto sin escribir un
                  número que se queda corto en cuanto cambia el párrafo.
                */}
                <div id={`valor-${i}`} class="detalle-valor">
                  <div class="overflow-hidden">
                    <p class="subtitle max-w-2xl pb-10 text-pretty lg:pb-12">{valor.body}</p>
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* Equipo pastoral */}
  <section id="equipo" class="equipo-retratos pb-28 lg:pb-48" aria-labelledby="equipo-titulo">
    <div class="container-page">
      <h2 id="equipo-titulo" class="heading-lg text-ink">{about.equipo.title}</h2>

      {
        grupos.map((grupo) => (
          <div class="mt-14 lg:mt-20">
            {grupo.formato === 'retrato' ? (
              /*
                El tramo de una sola pareja: la foto grande a un lado y, al
                otro, el rótulo, el nombre en cuerpo de titular y su bajada.
                Aquí el rótulo va sin la línea fina —la lleva el tramo que
                abre una cuadrícula— porque lo que sigue no es una fila de
                tarjetas sino una sola foto.
              */
              grupo.miembros.map((miembro) => (
                <div class="grid gap-8 lg:grid-cols-[minmax(0,41.25rem)_minmax(0,1fr)] lg:items-center lg:gap-14">
                  {miembro.photo ? (
                    <div class="group relative aspect-[4/3] w-full overflow-hidden rounded-[1.5rem] sm:aspect-[3/2] lg:rounded-[1.75rem]">
                      <Image
                        src={miembro.photo}
                        alt={miembro.name}
                        widths={[480, 720, 900]}
                        sizes="(min-width: 64rem) 41.25rem, 92vw"
                        style={encuadrar(miembro.encuadre, miembro.luz)}
                        class:list={[
                          'retrato encuadrada absolute inset-0 size-full object-cover transition duration-500',
                          miembro.photoHover ? 'group-hover:opacity-0' : 'se-enciende',
                        ]}
                      />

                      {miembro.photoHover && (
                        <Image
                          src={miembro.photoHover}
                          alt=""
                          widths={[480, 720, 1200]}
                          sizes="(min-width: 64rem) 41.25rem, 92vw"
                          style={encuadrar(miembro.encuadreHover)}
                          class="encuadrada absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                        />
                      )}
                    </div>
                  ) : (
                    <FotoPendiente
                      label="Retrato · apaisado 3:2"
                      class="aspect-[4/3] w-full rounded-[1.5rem] sm:aspect-[3/2] lg:rounded-[1.75rem]"
                    />
                  )}

                  <div class="flex flex-col gap-4 lg:gap-5">
                    <p class="eyebrow">{grupo.rotulo}</p>
                    <h3 class="heading-lg text-ink text-balance">{miembro.name}</h3>
                    {miembro.bajada && (
                      <p class="subtitle-lg max-w-md text-pretty">{miembro.bajada}</p>
                    )}
                  </div>
                </div>
              ))
            ) : (
              <Fragment>
                {/* El rótulo del tramo: el título grande es el de la sección */}
                <SectionHeading eyebrow={grupo.rotulo} as="p" />

                <ul
                  id={grupo.id}
                  class="equipo-lista mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3"
                >
                  {grupo.miembros.map((miembro, i) => (
                    <li class:list={[grupo.visibles !== undefined && i >= grupo.visibles && 'miembro-plegado']}>
                      <TarjetaEquipo miembro={miembro} />
                    </li>
                  ))}
                </ul>

                {grupo.hayResto && (
                  <div class="equipo-mas mt-12 flex justify-center lg:mt-16">
                    <button
                      type="button"
                      data-equipo-mas
                      aria-expanded="false"
                      aria-controls={grupo.id}
                      class="group inline-flex shrink-0 items-center gap-3 rounded-full bg-mist py-2 pl-5 pr-2 text-[1rem] font-semibold text-carbon transition-colors hover:bg-ink/10"
                    >
                      <span class="whitespace-nowrap">Ver todo el equipo pastoral</span>
                      <span class="grid size-8 shrink-0 place-items-center rounded-full bg-accent text-white transition-transform duration-200 group-aria-expanded:rotate-180">
                        <Icon name="lucide:chevron-down" width={16} height={16} aria-hidden="true" />
                      </span>
                    </button>
                  </div>
                )}
              </Fragment>
            )}
          </div>
        ))
      }
    </div>
  </section>

  {/* Cierre */}
  <section class="pb-20 lg:pb-32" aria-label="Visítanos">
    <div class="container-page">
      <div class="rounded-[2rem] bg-mist px-8 py-14 text-center lg:rounded-[2.75rem] lg:px-16 lg:py-20">
        <h2 class="heading-lg mx-auto max-w-2xl text-ink">Te esperamos en casa</h2>
        <p class="subtitle-lg mx-auto mt-4 max-w-md">
          Visítanos o escríbenos para más información.
        </p>

        {/*
          Primero la página de quien viene por primera vez, que es a quien va
          dirigido el cierre; el contacto queda al lado, para quien prefiere
          preguntar antes de venir.
        */}
        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <ArrowButton label="Soy nuevo" href="/soy-nuevo" variant="accent" size="md" />
          <ArrowButton
            label="Contactar"
            href={contactHref}
            external={contactHref.startsWith('http')}
            variant="light"
            size="md"
          />
        </div>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>

{/*
  Los estilos con ámbito de Astro no alcanzan a `<Image>` —lo pinta el
  componente, no la plantilla—, así que el encuadre va en un bloque global
  acotado por la clase de la lista.
*/}
<style is:global>
  /*
    Acotado a la sección entera y no a la cuadrícula: el tramo de los
    fundadores va fuera de la lista y lleva el mismo tratamiento.
  */
  .equipo-retratos {
    /*
      El contraste es el mismo para todas: lo que cambia de una foto a otra es
      el brillo (`--luz`, en `content.ts`), porque cada una venía expuesta de
      su manera. Subirlo aquí sube el de la sección entera.
    */
    --contraste-retrato: 1.06;
  }

  /*
    El encuadre va aparte del tratamiento: las segundas fotos —las del hover—
    también se encuadran, pero salen a color y sin tocar.
  */
  .equipo-retratos .encuadrada {
    object-position: var(--x, 50%) var(--y, 50%);
    transform: scale(var(--zoom, 1));
    /*
      El origen del zoom es el mismo punto que elige `object-position`: así,
      acercarse no descoloca lo que ya estaba cuadrado y las dos variables se
      pueden tocar por separado.
    */
    transform-origin: var(--x, 50%) var(--y, 50%);
  }

  .equipo-retratos .retrato {
    /*
      El blanco y negro, el brillo y el contraste van en un solo `filter`
      —encadenar dos reglas de filtro no se suma, la última gana— y viven en
      CSS, no en el archivo: se puede quitar todo esto y las fotos vuelven a
      estar como salieron de la cámara.
    */
    filter: grayscale(1) brightness(var(--luz, 1)) contrast(var(--contraste-retrato));
  }

  /*
    Las tarjetas sin segunda foto se encienden a color al pasar el ratón, y de
    paso sueltan el ajuste de tono: lo que se ve es la foto tal cual, igual que
    las segundas fotos, que tampoco van tratadas.
  */
  .equipo-retratos .group:hover .retrato.se-enciende {
    filter: none;
  }
</style>

<style>
  /*
    El relato se queda quieto mientras la pila de fotos pasa por al lado.

    El anclaje no es un número fijo: lo calcula el script del final y lo deja en
    `--tope`. Un bloque pegajoso más alto que la ventana se ancla arriba y su
    final nunca llega a verse, así que en ventanas cortas el tope se vuelve
    negativo —el relato asoma por arriba— y lo que queda a la vista es el final
    del texto, que es lo que se estaba leyendo al llegar. Los 4rem del `fallback`
    son el caso holgado, y también lo que se ve si el script no llega a correr.
  */
  @media (min-width: 64rem) {
    .relato-historia {
      position: sticky;
      top: var(--tope, 4rem);
    }
  }
</style>

<style>
  /*
    El pliegue de un valor. La rejilla pasa de 0fr a 1fr: así el detalle se
    abre hasta el alto que pida su párrafo, sin un número escrito a mano que
    se quede corto en cuanto el texto cambie. El `overflow` lo pone el hijo,
    que es quien tiene que recortarse mientras la fila crece.

    Lo abre el atributo del botón, no una clase: el estado ya vive en
    `aria-expanded` —que es el que oyen los lectores de pantalla— y no hace
    falta guardarlo dos veces.
  */
  .detalle-valor {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.42s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .valor:has(> h3 > button[aria-expanded='true']) > .detalle-valor {
    grid-template-rows: 1fr;
  }

  /*
    El aire de arriba y de abajo de la lista. No es decoración: es lo que le
    da recorrido al encabezado anclado. Sin él la lista mide casi lo mismo que
    el encabezado, el anclaje dura dos dedos de desplazamiento y la marca se
    queda parada en el valor del medio —los dos suben a la vez— en vez de ir
    bajando de uno en uno.

    Lo calcula el script, porque depende del alto del encabezado y del de una
    fila, y los dos cambian con el texto y con el ancho de la ventana. En el
    teléfono no hay nada anclado y el aire sobra, así que solo se aplica de
    64rem para arriba.
  */
  @media (min-width: 64rem) {
    .lista-valores {
      padding-top: var(--respiro-arriba, 0);
      padding-bottom: var(--respiro-abajo, 0);
    }

    /*
      El anclaje es `50vh` menos medio encabezado, y no `50vh` con la mitad
      descontada por `transform`, porque el `transform` no cuenta para el
      pegajoso: el bloque seguiría reservando su alto desde la línea hacia
      abajo y se despegaría medio encabezado antes de tiempo, justo cuando le
      toca el último valor. Los 2rem del `fallback` son lo que se ve mientras
      el script no ha corrido.
    */
    .encabezado-valores {
      position: sticky;
      top: var(--anclaje, 2rem);
    }
  }

  /*
    El gris de los valores que no tocan. Es más claro que el `muted` del resto
    de la página —el contraste con la tinta es lo que hace el efecto— pero no
    tanto como en la referencia, donde el texto apagado no se lee: se queda en
    el gris más claro que sigue siendo legible por sí solo.
  */
  .titulo-valor,
  .mas-valor {
    color: color-mix(in srgb, var(--color-ink) 50%, white);
  }

  .valor[data-activo] :is(.titulo-valor, .mas-valor) {
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .detalle-valor {
      transition: none;
    }
  }
</style>

<style>
  /*
    El resto del equipo va en el marcado desde el principio —así lo lee el
    buscador— y se pliega con una clase. La pone el CSS de salida, no el
    script, para que no haya un parpadeo con las catorce tarjetas antes de
    plegarse.
  */
  .miembro-plegado {
    display: none;
  }

  .equipo-lista.esta-abierta .miembro-plegado {
    display: revert;
    animation: asomar 0.4s ease both;
  }

  @keyframes asomar {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .equipo-lista.esta-abierta .miembro-plegado {
      animation: none;
    }
  }
</style>

<script>
  /*
    El tope del relato pegajoso de «Nuestra historia»: lo más arriba que puede
    anclarse sin que su final se salga de la ventana. Se calcula en vez de
    escribirse porque el alto del relato depende del texto y del ancho de la
    columna, y un número a mano se queda mentiroso en cuanto cambia un párrafo.
  */
  const relato = document.querySelector<HTMLElement>('.relato-historia');

  if (relato) {
    const holgura = 16;
    const tope = 64;

    const ajustarTope = () => {
      relato.style.setProperty(
        '--tope',
        `${Math.min(tope, window.innerHeight - relato.offsetHeight - holgura)}px`
      );
    };

    ajustarTope();
    addEventListener('resize', ajustarTope);
    // El alto cambia cuando entra la tipografía de la página.
    document.fonts?.ready.then(ajustarTope);
  }

  /*
    Los valores. Dos cosas a la vez:

    - Solo uno va en tinta, el que queda a la altura del encabezado, que está
      anclado a media ventana. Se elige por la distancia de su centro a esa
      misma altura —no por un umbral ni por un observador con márgenes—, que
      es lo único que garantiza que se marque el que se tiene enfrente y no el
      de al lado.
    - Se abren de uno en uno con el «+». Mientras hay uno abierto es él el que
      va en tinta, pase lo que pase con el desplazamiento: es el que se está
      leyendo.
  */
  const lista = document.querySelector<HTMLElement>('.lista-valores');

  if (lista) {
    const filas = Array.from(lista.querySelectorAll<HTMLLIElement>('.valor'));
    const botones = filas.map((fila) => fila.querySelector<HTMLButtonElement>('[data-valor]'));

    /*
      La altura contra la que se mide es la del encabezado, no media ventana:
      mientras está anclado son la misma, pero al final de la sección el
      encabezado se despega y sigue subiendo, y así el valor en tinta sigue
      siendo el que se tiene enfrente en vez de quedarse desfasado. En el
      teléfono no hay encabezado anclado —va arriba del todo— y la referencia
      pasa a ser el medio de la ventana.
    */
    const anclado = matchMedia('(min-width: 64rem)');
    const encabezado = document.querySelector<HTMLElement>('.encabezado-valores');

    const linea = () => {
      if (!anclado.matches || !encabezado) return window.innerHeight / 2;

      const caja = encabezado.getBoundingClientRect();
      return caja.top + caja.height / 2;
    };

    const marcar = () => {
      const altura = linea();
      const abierta = filas.find(
        (_fila, i) => botones[i]?.getAttribute('aria-expanded') === 'true'
      );

      let activa = abierta;

      if (!activa) {
        let cerca = Infinity;

        for (const fila of filas) {
          const caja = fila.getBoundingClientRect();
          const distancia = Math.abs(caja.top + caja.height / 2 - altura);

          if (distancia < cerca) {
            cerca = distancia;
            activa = fila;
          }
        }
      }

      filas.forEach((fila) => fila.toggleAttribute('data-activo', fila === activa));
    };

    /*
      El aire de arriba y de abajo de la lista, que es lo que hace que el
      encabezado siga anclado mientras la marca recorre los cinco valores.

      Arriba: lo que hay que bajar la primera fila para que su centro caiga en
      la línea justo cuando el encabezado se ancla. Abajo: lo que necesita el
      encabezado por debajo de la línea para no despegarse cuando la última
      fila llega a ella. Las dos medidas son la misma cuenta —media diferencia
      entre el alto del encabezado y el de la fila— porque la línea pasa por
      el centro de los dos.
    */
    const respirar = () => {
      if (!anclado.matches || !encabezado) {
        lista.style.removeProperty('--respiro-arriba');
        lista.style.removeProperty('--respiro-abajo');
        encabezado?.style.removeProperty('--anclaje');
        return;
      }

      const mitad = encabezado.offsetHeight / 2;

      encabezado.style.setProperty('--anclaje', `calc(50vh - ${Math.round(mitad)}px)`);

      const aire = (fila?: HTMLLIElement) =>
        `${Math.max(0, Math.round(mitad - (fila?.offsetHeight ?? 0) / 2))}px`;

      lista.style.setProperty('--respiro-arriba', aire(filas[0]));
      lista.style.setProperty('--respiro-abajo', aire(filas[filas.length - 1]));
    };

    /*
      Una sola pasada por cuadro: el desplazamiento dispara mucho más a menudo
      de lo que se pinta, y medir cinco cajas en cada evento es leer el diseño
      cinco veces por nada.
    */
    let pedido = 0;

    const pedirMarca = () => {
      if (pedido) return;
      pedido = requestAnimationFrame(() => {
        pedido = 0;
        marcar();
      });
    };

    botones.forEach((boton, i) => {
      boton?.addEventListener('click', () => {
        const abierto = boton.getAttribute('aria-expanded') === 'true';

        botones.forEach((otro) => otro?.setAttribute('aria-expanded', 'false'));
        boton.setAttribute('aria-expanded', String(!abierto));
        marcar();

        /*
          Al cerrar, la fila se encoge y lo que queda enfrente ya es otro: hay
          que volver a mirar cuando el pliegue termine, no mientras se mueve.
        */
        filas[i]
          ?.querySelector('.detalle-valor')
          ?.addEventListener('transitionend', marcar, { once: true });
      });
    });

    const medir = () => {
      respirar();
      marcar();
    };

    medir();
    addEventListener('scroll', pedirMarca, { passive: true });
    addEventListener('resize', medir);
    anclado.addEventListener('change', medir);
    // El alto del encabezado y el de las filas cambian al entrar la tipografía.
    document.fonts?.ready.then(medir);
  }

  /*
    El botón de «Ver todo el equipo pastoral». Hay uno por tramo que se pliegue
    —hoy solo el de los asociados— y cada uno dice en `aria-controls` cuál es
    su lista, así que no hace falta que el script sepa cuántos tramos hay.
  */
  const seccion = document.getElementById('equipo');

  seccion?.querySelectorAll<HTMLButtonElement>('[data-equipo-mas]').forEach((boton) => {
    const lista = document.getElementById(boton.getAttribute('aria-controls') ?? '');
    const etiqueta = boton.querySelector('span');

    if (!lista || !etiqueta) return;

    boton.addEventListener('click', () => {
      const abierta = lista.classList.toggle('esta-abierta');

      boton.setAttribute('aria-expanded', String(abierta));
      etiqueta.textContent = abierta ? 'Ver menos' : 'Ver todo el equipo pastoral';

      /*
        Al plegar, el tramo se acorta de golpe y el botón se va hacia arriba:
        si ya quedó por encima de la ventana, se vuelve al rótulo del tramo.
      */
      if (!abierta && boton.getBoundingClientRect().top < 0) {
        (lista.parentElement ?? lista).scrollIntoView({ block: 'start', behavior: 'smooth' });
      }
    });
  });
</script>
