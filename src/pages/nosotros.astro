---
import { Image } from 'astro:assets';
import ArrowButton from '../components/ArrowButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { compassionFeature, site, stats, whatsappHref } from '../data/content';

const contactHref = whatsappHref('Hola, me gustaría saber más de la iglesia') || '/#contacto';

/**
 * Primera versión de la página. El relato está en bloques sueltos para poder
 * ir sumando o reordenando secciones sin rehacer la maqueta.
 * TODO: texto definitivo de la historia, fotos propias y equipo pastoral.
 */
const historia = [
  {
    eyebrow: 'Cómo empezó',
    title: 'Todo comenzó en el living de una casa',
    body: 'Un grupo pequeño reuniéndose a orar fue el principio de lo que hoy es una familia de cientos de personas en Puerto Montt.',
  },
  {
    eyebrow: 'Qué creemos',
    title: 'Una familia compasiva imitando a Jesús',
    body: 'La compasión no es un programa: es la forma en que entendemos la fe. Por eso la iglesia se extiende en salud, educación y ayuda social.',
  },
  {
    eyebrow: 'Hacia dónde vamos',
    title: 'Iglesia en movimiento',
    body: 'Seguimos creciendo como comunidad y sirviendo a la ciudad, con la convicción de que la palabra declarada trae transformación.',
  },
];
---

<BaseLayout
  title={`Nosotros — ${site.name}`}
  description="La historia de Iglesia Viña Puerto Montt: cómo empezó, qué creemos y hacia dónde vamos."
  heroFoto
>
  {/* Portada: la misma foto de la tarjeta "Nosotros" de la home */}
  <section class="relative isolate flex min-h-[70svh] flex-col justify-end overflow-clip">
    <Image
      src={compassionFeature.image}
      alt={compassionFeature.alt}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      class="absolute inset-0 -z-10 size-full object-cover brightness-[0.6] saturate-[0.8]"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 -z-10 bg-black/35" aria-hidden="true"></div>

    <div class="container-page pb-14 lg:pb-20">
      <p class="eyebrow !text-white/70">Iglesia Viña Puerto Montt</p>
      <h1
        class="mt-4 leading-[0.9] font-semibold tracking-[-0.045em] text-white"
        style="font-size: clamp(2.75rem, 1rem + 6.2vw, 6.25rem)"
      >
        Nosotros
      </h1>
      <p class="subtitle-lg mt-5 max-w-xl !text-white/85">{compassionFeature.description}</p>
    </div>
  </section>

  {/* Relato en bloques */}
  <section class="py-16 lg:py-24" aria-label="Nuestra historia">
    <div class="container-page">
      <div class="flex flex-col gap-14 lg:gap-20">
        {
          historia.map((bloque) => (
            <article class="border-t border-ink/15 pt-8 lg:grid lg:grid-cols-[minmax(0,16rem)_1fr] lg:gap-16">
              <p class="eyebrow">{bloque.eyebrow}</p>

              <div class="mt-4 lg:mt-0">
                <h2 class="heading-lg max-w-3xl text-ink">{bloque.title}</h2>
                <p class="subtitle-lg mt-4 max-w-2xl">{bloque.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Las mismas cifras de la home, para no repetir el dato en dos lugares */}
  <section class="pb-16 lg:pb-24" aria-label="La iglesia en cifras">
    <div class="container-page">
      <div class="grid gap-x-16 gap-y-12 border-t border-ink/15 pt-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          stats.map((stat) => (
            <div>
              <p class="eyebrow">{stat.caption}</p>
              <p class="mt-3 text-[2.5rem] leading-none font-semibold tracking-[-0.04em] text-ink">
                {stat.value}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Cierre */}
  <section class="pb-20 lg:pb-32" aria-label="Visítanos">
    <div class="container-page">
      <div class="rounded-[2rem] bg-mist px-8 py-14 text-center lg:rounded-[2.75rem] lg:px-16 lg:py-20">
        <h2 class="heading-lg mx-auto max-w-2xl text-ink">Te esperamos en casa</h2>
        <p class="subtitle-lg mx-auto mt-4 max-w-md">
          Ven a conocernos un domingo o escríbenos si quieres saber más.
        </p>

        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <ArrowButton
            label="Contactar"
            href={contactHref}
            external={contactHref.startsWith('http')}
            variant="accent"
            size="md"
          />
          <ArrowButton label="Ver reuniones" href="/#reuniones" variant="light" size="md" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
